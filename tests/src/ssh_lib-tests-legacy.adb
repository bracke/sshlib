      Pack_Verified_Count : Natural := 0;
      Pack_Resolved_Count : Natural := 0;
      Pack_Object_Counts : SSH_Lib.Git.Pack_Object_Counts;
      Ref_Kind       : SSH_Lib.Git.Ref_Name_Kind := SSH_Lib.Git.Ref_Other;
      Side_Kind      : SSH_Lib.Git.Side_Band_Kind :=
