            and then Resolved_Path_Tree_Last =
              Resolved_Path_Tree_Data'First + Tree_Data'Length - 1
            and then Bytes_Equal
              (Resolved_Path_Tree_Data
                 (Resolved_Path_Tree_Data'First
                  .. Resolved_Path_Tree_Last),
               Tree_Data),
