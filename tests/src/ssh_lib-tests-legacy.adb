        SSH_Lib.Protocol.Buffers.Append (Work_Item, Empty_String_Field);
      Check_Status
        (Status_Value, CryptoLib.Errors.Ok, "build open failure description");
      Status_Value :=
        SSH_Lib.Protocol.Buffers.Append (Work_Item, Empty_String_Field);
      Check_Status
        (Status_Value, CryptoLib.Errors.Ok, "build open failure language");
      return SSH_Lib.Protocol.Buffers.To_Array (Work_Item);
