      Negotiation_Summary : SSH_Lib.Git.Upload_Pack_Negotiation_Summary;
      Receive_Summary : SSH_Lib.Git.Receive_Pack_Request_Summary;
      Upload_Response_Summary : SSH_Lib.Git.Upload_Pack_Response_Summary;
      ACK_Stream_Summary : SSH_Lib.Git.Upload_Pack_ACK_Stream_Summary;
      Receive_Report_Summary : SSH_Lib.Git.Receive_Pack_Report_Summary;
      Protocol_V2_Summary : SSH_Lib.Git.Protocol_V2_Request_Summary;
      Protocol_V2_Capability_Summary :
        SSH_Lib.Git.Protocol_V2_Capability_Summary;
      Protocol_V2_Response_Summary : SSH_Lib.Git.Protocol_V2_Response_Summary;
      Ref_Advertisement_Summary : SSH_Lib.Git.Ref_Advertisement_Summary;
      Ref_Buffer     : Ada.Streams.Stream_Element_Array (1 .. 32);
      Ref_Last       : Ada.Streams.Stream_Element_Offset;
      Object_Buffer  : Ada.Streams.Stream_Element_Array (1 .. 40);
      Object_Last    : Ada.Streams.Stream_Element_Offset;
      Message_Buffer : Ada.Streams.Stream_Element_Array (1 .. 32);
      Message_Last   : Ada.Streams.Stream_Element_Offset;
      Cap_Name       : Ada.Streams.Stream_Element_Array (1 .. 32);
      Cap_Name_Last  : Ada.Streams.Stream_Element_Offset;
      Cap_Value      : Ada.Streams.Stream_Element_Array (1 .. 32);
      Cap_Value_Last : Ada.Streams.Stream_Element_Offset;
      Cap_Has_Value  : Boolean := False;
      Cap_Cursor     : Ada.Streams.Stream_Element_Offset := 0;
      Cap_Token      : Ada.Streams.Stream_Element_Array (1 .. 96);
      Cap_Token_Last : Ada.Streams.Stream_Element_Offset;
      Cap_List_Has_Token : Boolean := False;
      Ref_Has_Caps   : Boolean := False;
      Ref_Is_Peeled  : Boolean := False;
      Ref_Is_Symref  : Boolean := False;
      Capability_List : constant Ada.Streams.Stream_Element_Array :=
        [Character'Pos ('m'), Character'Pos ('u'),
         Character'Pos ('l'), Character'Pos ('t'),
         Character'Pos ('i'), Character'Pos ('_'),
         Character'Pos ('a'), Character'Pos ('c'),
         Character'Pos ('k'), Character'Pos (' '),
         Character'Pos ('a'), Character'Pos ('g'),
         Character'Pos ('e'), Character'Pos ('n'),
         Character'Pos ('t'), Character'Pos ('='),
         Character'Pos ('s'), Character'Pos ('s'),
         Character'Pos ('h'), Character'Pos ('l'),
         Character'Pos ('i'), Character'Pos ('b')];
      Bad_Capability_List : constant Ada.Streams.Stream_Element_Array :=
        [Character'Pos ('a'), Character'Pos (' '),
         Character'Pos (' '), Character'Pos ('b')];

      function Bytes_Equal
        (Left  : Ada.Streams.Stream_Element_Array;
         Right : Ada.Streams.Stream_Element_Array)
         return Boolean
      is
      begin
         if Left'Length /= Right'Length then
            return False;
         end if;

         for Offset in 0 .. Left'Length - 1 loop
            if Left (Left'First + Ada.Streams.Stream_Element_Offset (Offset))
              /= Right (Right'First + Ada.Streams.Stream_Element_Offset (Offset))
            then
               return False;
            end if;
         end loop;
         return True;
      end Bytes_Equal;

      function Bytes_From_String
        (Value : String) return Ada.Streams.Stream_Element_Array
      is
         Result : Ada.Streams.Stream_Element_Array
           (1 .. Ada.Streams.Stream_Element_Offset (Value'Length));
         Cursor : Ada.Streams.Stream_Element_Offset := Result'First;
      begin
         for Item of Value loop
            Result (Cursor) := Character'Pos (Item);
            Cursor := Cursor + 1;
         end loop;
         return Result;
      end Bytes_From_String;

      function Object_ID_From_String
        (Value : String) return SSH_Lib.Git.Object_ID_Hex_Text
      is
         Result : SSH_Lib.Git.Object_ID_Hex_Text := [others => 0];
      begin
         for Index in Result'Range loop
            Result (Index) := Character'Pos (Value (Value'First + Index - 1));
         end loop;
         return Result;
      end Object_ID_From_String;
   begin
      Status_Value :=
        SSH_Lib.Git.Build_Upload_Pack_Command ("repo.git", Command_Text);
      Check_Status
        (Status_Value, CryptoLib.Errors.Ok, "build upload command status");
      Check
        (To_String (Command_Text) = "git-upload-pack 'repo.git'",
         "build upload command text");

      Status_Value :=
        SSH_Lib.Git.Build_Receive_Pack_Command ("repo.git", Command_Text);
      Check_Status
        (Status_Value, CryptoLib.Errors.Ok, "build receive command status");
      Check
        (To_String (Command_Text) = "git-receive-pack 'repo.git'",
         "build receive command text");

      Check
        (SSH_Lib.Git.Upload_Pack_Command ("repo.git")
         = "git-upload-pack 'repo.git'",
         "upload command quoting");
      Check
        (SSH_Lib.Git.Receive_Pack_Command ("repo.git")
         = "git-receive-pack 'repo.git'",
         "receive command quoting");
      Check
        (SSH_Lib.Git.Upload_Pack_Command ("group/repo.git")
         = "git-upload-pack 'group/repo.git'",
         "slash command quoting");
      Check
        (SSH_Lib.Git.Upload_Pack_Command ("repo with space.git")
         = "git-upload-pack 'repo with space.git'",
         "space command quoting");
      Check
        (SSH_Lib.Git.Upload_Pack_Command ("a'b.git")
         = "git-upload-pack 'a'\''b.git'",
         "single quote escaping");
      Check
        (SSH_Lib.Git.Receive_Pack_Command ("a'b.git")
         = "git-receive-pack 'a'\''b.git'",
         "receive single quote escaping");
      Check
        (SSH_Lib.Git.Upload_Pack_Command ("semi;colon.git")
         = "git-upload-pack 'semi;colon.git'",
         "semicolon kept inside quotes");
      Check
        (SSH_Lib.Git.Upload_Pack_Command ("$(touch bad).git")
         = "git-upload-pack '$(touch bad).git'",
         "dollar expression kept inside quotes");
      Check
        (SSH_Lib.Git.Upload_Pack_Command ("`touch bad`.git")
         = "git-upload-pack '`touch bad`.git'",
         "backtick expression kept inside quotes");
      Check
        (SSH_Lib.Git.Upload_Pack_Command ("back\\slash.git")
         = "git-upload-pack 'back\\slash.git'",
         "backslash kept inside quotes");
      Check
        (SSH_Lib.Git.Upload_Pack_Command ("double""quote.git")
         = "git-upload-pack 'double""quote.git'",
         "double quote kept inside quotes");
      Check
        (SSH_Lib.Git.Upload_Pack_Command ("paren&(repo).git")
         = "git-upload-pack 'paren&(repo).git'",
         "parentheses and ampersand kept inside quotes");

      Status_Value := SSH_Lib.Git.Build_Upload_Pack_Command ("", Command_Text);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Invalid_Command,
         "empty repository path status rejected");
      Check
        (Length (Command_Text) = 0,
         "invalid repository path clears generated command");
      Status_Value :=
        SSH_Lib.Git.Build_Upload_Pack_Command
          ("bad" & Character'Val (0), Command_Text);
      Touch (Command_Text);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Invalid_Command,
         "nul repository path status rejected");
      Status_Value :=
        SSH_Lib.Git.Build_Upload_Pack_Command
          ("bad" & Character'Val (10), Command_Text);
      Touch (Command_Text);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Invalid_Command,
         "lf repository path status rejected");
      Status_Value :=
        SSH_Lib.Git.Build_Upload_Pack_Command
          ("bad" & Character'Val (13), Command_Text);
      Touch (Command_Text);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Invalid_Command,
         "cr repository path status rejected");
      Status_Value :=
        SSH_Lib.Git.Build_Upload_Pack_Command (Oversized_Path, Command_Text);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Invalid_Command,
         "oversized repository path status rejected");
      Check
        (Length (Command_Text) = 0,
         "oversized repository path clears generated command");

      declare
         Encoded : constant Ada.Streams.Stream_Element_Array :=
           SSH_Lib.Protocol.Buffers.To_Array
             (SSH_Lib.Git.Encode_Pkt_Line
                ([Character'Pos ('a'), Character'Pos ('b'),
                  Character'Pos ('c'), Ada.Streams.Stream_Element (10)]));
      begin
         Check
           (Bytes_Equal
              (Encoded,
               [Character'Pos ('0'), Character'Pos ('0'),
                Character'Pos ('0'), Character'Pos ('8'),
                Character'Pos ('a'), Character'Pos ('b'),
                Character'Pos ('c'), Ada.Streams.Stream_Element (10)]),
            "git pkt-line data frame encoded");
         Status_Value :=
           SSH_Lib.Git.Parse_Pkt_Line_Header
             (Encoded, Pkt_Kind, Pkt_Length);
         Check_Status
           (Status_Value, CryptoLib.Errors.Ok,
            "git pkt-line data header parsed");
         Check
           (Pkt_Kind = SSH_Lib.Git.Pkt_Data and then Pkt_Length = 8,
            "git pkt-line data header values");
         Status_Value :=
           SSH_Lib.Git.Copy_Pkt_Line_Payload
             (Encoded, Pkt_Payload, Pkt_Last);
         Check_Status
           (Status_Value, CryptoLib.Errors.Ok,
            "git pkt-line payload copied");
         Check
           (Bytes_Equal
              (Pkt_Payload (Pkt_Payload'First .. Pkt_Last),
               [Character'Pos ('a'), Character'Pos ('b'),
                Character'Pos ('c'), Ada.Streams.Stream_Element (10)]),
            "git pkt-line payload bytes preserved");
      end;

      Check
        (Bytes_Equal
           (SSH_Lib.Protocol.Buffers.To_Array
              (SSH_Lib.Git.Encode_Pkt_Flush),
            [Character'Pos ('0'), Character'Pos ('0'),
             Character'Pos ('0'), Character'Pos ('0')]),
         "git pkt-line flush encoded");
      Status_Value :=
        SSH_Lib.Git.Parse_Pkt_Line_Header
          ([Character'Pos ('0'), Character'Pos ('0'),
            Character'Pos ('0'), Character'Pos ('1')],
           Pkt_Kind,
           Pkt_Length);
      Check_Status
        (Status_Value, CryptoLib.Errors.Ok,
         "git pkt-line delimiter parsed");
      Check
        (Pkt_Kind = SSH_Lib.Git.Pkt_Delimiter and then Pkt_Length = 1,
         "git pkt-line delimiter values");
      Status_Value :=
        SSH_Lib.Git.Parse_Pkt_Line_Header
          ([Character'Pos ('0'), Character'Pos ('0'),
            Character'Pos ('0'), Character'Pos ('2')],
           Pkt_Kind,
           Pkt_Length);
      Check_Status
        (Status_Value, CryptoLib.Errors.Ok,
         "git pkt-line response-end parsed");
      Check
        (Pkt_Kind = SSH_Lib.Git.Pkt_Response_End and then Pkt_Length = 2,
         "git pkt-line response-end values");
      Status_Value :=
        SSH_Lib.Git.Parse_Pkt_Line_Header
          ([Character'Pos ('0'), Character'Pos ('0'),
            Character'Pos ('0'), Character'Pos ('3')],
           Pkt_Kind,
           Pkt_Length);
      Check_Status
        (Status_Value, CryptoLib.Errors.Invalid_Command,
         "git pkt-line length 3 rejected");
      Status_Value :=
        SSH_Lib.Git.Parse_Pkt_Line_Header
          ([Character'Pos ('0'), Character'Pos ('0'),
            Character'Pos ('0'), Character'Pos ('8'),
            Character'Pos ('a')],
           Pkt_Kind,
           Pkt_Length);
      Check_Status
        (Status_Value, CryptoLib.Errors.Read_Failed,
         "git pkt-line truncated frame rejected");
      Status_Value :=
        SSH_Lib.Git.Parse_Pkt_Line_Header
          ([Character'Pos ('0'), Character'Pos ('0'),
            Character'Pos ('0'), Character'Pos ('x')],
           Pkt_Kind,
           Pkt_Length);
      Check_Status
        (Status_Value, CryptoLib.Errors.Invalid_Command,
         "git pkt-line bad hex rejected");
      declare
         Small_Payload : Ada.Streams.Stream_Element_Array (1 .. 2);
      begin
         Status_Value :=
           SSH_Lib.Git.Copy_Pkt_Line_Payload
             ([Character'Pos ('0'), Character'Pos ('0'),
               Character'Pos ('0'), Character'Pos ('8'),
               Character'Pos ('a'), Character'Pos ('b'),
               Character'Pos ('c'), Character'Pos ('d')],
              Small_Payload,
              Pkt_Last);
         Check_Status
           (Status_Value, CryptoLib.Errors.Read_Failed,
            "git pkt-line small payload buffer rejected");
      end;

      declare
         Cursor_Stream : constant Ada.Streams.Stream_Element_Array :=
           SSH_Lib.Protocol.Buffers.To_Array
             (SSH_Lib.Git.Encode_Pkt_Line
                ([Character'Pos ('a'), Character'Pos ('b'),
                  Character'Pos ('c')]))
           & SSH_Lib.Protocol.Buffers.To_Array
               (SSH_Lib.Git.Encode_Pkt_Delimiter)
           & SSH_Lib.Protocol.Buffers.To_Array
               (SSH_Lib.Git.Encode_Pkt_Line ([1 => Character'Pos ('d')]))
           & SSH_Lib.Protocol.Buffers.To_Array
               (SSH_Lib.Git.Encode_Pkt_Response_End);
         Truncated_Stream : constant Ada.Streams.Stream_Element_Array :=
           [Character'Pos ('0'), Character'Pos ('0'),
            Character'Pos ('0'), Character'Pos ('8'),
            Character'Pos ('a')];
      begin
         SSH_Lib.Git.Reset_Pkt_Line_Cursor (Cursor_Stream, Pkt_Cursor);
         Check
           (not SSH_Lib.Git.Pkt_Line_Cursor_Done (Pkt_Cursor)
            and then Pkt_Cursor.Position = Cursor_Stream'First,
            "git pkt-line cursor reset to first packet");

         Status_Value :=
           SSH_Lib.Git.Next_Pkt_Line
             (Cursor_Stream,
              Pkt_Cursor,
              Pkt_Kind,
              Packet_First,
              Packet_Last,
              Payload_First,
              Payload_Last);
         Check_Status
           (Status_Value, CryptoLib.Errors.Ok,
            "git pkt-line cursor reads first data packet");
         Check
           (Pkt_Kind = SSH_Lib.Git.Pkt_Data
            and then Packet_First = Cursor_Stream'First
            and then Packet_Last = Cursor_Stream'First + 6
            and then Bytes_Equal
              (Cursor_Stream (Payload_First .. Payload_Last),
               [Character'Pos ('a'), Character'Pos ('b'),
                Character'Pos ('c')])
            and then Pkt_Cursor.Packet_Count = 1
            and then Pkt_Cursor.Data_Count = 1,
            "git pkt-line cursor first data values");

         Status_Value :=
           SSH_Lib.Git.Next_Pkt_Line
             (Cursor_Stream,
              Pkt_Cursor,
              Pkt_Kind,
              Packet_First,
              Packet_Last,
              Payload_First,
              Payload_Last);
         Check_Status
           (Status_Value, CryptoLib.Errors.Ok,
            "git pkt-line cursor reads delimiter");
         Check
           (Pkt_Kind = SSH_Lib.Git.Pkt_Delimiter
            and then Packet_Last = Packet_First + 3
            and then Payload_Last < Payload_First
            and then Pkt_Cursor.Delimiter_Count = 1,
            "git pkt-line cursor delimiter values");

         Status_Value :=
           SSH_Lib.Git.Next_Pkt_Line
             (Cursor_Stream,
              Pkt_Cursor,
              Pkt_Kind,
              Packet_First,
              Packet_Last,
              Payload_First,
              Payload_Last);
         Check_Status
           (Status_Value, CryptoLib.Errors.Ok,
            "git pkt-line cursor reads second data packet");
         Check
           (Pkt_Kind = SSH_Lib.Git.Pkt_Data
            and then Bytes_Equal
              (Cursor_Stream (Payload_First .. Payload_Last),
               [1 => Character'Pos ('d')])
            and then Pkt_Cursor.Data_Count = 2,
            "git pkt-line cursor second data values");

         Status_Value :=
           SSH_Lib.Git.Next_Pkt_Line
             (Cursor_Stream,
              Pkt_Cursor,
              Pkt_Kind,
              Packet_First,
              Packet_Last,
              Payload_First,
              Payload_Last);
         Check_Status
           (Status_Value, CryptoLib.Errors.Ok,
            "git pkt-line cursor reads response-end");
         Check
           (Pkt_Kind = SSH_Lib.Git.Pkt_Response_End
            and then Pkt_Cursor.Response_End_Count = 1
            and then Pkt_Cursor.Packet_Count = 4
            and then SSH_Lib.Git.Pkt_Line_Cursor_Done (Pkt_Cursor),
            "git pkt-line cursor response-end values");

         Status_Value :=
           SSH_Lib.Git.Next_Pkt_Line
             (Cursor_Stream,
              Pkt_Cursor,
              Pkt_Kind,
              Packet_First,
              Packet_Last,
              Payload_First,
              Payload_Last);
         Check_Status
           (Status_Value, CryptoLib.Errors.End_Of_Stream,
            "git pkt-line cursor reports end of stream");

         SSH_Lib.Git.Reset_Pkt_Line_Cursor (Truncated_Stream, Pkt_Cursor);
         Status_Value :=
           SSH_Lib.Git.Next_Pkt_Line
             (Truncated_Stream,
              Pkt_Cursor,
              Pkt_Kind,
              Packet_First,
              Packet_Last,
              Payload_First,
              Payload_Last);
         Check_Status
           (Status_Value, CryptoLib.Errors.Read_Failed,
            "git pkt-line cursor rejects truncated packet");
         Check
           (Pkt_Cursor.Packet_Count = 0
            and then not SSH_Lib.Git.Pkt_Line_Cursor_Done (Pkt_Cursor),
            "git pkt-line cursor does not advance on parse failure");
      end;

      declare
         Object_Hex : constant Ada.Streams.Stream_Element_Array :=
           Bytes_From_String
             ("3b18e512dba79e4c8300dd08aeb37f8e728b8dad");
         Capabilities : constant Ada.Streams.Stream_Element_Array :=
           Bytes_From_String
             ("multi_ack_detailed side-band-64k no-done filter");
         Want_Line : constant Ada.Streams.Stream_Element_Array :=
           SSH_Lib.Protocol.Buffers.To_Array
             (SSH_Lib.Git.Encode_Upload_Pack_Want_Line
                (Object_Hex, Capabilities));
         Have_Line : constant Ada.Streams.Stream_Element_Array :=
           SSH_Lib.Protocol.Buffers.To_Array
             (SSH_Lib.Git.Encode_Upload_Pack_Have_Line (Object_Hex));
         Shallow_Line : constant Ada.Streams.Stream_Element_Array :=
           SSH_Lib.Protocol.Buffers.To_Array
             (SSH_Lib.Git.Encode_Upload_Pack_Shallow_Line (Object_Hex));
         Deepen_Line : constant Ada.Streams.Stream_Element_Array :=
           SSH_Lib.Protocol.Buffers.To_Array
             (SSH_Lib.Git.Encode_Upload_Pack_Deepen_Line (5));
         Filter_Line : constant Ada.Streams.Stream_Element_Array :=
           SSH_Lib.Protocol.Buffers.To_Array
             (SSH_Lib.Git.Encode_Upload_Pack_Filter_Line
                (Bytes_From_String ("blob:none")));
         Done_Line : constant Ada.Streams.Stream_Element_Array :=
           SSH_Lib.Protocol.Buffers.To_Array
             (SSH_Lib.Git.Encode_Upload_Pack_Done_Line);
         Request_Stream : constant Ada.Streams.Stream_Element_Array :=
           Want_Line & Shallow_Line & Deepen_Line & Filter_Line
           & Have_Line & Done_Line;
      begin
         Check
           (Bytes_Equal
              (Want_Line,
               Bytes_From_String
                 ("0062want 3b18e512dba79e4c8300dd08aeb37f8e728b8dad"
                  & " multi_ack_detailed side-band-64k no-done filter"
                  & Character'Val (10))),
            "git upload-pack want negotiation line encoded");
         Check
           (Bytes_Equal
              (Have_Line,
               Bytes_From_String
                 ("0032have 3b18e512dba79e4c8300dd08aeb37f8e728b8dad"
                  & Character'Val (10))),
            "git upload-pack have negotiation line encoded");
         Check
           (Bytes_Equal (Done_Line, Bytes_From_String ("0009done" & Character'Val (10))),
            "git upload-pack done negotiation line encoded");
         Check
           (Bytes_Equal (Deepen_Line, Bytes_From_String ("000ddeepen 5" & Character'Val (10))),
            "git upload-pack deepen negotiation line encoded");
         Check
           (Bytes_Equal
              (Shallow_Line,
               Bytes_From_String
                 ("0035shallow 3b18e512dba79e4c8300dd08aeb37f8e728b8dad"
                  & Character'Val (10))),
            "git upload-pack shallow negotiation line encoded");
         Check
           (Bytes_Equal
              (Filter_Line,
               Bytes_From_String ("0015filter blob:none" & Character'Val (10))),
            "git upload-pack filter negotiation line encoded");

         Status_Value :=
           SSH_Lib.Git.Validate_Upload_Pack_Negotiation_Request
             (Request_Stream, Negotiation_Summary);
         Check_Status
           (Status_Value, CryptoLib.Errors.Ok,
            "git upload-pack negotiation request validated");
         Check
           (Negotiation_Summary.Want_Count = 1
            and then Negotiation_Summary.Have_Count = 1
            and then Negotiation_Summary.Shallow_Count = 1
            and then Negotiation_Summary.Deepen_Count = 1
            and then Negotiation_Summary.Filter_Count = 1
            and then Negotiation_Summary.Has_Done
            and then not Negotiation_Summary.Has_Flush
            and then Negotiation_Summary.Uses_Capabilities
            and then Negotiation_Summary.Uses_Multi_ACK_Detailed
            and then Negotiation_Summary.Uses_Side_Band_64K
            and then Negotiation_Summary.Uses_No_Done,
            "git upload-pack negotiation summary values");

         Status_Value :=
           SSH_Lib.Git.Validate_Upload_Pack_Negotiation_Request
             (SSH_Lib.Protocol.Buffers.To_Array
                (SSH_Lib.Git.Encode_Upload_Pack_Want_Line
                   (Object_Hex, [1 .. 0 => 0]))
              & SSH_Lib.Protocol.Buffers.To_Array
                  (SSH_Lib.Git.Encode_Pkt_Flush),
              Negotiation_Summary);
         Check_Status
           (Status_Value, CryptoLib.Errors.Ok,
            "git upload-pack flush-ended negotiation request validated");
         Check
           (Negotiation_Summary.Want_Count = 1
            and then Negotiation_Summary.Has_Flush
            and then not Negotiation_Summary.Has_Done,
            "git upload-pack flush-ended summary values");

         Status_Value :=
           SSH_Lib.Git.Validate_Upload_Pack_Negotiation_Request
             (Have_Line & Done_Line, Negotiation_Summary);
         Check_Status
           (Status_Value, CryptoLib.Errors.Invalid_Command,
            "git upload-pack rejects have before want");

         Status_Value :=
           SSH_Lib.Git.Validate_Upload_Pack_Negotiation_Request
             (Want_Line & Done_Line & Have_Line, Negotiation_Summary);
         Check_Status
           (Status_Value, CryptoLib.Errors.Invalid_Command,
            "git upload-pack rejects commands after done");

         Check
           (SSH_Lib.Protocol.Buffers.To_Array
              (SSH_Lib.Git.Encode_Upload_Pack_Want_Line
                 (Object_Hex, Bytes_From_String ("multi_ack  side-band")))'Length
            = 0,
            "git upload-pack want rejects malformed capability list");
         Check
           (SSH_Lib.Protocol.Buffers.To_Array
              (SSH_Lib.Git.Encode_Upload_Pack_Filter_Line
                 (Bytes_From_String ("blob none")))'Length = 0,
            "git upload-pack filter rejects unsafe spec");
      end;

      declare
         Ack_Buffer : Ada.Streams.Stream_Element_Array (1 .. 40);
         Ack_Last   : Ada.Streams.Stream_Element_Offset;
      begin
         Status_Value :=
           SSH_Lib.Git.Parse_Upload_Pack_ACK_Packet
             (Bytes_From_String
                ("0037ACK 3b18e512dba79e4c8300dd08aeb37f8e728b8dad ready"
                 & Character'Val (10)),
              Ack_Kind, Ack_Buffer, Ack_Last);
         Check_Status
           (Status_Value, CryptoLib.Errors.Ok,
            "git upload-pack ACK ready parsed");
         Check
           (Ack_Kind = SSH_Lib.Git.Upload_Pack_ACK_Ready
            and then Ack_Last = Ack_Buffer'First + 39
            and then Bytes_Equal
              (Ack_Buffer (Ack_Buffer'First .. Ack_Last),
               Bytes_From_String
                 ("3b18e512dba79e4c8300dd08aeb37f8e728b8dad")),
            "git upload-pack ACK ready values");

         Status_Value :=
           SSH_Lib.Git.Parse_Upload_Pack_ACK_Packet
             (Bytes_From_String ("0008NAK" & Character'Val (10)),
              Ack_Kind, Ack_Buffer, Ack_Last);
         Check_Status
           (Status_Value, CryptoLib.Errors.Ok,
            "git upload-pack NAK parsed");
         Check
           (Ack_Kind = SSH_Lib.Git.Upload_Pack_NAK
            and then Ack_Last < Ack_Buffer'First,
            "git upload-pack NAK values");

         Status_Value :=
           SSH_Lib.Git.Parse_Upload_Pack_ACK_Packet
             (Bytes_From_String
                ("0037ACK 3b18e512dba79e4c8300dd08aeb37f8e728b8dad later"
                 & Character'Val (10)),
              Ack_Kind, Ack_Buffer, Ack_Last);
         Check_Status
           (Status_Value, CryptoLib.Errors.Invalid_Command,
            "git upload-pack ACK rejects unknown status");

         declare
            ACK_Stream : constant Ada.Streams.Stream_Element_Array :=
              Bytes_From_String ("0008NAK" & Character'Val (10))
              & Bytes_From_String
                  ("0037ACK 3b18e512dba79e4c8300dd08aeb37f8e728b8dad ready"
                   & Character'Val (10))
              & SSH_Lib.Protocol.Buffers.To_Array
                  (SSH_Lib.Git.Encode_Pkt_Flush);
            Bad_After_Flush : constant Ada.Streams.Stream_Element_Array :=
              Bytes_From_String ("0008NAK" & Character'Val (10))
              & SSH_Lib.Protocol.Buffers.To_Array
                  (SSH_Lib.Git.Encode_Pkt_Flush)
              & Bytes_From_String ("0008NAK" & Character'Val (10));
         begin
            Status_Value :=
              SSH_Lib.Git.Validate_Upload_Pack_ACK_Stream
                (ACK_Stream, ACK_Stream_Summary);
            Check_Status
              (Status_Value, CryptoLib.Errors.Ok,
               "git upload-pack ACK stream validated");
            Check
              (ACK_Stream_Summary.NAK_Count = 1
               and then ACK_Stream_Summary.Ready_Count = 1
               and then ACK_Stream_Summary.Has_Flush,
               "git upload-pack ACK stream summary values");

            Status_Value :=
              SSH_Lib.Git.Validate_Upload_Pack_ACK_Stream
                (SSH_Lib.Protocol.Buffers.To_Array
                   (SSH_Lib.Git.Encode_Pkt_Delimiter),
                 ACK_Stream_Summary);
            Check_Status
              (Status_Value, CryptoLib.Errors.Invalid_Command,
               "git upload-pack ACK stream rejects delimiter");

            Status_Value :=
              SSH_Lib.Git.Validate_Upload_Pack_ACK_Stream
                (Bad_After_Flush, ACK_Stream_Summary);
            Check_Status
              (Status_Value, CryptoLib.Errors.Invalid_Command,
               "git upload-pack ACK stream rejects bytes after flush");
         end;
      end;

      declare
         Want_ID : constant SSH_Lib.Git.Object_ID_Hex_Text :=
           Object_ID_From_String
             ("3b18e512dba79e4c8300dd08aeb37f8e728b8dad");
         Have_ID : constant SSH_Lib.Git.Object_ID_Hex_Text :=
           Object_ID_From_String
             ("1111111111111111111111111111111111111111");
         Zero_ID : constant SSH_Lib.Git.Object_ID_Hex_Text :=
           Object_ID_From_String
             ("0000000000000000000000000000000000000000");
         New_ID : constant SSH_Lib.Git.Object_ID_Hex_Text :=
           Object_ID_From_String
             ("2222222222222222222222222222222222222222");
         Fetch_Request : constant Ada.Streams.Stream_Element_Array :=
           SSH_Lib.Protocol.Buffers.To_Array
             (SSH_Lib.Git.Encode_Upload_Pack_Fetch_Request
                (Wants        => [1 => Want_ID],
                 Haves        => [1 => Have_ID],
                 Shallows     => [1 .. 0 => Want_ID],
                 Capabilities => Bytes_From_String
                   ("multi_ack_detailed side-band-64k"),
                 Depth        => 1,
                 Filter_Spec  => Bytes_From_String ("blob:none"),
                 Include_Done => True));
         Update_Line : constant Ada.Streams.Stream_Element_Array :=
           SSH_Lib.Protocol.Buffers.To_Array
             (SSH_Lib.Git.Encode_Receive_Pack_Update_Line
                (Old_ID_Hex   => Zero_ID,
                 New_ID_Hex   => New_ID,
                 Ref_Name     => Bytes_From_String ("refs/heads/main"),
                 Capabilities => Bytes_From_String ("report-status side-band-64k")));
         Receive_Request : constant Ada.Streams.Stream_Element_Array :=
           Update_Line
           & SSH_Lib.Protocol.Buffers.To_Array (SSH_Lib.Git.Encode_Pkt_Flush)
           & Bytes_From_String
               ("PACK" & Character'Val (0) & Character'Val (0)
                & Character'Val (0) & Character'Val (2)
                & Character'Val (0) & Character'Val (0)
                & Character'Val (0) & Character'Val (0));
         V2_Request : constant Ada.Streams.Stream_Element_Array :=
           SSH_Lib.Protocol.Buffers.To_Array
             (SSH_Lib.Git.Encode_Protocol_V2_Command_Request
                (Command_Name => Bytes_From_String ("ls-refs"),
                 Capabilities => Bytes_From_String ("agent=sshlib"),
                 Arguments    => Bytes_From_String
                   ("symrefs" & Character'Val (10)
                    & "ref-prefix refs/heads/")));
      begin
         Check
           (Fetch_Request'Length > 0,
            "git upload-pack full fetch request encoded");
         Status_Value :=
           SSH_Lib.Git.Validate_Upload_Pack_Negotiation_Request
             (Fetch_Request, Negotiation_Summary);
         Check_Status
           (Status_Value, CryptoLib.Errors.Ok,
            "git upload-pack full fetch request validated");
         Check
           (Negotiation_Summary.Want_Count = 1
            and then Negotiation_Summary.Have_Count = 1
            and then Negotiation_Summary.Deepen_Count = 1
            and then Negotiation_Summary.Filter_Count = 1
            and then Negotiation_Summary.Has_Done
            and then Negotiation_Summary.Uses_Multi_ACK_Detailed
            and then Negotiation_Summary.Uses_Side_Band_64K,
            "git upload-pack full fetch summary values");

         Check
           (Bytes_Equal
               (Update_Line,
               Bytes_From_String
                 ("00820000000000000000000000000000000000000000"
                  & " 2222222222222222222222222222222222222222"
                  & " refs/heads/main report-status side-band-64k"
                  & Character'Val (10))),
            "git receive-pack update line encoded");
         Status_Value :=
           SSH_Lib.Git.Validate_Receive_Pack_Request
             (Receive_Request, Receive_Summary);
         Check_Status
           (Status_Value, CryptoLib.Errors.Ok,
            "git receive-pack request validated");
         Check
           (Receive_Summary.Update_Count = 1
            and then Receive_Summary.Has_Create
            and then Receive_Summary.Has_Capabilities
            and then Receive_Summary.Has_Flush
            and then Receive_Summary.Has_Pack_Data
            and then Receive_Summary.Pack_Object_Count = 0,
            "git receive-pack request summary values");

         declare
            Fetch_Workflow : SSH_Lib.Git.Fetch_Workflow;
            Push_Workflow  : SSH_Lib.Git.Push_Workflow;
            Built_Request  : SSH_Lib.Protocol.Buffers.Packet_Buffer;
            Fetch_Decision : SSH_Lib.Git.Fetch_Policy_Decision;
            Push_Decision  : SSH_Lib.Git.Push_Policy_Decision;
            Upload_Response : constant Ada.Streams.Stream_Element_Array :=
              Bytes_From_String ("0008NAK" & Character'Val (10));
            Receive_Report : constant Ada.Streams.Stream_Element_Array :=
              SSH_Lib.Protocol.Buffers.To_Array
                (SSH_Lib.Git.Encode_Pkt_Line
                   (Bytes_From_String
                      ("unpack ok" & Character'Val (10))))
              & SSH_Lib.Protocol.Buffers.To_Array
                  (SSH_Lib.Git.Encode_Pkt_Line
                     (Bytes_From_String
                        ("ok refs/heads/main" & Character'Val (10))))
              & SSH_Lib.Protocol.Buffers.To_Array
                  (SSH_Lib.Git.Encode_Pkt_Flush);
            Error_Report : constant Ada.Streams.Stream_Element_Array :=
              SSH_Lib.Protocol.Buffers.To_Array
                (SSH_Lib.Git.Encode_Pkt_Line
                   (Bytes_From_String
                      ("unpack ok" & Character'Val (10))))
              & SSH_Lib.Protocol.Buffers.To_Array
                  (SSH_Lib.Git.Encode_Pkt_Line
                     (Bytes_From_String
                        ("ng refs/heads/main denied" & Character'Val (10))))
              & SSH_Lib.Protocol.Buffers.To_Array
                  (SSH_Lib.Git.Encode_Pkt_Flush);
         begin
            SSH_Lib.Git.Reset_Fetch_Workflow (Fetch_Workflow);
            Status_Value :=
              SSH_Lib.Git.Fetch_Build_Request
                (Fetch_Workflow,
                 Wants        => [1 => Want_ID],
                 Haves        => [1 => Have_ID],
                 Shallows     => [1 .. 0 => Want_ID],
                 Capabilities => Bytes_From_String
                   ("multi_ack_detailed side-band-64k"),
                 Depth        => 1,
                 Filter_Spec  => Bytes_From_String ("blob:none"),
                 Include_Done => True,
                 Request      => Built_Request);
            Check_Status
              (Status_Value, CryptoLib.Errors.Ok,
               "git fetch workflow builds request");
            Check
              (Fetch_Workflow.State = SSH_Lib.Git.Fetch_Request_Built
               and then Fetch_Workflow.Request_Summary.Want_Count = 1
               and then SSH_Lib.Protocol.Buffers.Length (Built_Request) =
                 Fetch_Request'Length,
               "git fetch workflow records built request state");

            Status_Value :=
              SSH_Lib.Git.Decide_Fetch_Policy
                (Fetch_Workflow, 1, 3, 4, Fetch_Decision);
            Check_Status
              (Status_Value, CryptoLib.Errors.Ok,
               "git fetch policy evaluates built request");
            Check
              (Fetch_Decision = SSH_Lib.Git.Fetch_Policy_Stop,
               "git fetch policy stops completed one-shot request");

            Status_Value :=
              SSH_Lib.Git.Fetch_Accept_Response
                (Fetch_Workflow, Upload_Response);
            Check_Status
              (Status_Value, CryptoLib.Errors.Ok,
               "git fetch workflow accepts upload-pack response");
            Check
              (Fetch_Workflow.State = SSH_Lib.Git.Fetch_Response_Accepted
               and then Fetch_Workflow.Response_Summary.Has_NAK,
               "git fetch workflow records response state");

            Status_Value :=
              SSH_Lib.Git.Decide_Fetch_Policy
                (Fetch_Workflow, 1, 3, 4, Fetch_Decision);
            Check_Status
              (Status_Value, CryptoLib.Errors.Ok,
               "git fetch policy evaluates accepted response");
            Check
              (Fetch_Decision = SSH_Lib.Git.Fetch_Policy_Stop,
               "git fetch policy stops NAK response without pack");

            Status_Value := SSH_Lib.Git.Fetch_Finish (Fetch_Workflow);
            Check_Status
              (Status_Value, CryptoLib.Errors.Ok,
               "git fetch workflow finishes after response");
            Check
              (Fetch_Workflow.State = SSH_Lib.Git.Fetch_Finished,
               "git fetch workflow final state recorded");

            Status_Value :=
              SSH_Lib.Git.Fetch_Accept_Response
                (Fetch_Workflow, Upload_Response);
            Check_Status
              (Status_Value, CryptoLib.Errors.Invalid_Command,
               "git fetch workflow rejects out-of-order response");
            Check
              (Fetch_Workflow.State = SSH_Lib.Git.Fetch_Failed,
               "git fetch workflow records failed state");
            Status_Value :=
              SSH_Lib.Git.Decide_Fetch_Policy
                (Fetch_Workflow, 1, 2, 0, Fetch_Decision);
            Check_Status
              (Status_Value, CryptoLib.Errors.Ok,
               "git fetch policy evaluates failed workflow");
            Check
              (Fetch_Decision = SSH_Lib.Git.Fetch_Policy_Retry,
               "git fetch policy retries failed workflow within cap");

            SSH_Lib.Git.Reset_Push_Workflow (Push_Workflow);
            Status_Value :=
              SSH_Lib.Git.Push_Build_Request
                (Push_Workflow,
                 Updates   => Update_Line,
                 Pack_Data => Bytes_From_String
                   ("PACK" & Character'Val (0) & Character'Val (0)
                    & Character'Val (0) & Character'Val (2)
                    & Character'Val (0) & Character'Val (0)
                    & Character'Val (0) & Character'Val (0)),
                 Request   => Built_Request);
            Check_Status
              (Status_Value, CryptoLib.Errors.Ok,
               "git push workflow builds request");
            Check
              (Push_Workflow.State = SSH_Lib.Git.Push_Request_Built
               and then Push_Workflow.Request_Summary.Update_Count = 1
               and then Push_Workflow.Request_Summary.Has_Pack_Data,
               "git push workflow records built request state");

            Status_Value :=
              SSH_Lib.Git.Decide_Push_Policy
                (Push_Workflow, 1, 3, Push_Decision);
            Check_Status
              (Status_Value, CryptoLib.Errors.Ok,
               "git push policy evaluates request with pack");
            Check
              (Push_Decision = SSH_Lib.Git.Push_Policy_Stop,
               "git push policy accepts request that already has pack data");

            Status_Value :=
              SSH_Lib.Git.Push_Accept_Report
                (Push_Workflow, Receive_Report);
            Check_Status
              (Status_Value, CryptoLib.Errors.Ok,
               "git push workflow accepts receive-pack report");
            Check
              (Push_Workflow.State = SSH_Lib.Git.Push_Report_Accepted
               and then Push_Workflow.Report_Summary.Ref_OK_Count = 1,
               "git push workflow records report state");

            Status_Value := SSH_Lib.Git.Push_Finish (Push_Workflow);
            Check_Status
              (Status_Value, CryptoLib.Errors.Ok,
               "git push workflow finishes after report");
            Check
              (Push_Workflow.State = SSH_Lib.Git.Push_Finished,
               "git push workflow final state recorded");

            SSH_Lib.Git.Reset_Push_Workflow (Push_Workflow);
            Status_Value :=
              SSH_Lib.Git.Push_Build_Request
                (Push_Workflow,
                 Updates   => Update_Line,
                 Pack_Data => [1 .. 0 => 0],
                 Request   => Built_Request);
            Check_Status
              (Status_Value, CryptoLib.Errors.Ok,
               "git push workflow builds request without pack data");
            Status_Value :=
              SSH_Lib.Git.Push_Accept_Report
                (Push_Workflow, Error_Report);
            Check_Status
              (Status_Value, CryptoLib.Errors.Remote_Failure,
               "git push workflow rejects remote ref errors");
            Check
              (Push_Workflow.State = SSH_Lib.Git.Push_Failed
               and then Push_Workflow.Report_Summary.Ref_Error_Count = 1,
               "git push workflow preserves failed report summary");
            Status_Value :=
              SSH_Lib.Git.Decide_Push_Policy
                (Push_Workflow, 1, 2, Push_Decision);
            Check_Status
              (Status_Value, CryptoLib.Errors.Ok,
               "git push policy evaluates failed workflow");
            Check
              (Push_Decision = SSH_Lib.Git.Push_Policy_Retry,
               "git push policy retries failed workflow within cap");

            SSH_Lib.Git.Reset_Push_Workflow (Push_Workflow);
            Status_Value :=
              SSH_Lib.Git.Push_Build_Request
                (Push_Workflow,
                 Updates   => Update_Line,
                 Pack_Data => [1 .. 0 => 0],
                 Request   => Built_Request);
            Check_Status
              (Status_Value, CryptoLib.Errors.Ok,
               "git push policy fixture builds create without pack");
            Status_Value :=
              SSH_Lib.Git.Decide_Push_Policy
                (Push_Workflow, 1, 3, Push_Decision);
            Check_Status
              (Status_Value, CryptoLib.Errors.Ok,
               "git push policy evaluates missing pack");
            Check
              (Push_Decision = SSH_Lib.Git.Push_Policy_Rebuild_With_Pack,
               "git push policy selects pack rebuild for create/update");
         end;

         Status_Value :=
           SSH_Lib.Git.Validate_Receive_Pack_Request
             (Update_Line & Update_Line
              & SSH_Lib.Protocol.Buffers.To_Array
                  (SSH_Lib.Git.Encode_Pkt_Flush),
              Receive_Summary);
         Check_Status
           (Status_Value, CryptoLib.Errors.Invalid_Command,
            "git receive-pack rejects capabilities after first command");

         Check
           (V2_Request'Length > 0,
            "git protocol v2 ls-refs request encoded");
         Status_Value :=
           SSH_Lib.Git.Validate_Protocol_V2_Command_Request
             (V2_Request, Protocol_V2_Summary);
         Check_Status
           (Status_Value, CryptoLib.Errors.Ok,
            "git protocol v2 ls-refs request validated");
         Check
           (Protocol_V2_Summary.Command_Count = 1
            and then Protocol_V2_Summary.Capability_Count = 1
            and then Protocol_V2_Summary.Argument_Count = 2
            and then Protocol_V2_Summary.Has_Ls_Refs
            and then Protocol_V2_Summary.Has_Symrefs
            and then Protocol_V2_Summary.Has_Ref_Prefix
            and then Protocol_V2_Summary.Has_Delimiter
            and then Protocol_V2_Summary.Has_Flush,
            "git protocol v2 ls-refs summary values");

         declare
            V2_Fetch_Request : constant Ada.Streams.Stream_Element_Array :=
              SSH_Lib.Protocol.Buffers.To_Array
                (SSH_Lib.Git.Encode_Protocol_V2_Command_Request
                   (Command_Name => Bytes_From_String ("fetch"),
                    Capabilities => Bytes_From_String ("agent=sshlib"),
                    Arguments    => Bytes_From_String
                      ("want 3b18e512dba79e4c8300dd08aeb37f8e728b8dad"
                       & Character'Val (10))));
         begin
            Status_Value :=
              SSH_Lib.Git.Validate_Protocol_V2_Command_Request
                (V2_Fetch_Request, Protocol_V2_Summary);
            Check_Status
              (Status_Value, CryptoLib.Errors.Ok,
               "git protocol v2 fetch request validated");
            Check
             (Protocol_V2_Summary.Has_Fetch
               and then not Protocol_V2_Summary.Has_Ls_Refs
               and then Protocol_V2_Summary.Has_Agent
               and then Protocol_V2_Summary.Has_Want
               and then Protocol_V2_Summary.Argument_Count = 1,
               "git protocol v2 fetch summary values");
         end;

         declare
            V2_Fetch_Argument_Request :
              constant Ada.Streams.Stream_Element_Array :=
                SSH_Lib.Protocol.Buffers.To_Array
                  (SSH_Lib.Git.Encode_Protocol_V2_Command_Request
                     (Command_Name => Bytes_From_String ("fetch"),
                      Capabilities => Bytes_From_String ("agent=sshlib"),
                      Arguments    => Bytes_From_String
                        ("have 3b18e512dba79e4c8300dd08aeb37f8e728b8dad"
                         & Character'Val (10)
                         & "filter blob:none" & Character'Val (10)
                         & "done" & Character'Val (10))));
         begin
            Status_Value :=
              SSH_Lib.Git.Validate_Protocol_V2_Command_Request
                (V2_Fetch_Argument_Request, Protocol_V2_Summary);
            Check_Status
              (Status_Value, CryptoLib.Errors.Ok,
               "git protocol v2 fetch argument request validated");
            Check
              (Protocol_V2_Summary.Has_Fetch
               and then Protocol_V2_Summary.Has_Have
               and then Protocol_V2_Summary.Has_Filter
               and then Protocol_V2_Summary.Has_Done
               and then Protocol_V2_Summary.Argument_Count = 3,
               "git protocol v2 fetch argument summary values");
         end;

         declare
            V2_Object_Format_Request :
              constant Ada.Streams.Stream_Element_Array :=
                SSH_Lib.Protocol.Buffers.To_Array
                  (SSH_Lib.Git.Encode_Protocol_V2_Command_Request
                     (Command_Name => Bytes_From_String ("object-info"),
                      Capabilities => Bytes_From_String
                        ("object-format=sha1" & Character'Val (10)
                         & "server-option=trace" & Character'Val (10)
                         & "session-id=abc123" & Character'Val (10)),
                      Arguments    => Bytes_From_String
                        ("oid 3b18e512dba79e4c8300dd08aeb37f8e728b8dad"
                         & Character'Val (10))));
         begin
            Status_Value :=
              SSH_Lib.Git.Validate_Protocol_V2_Command_Request
                (V2_Object_Format_Request, Protocol_V2_Summary);
            Check_Status
              (Status_Value, CryptoLib.Errors.Ok,
               "git protocol v2 object-info request validated");
            Check
              (Protocol_V2_Summary.Has_Object_Info
               and then Protocol_V2_Summary.Has_Object_Format
               and then Protocol_V2_Summary.Has_Server_Option
               and then Protocol_V2_Summary.Has_Session_ID
               and then Protocol_V2_Summary.Capability_Count = 3
               and then Protocol_V2_Summary.Argument_Count = 1,
               "git protocol v2 request capability summary values");
         end;

         declare
            V2_Capabilities : constant Ada.Streams.Stream_Element_Array :=
              SSH_Lib.Protocol.Buffers.To_Array
                (SSH_Lib.Git.Encode_Pkt_Line
                   (Bytes_From_String ("ls-refs" & Character'Val (10))))
              & SSH_Lib.Protocol.Buffers.To_Array
                  (SSH_Lib.Git.Encode_Pkt_Line
                     (Bytes_From_String
                        ("fetch=shallow filter" & Character'Val (10))))
              & SSH_Lib.Protocol.Buffers.To_Array
                  (SSH_Lib.Git.Encode_Pkt_Line
                     (Bytes_From_String
                        ("server-option" & Character'Val (10))))
              & SSH_Lib.Protocol.Buffers.To_Array
                  (SSH_Lib.Git.Encode_Pkt_Line
                     (Bytes_From_String
                        ("object-format=sha1" & Character'Val (10))))
              & SSH_Lib.Protocol.Buffers.To_Array
                  (SSH_Lib.Git.Encode_Pkt_Line
                     (Bytes_From_String
                        ("agent=sshlib" & Character'Val (10))))
              & SSH_Lib.Protocol.Buffers.To_Array
                  (SSH_Lib.Git.Encode_Pkt_Flush);
            Missing_Flush : constant Ada.Streams.Stream_Element_Array :=
              SSH_Lib.Protocol.Buffers.To_Array
                (SSH_Lib.Git.Encode_Pkt_Line
                   (Bytes_From_String ("ls-refs" & Character'Val (10))));
         begin
            Status_Value :=
              SSH_Lib.Git.Validate_Protocol_V2_Capability_Advertisement
                (V2_Capabilities, Protocol_V2_Capability_Summary);
            Check_Status
              (Status_Value, CryptoLib.Errors.Ok,
               "git protocol v2 capability advertisement validated");
            Check
              (Protocol_V2_Capability_Summary.Capability_Count = 5
               and then Protocol_V2_Capability_Summary.Has_Ls_Refs
               and then Protocol_V2_Capability_Summary.Has_Fetch
               and then Protocol_V2_Capability_Summary.Has_Server_Option
               and then Protocol_V2_Capability_Summary.Has_Object_Format
               and then Protocol_V2_Capability_Summary.Has_Agent
               and then Protocol_V2_Capability_Summary.Has_Flush,
               "git protocol v2 capability advertisement summary values");

            Status_Value :=
              SSH_Lib.Git.Validate_Protocol_V2_Capability_Advertisement
                (SSH_Lib.Protocol.Buffers.To_Array
                   (SSH_Lib.Git.Encode_Pkt_Delimiter),
                 Protocol_V2_Capability_Summary);
            Check_Status
              (Status_Value, CryptoLib.Errors.Invalid_Command,
               "git protocol v2 capability advertisement rejects delimiter");

            Status_Value :=
              SSH_Lib.Git.Validate_Protocol_V2_Capability_Advertisement
                (Missing_Flush, Protocol_V2_Capability_Summary);
            Check_Status
              (Status_Value, CryptoLib.Errors.Invalid_Command,
               "git protocol v2 capability advertisement requires flush");
         end;

         declare
            Upload_Response : constant Ada.Streams.Stream_Element_Array :=
              Bytes_From_String ("0008NAK" & Character'Val (10))
              & SSH_Lib.Protocol.Buffers.To_Array
                  (SSH_Lib.Git.Encode_Pkt_Line
                     ([1 => 1, 2 => Character'Pos ('P'),
                       3 => Character'Pos ('A'), 4 => Character'Pos ('C'),
                       5 => Character'Pos ('K'), 6 => 0, 7 => 0, 8 => 0,
                       9 => 2, 10 => 0, 11 => 0, 12 => 0, 13 => 0]))
              & SSH_Lib.Protocol.Buffers.To_Array
                  (SSH_Lib.Git.Encode_Pkt_Flush);
            Receive_Report : constant Ada.Streams.Stream_Element_Array :=
              SSH_Lib.Protocol.Buffers.To_Array
                (SSH_Lib.Git.Encode_Pkt_Line
                   (Bytes_From_String ("unpack ok" & Character'Val (10))))
              & SSH_Lib.Protocol.Buffers.To_Array
                  (SSH_Lib.Git.Encode_Pkt_Line
                     (Bytes_From_String
                        ("ok refs/heads/main" & Character'Val (10))))
              & SSH_Lib.Protocol.Buffers.To_Array
                  (SSH_Lib.Git.Encode_Pkt_Flush);
            V2_Response : constant Ada.Streams.Stream_Element_Array :=
              SSH_Lib.Protocol.Buffers.To_Array
                (SSH_Lib.Git.Encode_Pkt_Line
                   (Bytes_From_String
                      ("3b18e512dba79e4c8300dd08aeb37f8e728b8dad HEAD"
                       & Character'Val (10))))
              & SSH_Lib.Protocol.Buffers.To_Array
                  (SSH_Lib.Git.Encode_Pkt_Response_End);
            Single_Ref_Advertisement :
              constant Ada.Streams.Stream_Element_Array :=
              SSH_Lib.Protocol.Buffers.To_Array
                (SSH_Lib.Git.Encode_Pkt_Line
                   (Bytes_From_String
                      ("1111111111111111111111111111111111111111 HEAD"
                       & Character'Val (0)
                       & "symref=HEAD:refs/heads/main multi_ack"
                       & Character'Val (10))));
            Ref_Advertisement : constant Ada.Streams.Stream_Element_Array :=
              Single_Ref_Advertisement
              & SSH_Lib.Protocol.Buffers.To_Array
                  (SSH_Lib.Git.Encode_Pkt_Line
                     (Bytes_From_String
                        ("2222222222222222222222222222222222222222 "
                         & "refs/tags/v1^{}" & Character'Val (10))))
              & SSH_Lib.Protocol.Buffers.To_Array
                  (SSH_Lib.Git.Encode_Pkt_Flush);
            V2_Ls_Refs_Response : constant Ada.Streams.Stream_Element_Array :=
              SSH_Lib.Protocol.Buffers.To_Array
                (SSH_Lib.Git.Encode_Pkt_Line
                   (Bytes_From_String
                      ("3333333333333333333333333333333333333333 "
                       & "refs/heads/main symref-target:refs/heads/main"
                       & Character'Val (10))))
              & SSH_Lib.Protocol.Buffers.To_Array
                  (SSH_Lib.Git.Encode_Pkt_Response_End);
         begin
            Status_Value :=
              SSH_Lib.Git.Validate_Upload_Pack_Response
                (Upload_Response, Upload_Response_Summary);
            Check_Status
              (Status_Value, CryptoLib.Errors.Ok,
               "git upload-pack response validated");
            Check
              (Upload_Response_Summary.Has_NAK
               and then Upload_Response_Summary.Side_Data_Count = 1
               and then Upload_Response_Summary.Has_Pack_Data
               and then Upload_Response_Summary.Pack_Object_Count = 0
               and then Upload_Response_Summary.Has_Flush,
               "git upload-pack response summary values");

            Status_Value :=
              SSH_Lib.Git.Validate_Receive_Pack_Report
                (Receive_Report, Receive_Report_Summary);
            Check_Status
              (Status_Value, CryptoLib.Errors.Ok,
               "git receive-pack report validated");
            Check
              (Receive_Report_Summary.Has_Unpack_OK
               and then Receive_Report_Summary.Ref_OK_Count = 1
               and then Receive_Report_Summary.Has_Flush,
               "git receive-pack report summary values");

            Status_Value :=
              SSH_Lib.Git.Validate_Protocol_V2_Response
                (V2_Response, Protocol_V2_Response_Summary);
            Check_Status
              (Status_Value, CryptoLib.Errors.Ok,
               "git protocol v2 response validated");
            Check
              (Protocol_V2_Response_Summary.Data_Count = 1
               and then Protocol_V2_Response_Summary.Has_Response_End,
               "git protocol v2 response summary values");

            Status_Value :=
              SSH_Lib.Git.Validate_Protocol_V2_Response
                (SSH_Lib.Protocol.Buffers.To_Array
                   (SSH_Lib.Git.Encode_Pkt_Line
                      (Bytes_From_String ("section-one" & Character'Val (10))))
                 & SSH_Lib.Protocol.Buffers.To_Array
                     (SSH_Lib.Git.Encode_Pkt_Delimiter)
                 & SSH_Lib.Protocol.Buffers.To_Array
                     (SSH_Lib.Git.Encode_Pkt_Line
                        (Bytes_From_String
                           ("section-two" & Character'Val (10))))
                 & SSH_Lib.Protocol.Buffers.To_Array
                     (SSH_Lib.Git.Encode_Pkt_Response_End),
                 Protocol_V2_Response_Summary);
            Check_Status
              (Status_Value, CryptoLib.Errors.Ok,
               "git protocol v2 response with delimiter validated");
            Check
              (Protocol_V2_Response_Summary.Data_Count = 2
               and then Protocol_V2_Response_Summary.Delimiter_Count = 1
               and then Protocol_V2_Response_Summary.Has_Delimiter
               and then Protocol_V2_Response_Summary.Has_Response_End,
               "git protocol v2 delimiter response summary values");

            Status_Value :=
              SSH_Lib.Git.Validate_Protocol_V2_Response
                (SSH_Lib.Protocol.Buffers.To_Array
                   (SSH_Lib.Git.Encode_Pkt_Line
                      (Bytes_From_String
                         ("ERR server rejected request"
                          & Character'Val (10))))
                 & SSH_Lib.Protocol.Buffers.To_Array
                     (SSH_Lib.Git.Encode_Pkt_Response_End),
                 Protocol_V2_Response_Summary);
            Check_Status
              (Status_Value, CryptoLib.Errors.Ok,
               "git protocol v2 error response validated");
            Check
              (Protocol_V2_Response_Summary.Data_Count = 1
               and then Protocol_V2_Response_Summary.Has_Error_Line
               and then Protocol_V2_Response_Summary.Has_Response_End,
               "git protocol v2 error response summary values");

            Status_Value :=
              SSH_Lib.Git.Parse_Ref_Advertisement_Packet
                (Single_Ref_Advertisement,
                 Object_Buffer,
                 Object_Last,
                 Ref_Buffer,
                 Ref_Last,
                 Cap_Token,
                 Cap_Token_Last,
                 Ref_Has_Caps,
                 Ref_Is_Peeled,
                 Ref_Is_Symref);
            Check_Status
              (Status_Value, CryptoLib.Errors.Ok,
               "git ref advertisement packet parsed");
            Check
              (Object_Last = Object_Buffer'Last
               and then Bytes_Equal
                 (Ref_Buffer (Ref_Buffer'First .. Ref_Last),
                  Bytes_From_String ("HEAD"))
               and then Ref_Has_Caps
               and then Ref_Is_Symref
               and then not Ref_Is_Peeled,
               "git ref advertisement packet values");

            Status_Value :=
              SSH_Lib.Git.Validate_Ref_Advertisement_Stream
                (Ref_Advertisement, Ref_Advertisement_Summary);
            Check_Status
              (Status_Value, CryptoLib.Errors.Ok,
               "git ref advertisement stream validated");
            Check
              (Ref_Advertisement_Summary.Ref_Count = 2
               and then Ref_Advertisement_Summary.Peeled_Count = 1
               and then Ref_Advertisement_Summary.Symref_Count = 1
               and then Ref_Advertisement_Summary.Capability_Count = 2
               and then Ref_Advertisement_Summary.Has_HEAD
               and then Ref_Advertisement_Summary.Has_Capabilities
               and then Ref_Advertisement_Summary.Has_Flush,
               "git ref advertisement stream summary values");

            Status_Value :=
              SSH_Lib.Git.Validate_Ref_Advertisement_Stream
