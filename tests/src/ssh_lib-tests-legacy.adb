   procedure Run_Phase_10_Session_Lifecycle_Tests is
      Options      : SSH_Lib.Sessions.Session_Options;
      Session_Item : SSH_Lib.Sessions.Session;
      Status_Value : CryptoLib.Errors.Status;
      Channel_Item : SSH_Lib.Channels.Channel;
   begin
      Options.Host := To_Unbounded_String ("example.com");
      Options.User := To_Unbounded_String ("git");
      Options.Port := 22;
      Options.Use_Agent := False;
      Options.Identity_File := Null_Unbounded_String;

      Status_Value := SSH_Lib.Sessions.Open (Options, Session_Item);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Authentication_Failed,
         "phase10 no auth method fails deterministically");
      Status_Value := SSH_Lib.Sessions.Close (Session_Item);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Ok,
         "phase10 close after failed open ok");
      Status_Value := SSH_Lib.Sessions.Close (Session_Item);
      Check_Status
        (Status_Value, CryptoLib.Errors.Ok, "phase10 close idempotent");
      Options.Host := Null_Unbounded_String;
      Options.Identity_File := Null_Unbounded_String;
      Status_Value := SSH_Lib.Sessions.Open (Options, Session_Item);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Invalid_Host,
         "phase10 validation failure is first decisive status");
      Options.Host := To_Unbounded_String ("example.com");
      Options.Identity_File :=
        To_Unbounded_String ("bad" & Character'Val (0) & "identity");
      Status_Value := SSH_Lib.Sessions.Open (Options, Session_Item);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Authentication_Failed,
         "phase10 invalid identity path syntax fails before open");
      Options.Identity_File := Null_Unbounded_String;
      Options.Verify_Known_Host := True;
      Options.Known_Hosts_File :=
        To_Unbounded_String ("bad" & Character'Val (10) & "known_hosts");
      Status_Value := SSH_Lib.Sessions.Open (Options, Session_Item);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Host_Key_Unknown,
         "phase10 invalid known hosts path syntax fails before open");
      Options.Known_Hosts_File := Null_Unbounded_String;
      Options.Connect_Timeout_MS := 0;
      Options.Read_Timeout_MS := 30_000;
      Options.Write_Timeout_MS := 30_000;
      Options.Use_Agent := True;
      Options.Identity_File := Null_Unbounded_String;
      Status_Value := SSH_Lib.Sessions.Open (Options, Session_Item);
      Touch (Session_Item);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Timeout,
         "phase10 zero connect timeout fails deterministically");
      Options.Connect_Timeout_MS := 30_000;
      Options.Read_Timeout_MS := 0;
      Status_Value := SSH_Lib.Sessions.Open (Options, Session_Item);
      Touch (Session_Item);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Timeout,
         "phase10 zero read timeout fails deterministically");

      Options.Read_Timeout_MS := 30_000;
      Options.Write_Timeout_MS := 0;
      Status_Value := SSH_Lib.Sessions.Open (Options, Session_Item);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Timeout,
         "phase10 zero write timeout fails deterministically");

      Options.Write_Timeout_MS := 30_000;
      Options.Verify_Known_Host := False;
      Options.Use_Agent := False;
      Options.Identity_File := Null_Unbounded_String;
      Status_Value := SSH_Lib.Sessions.Open (Options, Session_Item);
      Touch (Session_Item);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Authentication_Failed,
         "phase10 explicit known-host bypass still requires auth");
      Options.Verify_Known_Host := True;
      Options.Use_Agent := True;
      SSH_Lib.Platform.Environment.Set_Value_For_Test
        ("SSH_AUTH_SOCK", "/tmp/ssh_lib_agent.sock");
      Status_Value := SSH_Lib.Sessions.Open (Options, Session_Item);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Connection_Failed,
         "phase10 valid preflight reaches connection boundary");
      SSH_Lib.Platform.Environment.Reset_Provider;

      Status_Value := SSH_Lib.Sessions.Close (Session_Item);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Ok,
         "phase10 close after unsupported boundary ok");

      Status_Value :=
        SSH_Lib.Channels.Open_Exec
          (Session_Item, "git-upload-pack 'repo.git'", Channel_Item);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Channel_Open_Failed,
         "phase11 channel rejects unopened session");
   end Run_Phase_10_Session_Lifecycle_Tests;

   function Build_Open_Confirmation
     (Recipient_Channel   : Interfaces.Unsigned_32;
      Sender_Channel      : Interfaces.Unsigned_32;
      Initial_Window_Size : Interfaces.Unsigned_32;
      Maximum_Packet_Size : Interfaces.Unsigned_32)
      return Ada.Streams.Stream_Element_Array
   is
      Work_Item    : SSH_Lib.Protocol.Buffers.Packet_Buffer;
      Status_Value : CryptoLib.Errors.Status;
   begin
      SSH_Lib.Protocol.Buffers.Clear (Work_Item);
      Status_Value :=
        SSH_Lib.Protocol.Buffers.Append_Byte
          (Work_Item,
           SSH_Lib.Protocol.Channels.SSH_MSG_CHANNEL_OPEN_CONFIRMATION);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Ok,
         "build open confirmation message byte");
      Status_Value :=
        SSH_Lib.Protocol.Buffers.Append
          (Work_Item,
           SSH_Lib.Protocol.Numbers.Encode_Uint32 (Recipient_Channel));
      Check_Status
        (Status_Value, CryptoLib.Errors.Ok, "build open confirmation recipient");
      Status_Value :=
        SSH_Lib.Protocol.Buffers.Append
          (Work_Item, SSH_Lib.Protocol.Numbers.Encode_Uint32 (Sender_Channel));
      Check_Status
        (Status_Value, CryptoLib.Errors.Ok, "build open confirmation sender");
      Status_Value :=
        SSH_Lib.Protocol.Buffers.Append
          (Work_Item,
           SSH_Lib.Protocol.Numbers.Encode_Uint32 (Initial_Window_Size));
      Check_Status
        (Status_Value, CryptoLib.Errors.Ok, "build open confirmation window");
      Status_Value :=
        SSH_Lib.Protocol.Buffers.Append
          (Work_Item,
           SSH_Lib.Protocol.Numbers.Encode_Uint32 (Maximum_Packet_Size));
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Ok,
         "build open confirmation packet size");
      return SSH_Lib.Protocol.Buffers.To_Array (Work_Item);
   end Build_Open_Confirmation;

   function Build_Open_Failure
     (Recipient_Channel : Interfaces.Unsigned_32)
      return Ada.Streams.Stream_Element_Array
   is
      Work_Item          : SSH_Lib.Protocol.Buffers.Packet_Buffer;
      Empty_String_Field :
        constant Ada.Streams.Stream_Element_Array
                   (Ada.Streams.Stream_Element_Offset'(1)
                    .. Ada.Streams.Stream_Element_Offset'(4)) := [others => 0];
      Status_Value       : CryptoLib.Errors.Status;
   begin
      SSH_Lib.Protocol.Buffers.Clear (Work_Item);
      Status_Value :=
        SSH_Lib.Protocol.Buffers.Append_Byte
          (Work_Item, SSH_Lib.Protocol.Channels.SSH_MSG_CHANNEL_OPEN_FAILURE);
      Check_Status
        (Status_Value, CryptoLib.Errors.Ok, "build open failure byte");
      Status_Value :=
        SSH_Lib.Protocol.Buffers.Append
          (Work_Item,
           SSH_Lib.Protocol.Numbers.Encode_Uint32 (Recipient_Channel));
      Check_Status
        (Status_Value, CryptoLib.Errors.Ok, "build open failure recipient");
      Status_Value :=
        SSH_Lib.Protocol.Buffers.Append
          (Work_Item,
           SSH_Lib.Protocol.Numbers.Encode_Uint32
             (Interfaces.Unsigned_32'(1)));
      Check_Status
        (Status_Value, CryptoLib.Errors.Ok, "build open failure reason");
