   procedure Run_Phase_11_Channel_Tests is
      Work_Item    : SSH_Lib.Protocol.Buffers.Packet_Buffer;
      Confirmation : SSH_Lib.Protocol.Channels.Open_Confirmation;
      Failure_Info : SSH_Lib.Protocol.Channels.Open_Failure;
      X11_Info     : SSH_Lib.Protocol.Channels.X11_Open;
      Reply_Value  : SSH_Lib.Protocol.Channels.Exec_Reply;
      Session_Item : SSH_Lib.Sessions.Session;
      Channel_Item : SSH_Lib.Channels.Channel;
      Status_Value : CryptoLib.Errors.Status;
      Last_Index   : Ada.Streams.Stream_Element_Offset;
      Buffer       : Ada.Streams.Stream_Element_Array (1 .. 4);
      Exit_Code    : Integer := -1;
      Bound_Port   : Natural := 0;
   begin
      Check
        (not SSH_Lib.Protocol.Channels.Valid_Command (""),
         "phase11 empty command invalid");
      Check
        (not SSH_Lib.Protocol.Channels.Valid_Command ("a" & Character'Val (0)),
         "phase11 nul command invalid");
      Check
        (not SSH_Lib.Protocol.Channels.Valid_Command
               ("a" & Character'Val (10)),
         "phase11 lf command invalid");
      Check
        (not SSH_Lib.Protocol.Channels.Valid_Command
               ("a" & Character'Val (13)),
         "phase11 cr command invalid");
      Check
        (SSH_Lib.Protocol.Channels.Valid_Command
           ("git-upload-pack 'repo.git'"),
         "phase11 upload command valid");
      Check
        (SSH_Lib.Protocol.Channels.Valid_Command
           ("git-receive-pack 'repo.git'"),
         "phase11 receive command valid");
      Check
        (SSH_Lib.Protocol.Channels.Valid_Command ("echo a && echo b"),
         "phase11 shell metacharacters accepted as remote text");
      Check
        (SSH_Lib.Protocol.Channels.Valid_Command ("command with spaces"),
         "phase11 command with spaces accepted without normalization");
      declare
         Oversized_Command :
           constant String
                      (1
                       ..
                         SSH_Lib.Protocol.Channels.Maximum_Command_Length
                         + 1) := [others => 'a'];
      begin
         Check
           (not SSH_Lib.Protocol.Channels.Valid_Command (Oversized_Command),
            "phase11 oversized command invalid");
      end;

      Work_Item :=
        SSH_Lib.Protocol.Channels.Encode_Channel_Open
          (16#01020304#, 16#00200000#, 16#00008000#);
      declare
         Encoded : constant Ada.Streams.Stream_Element_Array :=
           SSH_Lib.Protocol.Buffers.To_Array (Work_Item);
      begin
         Check
           (Encoded (Encoded'First) = 90,
            "phase11 channel open message number");
         Check
           (Encoded (Encoded'First + 1) = 0
            and then Encoded (Encoded'First + 2) = 0
            and then Encoded (Encoded'First + 3) = 0
            and then Encoded (Encoded'First + 4) = 7,
            "phase11 channel type length encoded");
         Check
           (Encoded (Encoded'First + 5) = Character'Pos ('s')
            and then Encoded (Encoded'First + 6) = Character'Pos ('e')
            and then Encoded (Encoded'First + 7) = Character'Pos ('s')
            and then Encoded (Encoded'First + 8) = Character'Pos ('s')
            and then Encoded (Encoded'First + 9) = Character'Pos ('i')
            and then Encoded (Encoded'First + 10) = Character'Pos ('o')
            and then Encoded (Encoded'First + 11) = Character'Pos ('n'),
            "phase11 channel type is session");
         Check
           (Encoded (Encoded'First + 12) = 1
            and then Encoded (Encoded'First + 13) = 2
            and then Encoded (Encoded'First + 14) = 3
            and then Encoded (Encoded'First + 15) = 4,
            "phase11 channel id big endian");
         Check
           (Encoded (Encoded'First + 16) = 0
            and then Encoded (Encoded'First + 17) = 32
            and then Encoded (Encoded'First + 18) = 0
            and then Encoded (Encoded'First + 19) = 0,
            "phase11 initial window encoded");
         Check
           (Encoded (Encoded'First + 20) = 0
            and then Encoded (Encoded'First + 21) = 0
            and then Encoded (Encoded'First + 22) = 128
            and then Encoded (Encoded'First + 23) = 0,
            "phase11 maximum packet size encoded");
         Check
           (SSH_Lib.Protocol.Buffers.Is_Empty
              (SSH_Lib.Protocol.Channels.Encode_Channel_Open
                 (16#01020304#, 16#00200000#, 0)),
            "phase19 pass352 session open refuses zero local maximum packet size");
         Check
           (SSH_Lib.Protocol.Buffers.Is_Empty
              (SSH_Lib.Protocol.Channels.Encode_Direct_TCPIP_Open
                 (16#01020304#,
                  "target.example",
                  22,
                  "127.0.0.1",
                  0,
                  SSH_Lib.Protocol.Channels.Default_Initial_Window_Size,
                  0)),
            "phase19 pass352 direct-tcpip open refuses zero local maximum packet size");
         declare
            Direct_Item    : constant SSH_Lib.Protocol.Buffers.Packet_Buffer :=
              SSH_Lib.Protocol.Channels.Encode_Direct_TCPIP_Open
                (16#01020304#, "target.example", 22, "127.0.0.1", 0);
            Direct_Encoded : constant Ada.Streams.Stream_Element_Array :=
              SSH_Lib.Protocol.Buffers.To_Array (Direct_Item);
         begin
            Check
              (Direct_Encoded'Length > 30,
               "phase19 pass101 direct-tcpip open is encoded");
            Check
              (Direct_Encoded (Direct_Encoded'First)
               = SSH_Lib.Protocol.Channels.SSH_MSG_CHANNEL_OPEN,
               "phase19 pass101 direct-tcpip uses channel-open message");
            Check
              (Direct_Encoded (Direct_Encoded'First + 1) = 0
               and then Direct_Encoded (Direct_Encoded'First + 2) = 0
               and then Direct_Encoded (Direct_Encoded'First + 3) = 0
               and then Direct_Encoded (Direct_Encoded'First + 4) = 12,
               "phase19 pass101 direct-tcpip type length encoded");
            Check
              (Direct_Encoded (Direct_Encoded'First + 5) = Character'Pos ('d')
               and then
                 Direct_Encoded (Direct_Encoded'First + 6)
                 = Character'Pos ('i')
               and then
                 Direct_Encoded (Direct_Encoded'First + 7)
                 = Character'Pos ('r')
               and then
                 Direct_Encoded (Direct_Encoded'First + 8)
                 = Character'Pos ('e')
               and then
                 Direct_Encoded (Direct_Encoded'First + 9)
                 = Character'Pos ('c')
               and then
                 Direct_Encoded (Direct_Encoded'First + 10)
                 = Character'Pos ('t')
               and then
                 Direct_Encoded (Direct_Encoded'First + 11)
                 = Character'Pos ('-')
               and then
                 Direct_Encoded (Direct_Encoded'First + 12)
                 = Character'Pos ('t')
               and then
                 Direct_Encoded (Direct_Encoded'First + 13)
                 = Character'Pos ('c')
               and then
                 Direct_Encoded (Direct_Encoded'First + 14)
                 = Character'Pos ('p')
               and then
                 Direct_Encoded (Direct_Encoded'First + 15)
                 = Character'Pos ('i')
               and then
                 Direct_Encoded (Direct_Encoded'First + 16)
                 = Character'Pos ('p'),
               "phase19 pass101 direct-tcpip channel type encoded");
            Check
              (Direct_Encoded (Direct_Encoded'First + 17) = 1
               and then Direct_Encoded (Direct_Encoded'First + 18) = 2
               and then Direct_Encoded (Direct_Encoded'First + 19) = 3
               and then Direct_Encoded (Direct_Encoded'First + 20) = 4,
               "phase19 pass101 direct-tcpip sender channel encoded");
         end;
         declare
            Shell_Item    : constant SSH_Lib.Protocol.Buffers.Packet_Buffer :=
              SSH_Lib.Protocol.Channels.Encode_Shell_Request (16#01020304#);
            Shell_Encoded : constant Ada.Streams.Stream_Element_Array :=
              SSH_Lib.Protocol.Buffers.To_Array (Shell_Item);
         begin
            Check
              (Shell_Encoded'Length = 15,
               "phase19 shell request length");
            Check
              (Shell_Encoded (Shell_Encoded'First)
               = SSH_Lib.Protocol.Channels.SSH_MSG_CHANNEL_REQUEST,
               "phase19 shell request uses channel-request message");
            Check
              (Shell_Encoded (Shell_Encoded'First + 1) = 1
               and then Shell_Encoded (Shell_Encoded'First + 2) = 2
               and then Shell_Encoded (Shell_Encoded'First + 3) = 3
               and then Shell_Encoded (Shell_Encoded'First + 4) = 4,
               "phase19 shell request recipient encoded");
            Check
              (Same_Bytes
                 (Shell_Encoded
                    (Shell_Encoded'First + 9 .. Shell_Encoded'First + 13),
                  Bytes_From_String ("shell")),
               "phase19 shell request name encoded");
            Check
              (Shell_Encoded (Shell_Encoded'Last) = 1,
               "phase19 shell request asks for reply");
         end;
         declare
            Env_Item : constant SSH_Lib.Protocol.Buffers.Packet_Buffer :=
              SSH_Lib.Protocol.Channels.Encode_Environment_Request
                (16#01020304#, "LANG", "C");
            Env_Encoded : constant Ada.Streams.Stream_Element_Array :=
              SSH_Lib.Protocol.Buffers.To_Array (Env_Item);
         begin
            Check
              (Env_Encoded'Length = 26,
               "phase19 env request length");
            Check
              (Env_Encoded (Env_Encoded'First)
               = SSH_Lib.Protocol.Channels.SSH_MSG_CHANNEL_REQUEST,
               "phase19 env request uses channel-request message");
            Check
              (Env_Encoded (Env_Encoded'First + 1) = 1
               and then Env_Encoded (Env_Encoded'First + 2) = 2
               and then Env_Encoded (Env_Encoded'First + 3) = 3
               and then Env_Encoded (Env_Encoded'First + 4) = 4,
               "phase19 env request recipient encoded");
            Check
              (Same_Bytes
                 (Env_Encoded
                    (Env_Encoded'First + 9 .. Env_Encoded'First + 11),
                  Bytes_From_String ("env")),
               "phase19 env request name encoded");
            Check
              (Env_Encoded (Env_Encoded'First + 12) = 1,
               "phase19 env request asks for reply");
            Check
              (Same_Bytes
                 (Env_Encoded
                    (Env_Encoded'First + 17 .. Env_Encoded'First + 20),
                  Bytes_From_String ("LANG")),
               "phase19 env variable name encoded");
            Check
              (Env_Encoded (Env_Encoded'Last) = Character'Pos ('C'),
               "phase19 env variable value encoded");
            Check
              (not SSH_Lib.Protocol.Buffers.Is_Empty
                 (SSH_Lib.Protocol.Channels.Encode_Environment_Request
                    (1, "EMPTY", "")),
               "phase19 env request permits empty values");
            Check
              (SSH_Lib.Protocol.Buffers.Is_Empty
                 (SSH_Lib.Protocol.Channels.Encode_Environment_Request
                    (1, "BAD=NAME", "C")),
               "phase19 env request rejects names with equals");
         end;
         declare
            X11_Item : constant SSH_Lib.Protocol.Buffers.Packet_Buffer :=
              SSH_Lib.Protocol.Channels.Encode_X11_Request
                (16#01020304#,
                 True,
                 "MIT-MAGIC-COOKIE-1",
                 "0123456789abcdef",
                 0);
            X11_Encoded : constant Ada.Streams.Stream_Element_Array :=
              SSH_Lib.Protocol.Buffers.To_Array (X11_Item);
         begin
            Check
              (X11_Encoded'Length = 64,
               "phase19 x11 request length");
            Check
              (X11_Encoded (X11_Encoded'First)
               = SSH_Lib.Protocol.Channels.SSH_MSG_CHANNEL_REQUEST,
               "phase19 x11 request uses channel-request message");
            Check
              (X11_Encoded (X11_Encoded'First + 1) = 1
               and then X11_Encoded (X11_Encoded'First + 2) = 2
               and then X11_Encoded (X11_Encoded'First + 3) = 3
               and then X11_Encoded (X11_Encoded'First + 4) = 4,
               "phase19 x11 request recipient encoded");
            Check
              (Same_Bytes
                 (X11_Encoded
                    (X11_Encoded'First + 9 .. X11_Encoded'First + 15),
                  Bytes_From_String ("x11-req")),
               "phase19 x11 request name encoded");
            Check
              (X11_Encoded (X11_Encoded'First + 16) = 1
               and then X11_Encoded (X11_Encoded'First + 17) = 1,
               "phase19 x11 request reply and single flags encoded");
            Check
              (Same_Bytes
                 (X11_Encoded
                    (X11_Encoded'First + 22 .. X11_Encoded'First + 39),
                  Bytes_From_String ("MIT-MAGIC-COOKIE-1")),
               "phase19 x11 auth protocol encoded");
            Check
              (Same_Bytes
                 (X11_Encoded
                    (X11_Encoded'First + 44 .. X11_Encoded'First + 59),
                  Bytes_From_String ("0123456789abcdef")),
               "phase19 x11 auth cookie encoded");
            Check
              (X11_Encoded (X11_Encoded'Last) = 0,
