           SSH_Lib.Sessions.Test_Support.Queue_Exec_Response_For_Test
             (Session_Item,
              Build_Exec_Reply
                (SSH_Lib.Protocol.Channels.SSH_MSG_CHANNEL_SUCCESS, 0));
         Check_Status
           (Status_Value,
            CryptoLib.Errors.Ok,
            "phase19 queue configured subsystem wildcard SendEnv response");
         Status_Value :=
           SSH_Lib.Sessions.Test_Support.Queue_Exec_Response_For_Test
             (Session_Item,
              Build_Exec_Reply
                (SSH_Lib.Protocol.Channels.SSH_MSG_CHANNEL_SUCCESS, 0));
         Check_Status
           (Status_Value,
            CryptoLib.Errors.Ok,
            "phase19 queue configured subsystem request response");
         Status_Value :=
           SSH_Lib.Config_Apply.Open_Configured_Subsystem
             (Session_Item,
              Configured_Options,
              "default-subsystem",
              Channel_Item);
         Check_Status
           (Status_Value,
            CryptoLib.Errors.Ok,
            "phase19 configured subsystem applies env and opens subsystem");
         Check
           (SSH_Lib.Channels.Test_Support.Last_EOF_Payload_For_Test
              (Channel_Item)'Length > 0,
            "phase19 configured subsystem StdinNull sends EOF");
         declare
            Last_Request : constant Ada.Streams.Stream_Element_Array :=
              SSH_Lib.Sessions.Test_Support.Last_Exec_Request_Payload_For_Test
                (Session_Item);
            Subsystem_Bytes : constant Ada.Streams.Stream_Element_Array :=
              Bytes_From_String ("sftp");
         begin
            Check
              (Last_Request'Length >= Subsystem_Bytes'Length
               and then Same_Bytes
                 (Last_Request
                    (Last_Request'Last - Subsystem_Bytes'Length + 1
                     .. Last_Request'Last),
                  Subsystem_Bytes),
               "phase19 configured subsystem uses RemoteCommand subsystem");
         end;
         Status_Value := SSH_Lib.Channels.Close (Channel_Item);
         Check_Status
           (Status_Value,
            CryptoLib.Errors.Ok,
            "phase19 configured subsystem close succeeds");
         Configured_Options.Session_Type := To_Unbounded_String ("none");
         SSH_Lib.Sessions.Test_Support.Mark_Authenticated_Open_For_Test
           (Session_Item);
         Status_Value :=
           SSH_Lib.Config_Apply.Open_Configured_Subsystem
             (Session_Item,
              Configured_Options,
              "default-subsystem",
              Channel_Item);
         Check_Status
           (Status_Value,
            CryptoLib.Errors.Ok,
            "phase19 configured subsystem honors SessionType none");
         Check
           (SSH_Lib.Sessions.Test_Support.Active_Channel_Count_For_Test
              (Session_Item)
            = 0,
            "phase19 configured subsystem SessionType none opens no channel");
         Configured_Options.Session_Type := To_Unbounded_String ("invalid");
         Status_Value :=
           SSH_Lib.Config_Apply.Open_Configured_Subsystem
             (Session_Item,
              Configured_Options,
              "default-subsystem",
              Channel_Item);
         Check_Status
           (Status_Value,
            CryptoLib.Errors.Invalid_Command,
            "phase19 configured subsystem rejects invalid SessionType");
         Configured_Options.Session_Type := Null_Unbounded_String;
         Configured_Options.Remote_Command := Null_Unbounded_String;
         Configured_Options.Request_TTY := To_Unbounded_String ("no");
         SSH_Lib.Sessions.Test_Support.Mark_Authenticated_Open_For_Test
           (Session_Item);
         Status_Value :=
           SSH_Lib.Sessions.Test_Support.Queue_Channel_Open_Response_For_Test
             (Session_Item, Build_Open_Confirmation (0, 232, 4096, 8192));
         Check_Status
           (Status_Value,
            CryptoLib.Errors.Ok,
            "phase19 queue configured shell open response");
         for Index in 1 .. 3 loop
            Status_Value :=
              SSH_Lib.Sessions.Test_Support.Queue_Exec_Response_For_Test
                (Session_Item,
                 Build_Exec_Reply
                   (SSH_Lib.Protocol.Channels.SSH_MSG_CHANNEL_SUCCESS, 0));
            Check_Status
              (Status_Value,
               CryptoLib.Errors.Ok,
               "phase19 queue configured shell env response");
         end loop;
         Status_Value :=
           SSH_Lib.Sessions.Test_Support.Queue_Exec_Response_For_Test
             (Session_Item,
              Build_Exec_Reply
                (SSH_Lib.Protocol.Channels.SSH_MSG_CHANNEL_SUCCESS, 0));
         Check_Status
           (Status_Value,
            CryptoLib.Errors.Ok,
            "phase19 queue configured shell request response");
         Status_Value :=
           SSH_Lib.Config_Apply.Open_Configured_Shell
             (Session_Item,
              Configured_Options,
              Channel_Item);
         Check_Status
           (Status_Value,
            CryptoLib.Errors.Ok,
            "phase19 configured shell applies env and opens shell");
         Check
           (SSH_Lib.Channels.Test_Support.Last_EOF_Payload_For_Test
              (Channel_Item)'Length > 0,
            "phase19 configured shell StdinNull sends EOF");
         declare
            Last_Request : constant Ada.Streams.Stream_Element_Array :=
              SSH_Lib.Sessions.Test_Support.Last_Exec_Request_Payload_For_Test
                (Session_Item);
         begin
            Check
              (Same_Bytes
                 (Last_Request
                    (Last_Request'First + 9 .. Last_Request'First + 13),
                  Bytes_From_String ("shell")),
               "phase19 configured shell RequestTTY no opens shell");
         end;
         Status_Value := SSH_Lib.Channels.Close (Channel_Item);
         Check_Status
           (Status_Value,
            CryptoLib.Errors.Ok,
            "phase19 configured shell close succeeds");
         Configured_Options.Request_TTY := To_Unbounded_String ("force");
         SSH_Lib.Sessions.Test_Support.Mark_Authenticated_Open_For_Test
           (Session_Item);
         Status_Value :=
           SSH_Lib.Sessions.Test_Support.Queue_Channel_Open_Response_For_Test
             (Session_Item, Build_Open_Confirmation (0, 233, 4096, 8192));
         Check_Status
           (Status_Value,
            CryptoLib.Errors.Ok,
            "phase19 queue configured pty shell open response");
         for Index in 1 .. 3 loop
            Status_Value :=
              SSH_Lib.Sessions.Test_Support.Queue_Exec_Response_For_Test
                (Session_Item,
                 Build_Exec_Reply
                   (SSH_Lib.Protocol.Channels.SSH_MSG_CHANNEL_SUCCESS, 0));
            Check_Status
              (Status_Value,
               CryptoLib.Errors.Ok,
               "phase19 queue configured pty shell env response");
         end loop;
         Status_Value :=
           SSH_Lib.Sessions.Test_Support.Queue_Exec_Response_For_Test
             (Session_Item,
              Build_Exec_Reply
                (SSH_Lib.Protocol.Channels.SSH_MSG_CHANNEL_SUCCESS, 0));
         Check_Status
           (Status_Value,
            CryptoLib.Errors.Ok,
            "phase19 queue configured pty request response");
         Status_Value :=
           SSH_Lib.Sessions.Test_Support.Queue_Exec_Response_For_Test
             (Session_Item,
              Build_Exec_Reply
                (SSH_Lib.Protocol.Channels.SSH_MSG_CHANNEL_SUCCESS, 0));
         Check_Status
           (Status_Value,
            CryptoLib.Errors.Ok,
            "phase19 queue configured pty shell request response");
         Status_Value :=
           SSH_Lib.Config_Apply.Open_Configured_Shell
             (Session_Item,
              Configured_Options,
              Channel_Item,
              "xterm-256color",
              120,
              40);
         Check_Status
           (Status_Value,
            CryptoLib.Errors.Ok,
            "phase19 configured shell RequestTTY force opens pty shell");
         declare
            Last_Request : constant Ada.Streams.Stream_Element_Array :=
              SSH_Lib.Sessions.Test_Support.Last_Exec_Request_Payload_For_Test
                (Session_Item);
         begin
            Check
              (Same_Bytes
                 (Last_Request
                    (Last_Request'First + 9 .. Last_Request'First + 13),
                  Bytes_From_String ("shell")),
               "phase19 configured pty shell completes shell request");
         end;
         Status_Value := SSH_Lib.Channels.Close (Channel_Item);
         Check_Status
           (Status_Value,
            CryptoLib.Errors.Ok,
            "phase19 configured pty shell close succeeds");
         Configured_Options.Request_TTY := To_Unbounded_String ("invalid");
         Status_Value :=
           SSH_Lib.Config_Apply.Open_Configured_Shell
             (Session_Item,
              Configured_Options,
              Channel_Item);
         Check_Status
           (Status_Value,
            CryptoLib.Errors.Invalid_Command,
            "phase19 configured shell rejects invalid RequestTTY");
      end;
      SSH_Lib.Platform.Environment.Reset_Provider;

      SSH_Lib.Sessions.Test_Support.Mark_Authenticated_Open_For_Test
        (Session_Item);
      Status_Value :=
        SSH_Lib.Sessions.Test_Support.Queue_Channel_Open_Response_For_Test
          (Session_Item, Build_Open_Confirmation (0, 210, 4096, 8192));
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Ok,
         "phase19 queue exec-with-env rejected open response");
      Status_Value :=
        SSH_Lib.Sessions.Test_Support.Queue_Exec_Response_For_Test
          (Session_Item,
           Build_Exec_Reply
             (SSH_Lib.Protocol.Channels.SSH_MSG_CHANNEL_FAILURE, 0));
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Ok,
         "phase19 queue exec-with-env rejected env response");
      declare
         Environment :
           constant SSH_Lib.Channels.Environment_Variable_Array :=
             [1 =>
                (Name  => To_Unbounded_String ("LANG"),
                 Value => To_Unbounded_String ("C"))];
      begin
         Status_Value :=
           SSH_Lib.Channels.Open_Exec_With_Environment
             (Session_Item,
              "git-upload-pack 'repo.git'",
              Environment,
              Channel_Item);
      end;
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Channel_Request_Failed,
         "phase19 exec-with-env fails when server rejects environment");
      Check
        (SSH_Lib.Sessions.Test_Support.Active_Channel_Count_For_Test
           (Session_Item)
         = 0,
         "phase19 exec-with-env rejected environment releases channel");

      SSH_Lib.Sessions.Test_Support.Mark_Authenticated_Open_For_Test
        (Session_Item);
      Status_Value :=
        SSH_Lib.Sessions.Test_Support.Queue_Channel_Open_Response_For_Test
          (Session_Item, Build_Open_Confirmation (0, 250, 4096, 8192));
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Ok,
         "phase11 queue open for wrong exec reply recipient");
      Status_Value :=
        SSH_Lib.Sessions.Test_Support.Queue_Exec_Response_For_Test
          (Session_Item,
           Build_Exec_Reply
             (SSH_Lib.Protocol.Channels.SSH_MSG_CHANNEL_SUCCESS, 250));
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Ok,
         "phase11 queue wrong exec reply recipient");
      Status_Value :=
        SSH_Lib.Channels.Open_Exec
          (Session_Item, "git-upload-pack 'repo.git'", Channel_Item);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Channel_Request_Failed,
         "phase11 exec reply addressed to server channel rejected");
      Check
        (SSH_Lib.Sessions.Test_Support.Active_Channel_Count_For_Test
           (Session_Item)
         = 0,
         "phase11 wrong exec reply recipient releases channel table entry");

      SSH_Lib.Sessions.Test_Support.Mark_Authenticated_Open_For_Test
        (Session_Item);
      Status_Value :=
        SSH_Lib.Channels.Open_Exec
          (Session_Item, "git-upload-pack 'repo.git'", Channel_Item);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Channel_Open_Failed,
         "phase11 missing open response rejected deterministically");
      Check
        (SSH_Lib.Sessions.Test_Support.Active_Channel_Count_For_Test
           (Session_Item)
         = 0,
         "phase11 missing open response releases channel table entry");

      SSH_Lib.Sessions.Test_Support.Mark_Authenticated_Open_For_Test
        (Session_Item);
      Status_Value :=
        SSH_Lib.Sessions.Test_Support.Queue_Channel_Open_Response_For_Test
          (Session_Item,
           Build_Exec_Reply
             (SSH_Lib.Protocol.Channels.SSH_MSG_CHANNEL_SUCCESS, 0));
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Ok,
         "phase11 queue unexpected open response");
      Status_Value :=
        SSH_Lib.Channels.Open_Exec
          (Session_Item, "git-upload-pack 'repo.git'", Channel_Item);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Channel_Open_Failed,
         "phase11 unexpected open response rejected deterministically");
      Check
        (SSH_Lib.Sessions.Test_Support.Active_Channel_Count_For_Test
           (Session_Item)
         = 0,
         "phase11 unexpected open response releases channel table entry");

      SSH_Lib.Sessions.Test_Support.Mark_Authenticated_Open_For_Test
        (Session_Item);
      Status_Value :=
        SSH_Lib.Sessions.Test_Support.Queue_Channel_Open_Response_For_Test
          (Session_Item, Build_Open_Confirmation (0, 204, 4096, 8192));
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Ok,
         "phase11 queue open without exec response");
      Status_Value :=
        SSH_Lib.Channels.Open_Exec
          (Session_Item, "git-upload-pack 'repo.git'", Channel_Item);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Channel_Request_Failed,
         "phase11 missing exec response rejected deterministically");
      Check
        (SSH_Lib.Sessions.Test_Support.Active_Channel_Count_For_Test
           (Session_Item)
         = 0,
         "phase11 missing exec response releases channel table entry");

      SSH_Lib.Sessions.Test_Support.Mark_Authenticated_Open_For_Test
        (Session_Item);
      Status_Value :=
        SSH_Lib.Sessions.Test_Support.Queue_Channel_Open_Response_For_Test
          (Session_Item, Build_Open_Failure (0));
      Check_Status
        (Status_Value, CryptoLib.Errors.Ok, "phase11 queue open failure");
      Status_Value :=
        SSH_Lib.Channels.Open_Exec
          (Session_Item, "git-upload-pack 'repo.git'", Channel_Item);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Channel_Open_Failed,
         "phase11 server open failure mapped");
      Check
        (SSH_Lib.Sessions.Test_Support.Active_Channel_Count_For_Test
           (Session_Item)
         = 0,
         "phase11 failed open releases channel table entry");

      SSH_Lib.Sessions.Test_Support.Mark_Authenticated_Open_For_Test
        (Session_Item);
      Status_Value :=
        SSH_Lib.Sessions.Test_Support.Queue_Channel_Open_Response_For_Test
          (Session_Item, Build_Open_Confirmation (0, 201, 4096, 8192));
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Ok,
         "phase11 queue open for exec failure");
      Status_Value :=
        SSH_Lib.Sessions.Test_Support.Queue_Exec_Response_For_Test
          (Session_Item,
           Build_Exec_Reply
             (SSH_Lib.Protocol.Channels.SSH_MSG_CHANNEL_FAILURE, 0));
      Check_Status
        (Status_Value, CryptoLib.Errors.Ok, "phase11 queue exec failure");
      Status_Value :=
        SSH_Lib.Channels.Open_Exec
          (Session_Item, "git-upload-pack 'repo.git'", Channel_Item);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Channel_Request_Failed,
         "phase11 exec failure mapped");
      Check
        (SSH_Lib.Sessions.Test_Support.Active_Channel_Count_For_Test
           (Session_Item)
         = 0,
         "phase11 exec failure releases channel table entry");
      Status_Value :=
        SSH_Lib.Channels.Read_Some (Channel_Item, Buffer, Last_Index);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Read_Failed,
         "phase11 failed exec does not expose readable channel handle");
      Status_Value := SSH_Lib.Channels.Write (Channel_Item, Buffer);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Write_Failed,
         "phase11 failed exec does not expose writable channel handle");

      SSH_Lib.Sessions.Test_Support.Mark_Authenticated_Open_For_Test
        (Session_Item);
      SSH_Lib.Sessions.Test_Support.Set_Channel_Open_Timeout_For_Test
        (Session_Item, True);
      Status_Value :=
        SSH_Lib.Channels.Open_Exec
          (Session_Item, "git-upload-pack 'repo.git'", Channel_Item);
      Check_Status
        (Status_Value, CryptoLib.Errors.Timeout, "phase11 open timeout mapped");

      SSH_Lib.Sessions.Test_Support.Mark_Authenticated_Open_For_Test
        (Session_Item);
      SSH_Lib.Sessions.Test_Support.Set_Channel_Limit_For_Test
        (Session_Item, 0);
      Status_Value :=
        SSH_Lib.Channels.Open_Exec
          (Session_Item, "git-upload-pack 'repo.git'", Channel_Item);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Channel_Open_Failed,
         "phase11 channel limit exceeded mapped");

      SSH_Lib.Sessions.Test_Support.Set_Timeouts_For_Test
        (Session_Item,
         Connect_Timeout_MS => 30_000,
         Read_Timeout_MS    => 30_000,
         Write_Timeout_MS   => 30_000);
      SSH_Lib.Sessions.Test_Support.Set_Channel_Exec_Write_Timeout_For_Test
        (Session_Item, False);
      SSH_Lib.Sessions.Test_Support.Mark_Authenticated_Open_For_Test
        (Session_Item);
      SSH_Lib.Sessions.Test_Support.Set_Channel_Write_Failure_For_Test
        (Session_Item, True);
      Status_Value :=
        SSH_Lib.Channels.Open_Exec
          (Session_Item, "git-upload-pack 'repo.git'", Channel_Item);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Write_Failed,
         "phase11 write failure while sending open mapped");

      SSH_Lib.Sessions.Test_Support.Mark_Authenticated_Open_For_Test
        (Session_Item);
      SSH_Lib.Sessions.Test_Support.Set_Channel_Read_Open_Failure_For_Test
        (Session_Item, True);
      Status_Value :=
        SSH_Lib.Channels.Open_Exec
          (Session_Item, "git-upload-pack 'repo.git'", Channel_Item);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Read_Failed,
         "phase11 read failure while waiting open mapped");

      SSH_Lib.Sessions.Test_Support.Mark_Authenticated_Open_For_Test
        (Session_Item);
      Status_Value :=
        SSH_Lib.Sessions.Test_Support.Queue_Channel_Open_Response_For_Test
          (Session_Item, Build_Open_Confirmation (0, 202, 4096, 8192));
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Ok,
         "phase11 queue open for exec read failure");
      SSH_Lib.Sessions.Test_Support.Set_Channel_Read_Exec_Failure_For_Test
        (Session_Item, True);
      Status_Value :=
        SSH_Lib.Channels.Open_Exec
          (Session_Item, "git-upload-pack 'repo.git'", Channel_Item);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Read_Failed,
         "phase11 read failure while waiting exec mapped");

      SSH_Lib.Sessions.Test_Support.Mark_Authenticated_Open_For_Test
        (Session_Item);
      Status_Value :=
        SSH_Lib.Sessions.Test_Support.Queue_Channel_Open_Response_For_Test
          (Session_Item, Build_Open_Confirmation (0, 203, 4096, 8192));
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Ok,
         "phase11 queue open for exec timeout");
      SSH_Lib.Sessions.Test_Support.Set_Channel_Exec_Timeout_For_Test
        (Session_Item, True);
      Status_Value :=
        SSH_Lib.Channels.Open_Exec
          (Session_Item, "git-upload-pack 'repo.git'", Channel_Item);
      Check_Status
        (Status_Value, CryptoLib.Errors.Timeout, "phase11 exec timeout mapped");
   end Run_Phase_11_Channel_Tests;

   procedure Run_Phase_12_Channel_Stream_Tests is
      Channel_Item       : SSH_Lib.Channels.Channel;
      Status_Value       : CryptoLib.Errors.Status;
      Remote_Status_Code : Integer := -1;
      Read_Buffer        : Ada.Streams.Stream_Element_Array (1 .. 3);
      Last_Index         : Ada.Streams.Stream_Element_Offset;
      Binary_Data        :
        constant Ada.Streams.Stream_Element_Array (1 .. 6) :=
          [1 => 16#00#,
           2 => 16#0A#,
           3 => 16#0D#,
           4 => 16#80#,
           5 => 16#FE#,
           6 => 16#FF#];
      First_Part         :
        constant Ada.Streams.Stream_Element_Array (1 .. 3) :=
          [1 => 16#00#, 2 => 16#0A#, 3 => 16#0D#];
      Second_Part        :
        constant Ada.Streams.Stream_Element_Array (1 .. 3) :=
          [1 => 16#80#, 2 => 16#FE#, 3 => 16#FF#];
      Packet_Value       : SSH_Lib.Protocol.Buffers.Packet_Buffer;
   begin
      SSH_Lib.Channels.Test_Support.Mark_Exec_Active_For_Test
        (Channel_Item,
         Local_Channel_Id           => 7,
         Remote_Channel_Id          => 9,
         Remote_Remaining_Window    => 16,
         Remote_Maximum_Packet_Size => 3);

      Packet_Value :=
        SSH_Lib.Protocol.Channels.Encode_Channel_Data (7, Binary_Data);
      Status_Value :=
        SSH_Lib.Channels.Test_Support.Dispatch_Inbound_Payload_For_Test
          (Channel_Item, SSH_Lib.Protocol.Buffers.To_Array (Packet_Value));
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Ok,
         "phase12 dispatch binary channel data");

      Status_Value :=
        SSH_Lib.Channels.Read_Some (Channel_Item, Read_Buffer, Last_Index);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Ok,
         "phase12 read first split binary chunk");
      Check
        (Last_Index = Read_Buffer'Last,
         "phase12 first split chunk fills caller buffer");
      Check
        (Same_Bytes (Read_Buffer, First_Part),
         "phase12 first split chunk preserves NUL/LF/CR");

      Status_Value :=
        SSH_Lib.Channels.Read_Some (Channel_Item, Read_Buffer, Last_Index);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Ok,
         "phase12 read queued second split binary chunk");
      Check
        (Same_Bytes (Read_Buffer, Second_Part),
         "phase12 second split chunk preserves high bytes");

      Packet_Value :=
        SSH_Lib.Protocol.Channels.Encode_Channel_Extended_Data
          (7, SSH_Lib.Protocol.Channels.Extended_Data_Stderr, Binary_Data);
      Status_Value :=
        SSH_Lib.Channels.Test_Support.Dispatch_Inbound_Payload_For_Test
          (Channel_Item, SSH_Lib.Protocol.Buffers.To_Array (Packet_Value));
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Ok,
         "phase12 stderr extended data consumed");
      Status_Value :=
        SSH_Lib.Channels.Read_Some (Channel_Item, Read_Buffer, Last_Index);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Timeout,
         "phase12 stderr does not appear on stdout");

      Status_Value := SSH_Lib.Channels.Write (Channel_Item, Binary_Data);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Ok,
         "phase12 write binary data split by packet size");
      Check
        (SSH_Lib.Channels.Test_Support.Outbound_Data_Byte_Count_For_Test
           (Channel_Item)
         = Binary_Data'Length,
         "phase12 outbound byte count records all split bytes");
      declare
         Payload_Value : constant Ada.Streams.Stream_Element_Array :=
           SSH_Lib.Channels.Test_Support.Last_Channel_Data_Payload_For_Test
             (Channel_Item);
      begin
         Check
           (Payload_Value'Length = 12,
            "phase12 last split channel-data payload has message/id/string/data");
         Check
           (Payload_Value (Payload_Value'First)
            = SSH_Lib.Protocol.Channels.SSH_MSG_CHANNEL_DATA,
            "phase12 last split payload is channel data");
      end;

      Status_Value := SSH_Lib.Channels.Send_EOF (Channel_Item);
      Check_Status (Status_Value, CryptoLib.Errors.Ok, "phase12 send eof ok");
      Status_Value := SSH_Lib.Channels.Send_EOF (Channel_Item);
      Check_Status
        (Status_Value, CryptoLib.Errors.Ok, "phase12 send eof idempotent");
      declare
         Payload_Value : constant Ada.Streams.Stream_Element_Array :=
           SSH_Lib.Channels.Test_Support.Last_EOF_Payload_For_Test
             (Channel_Item);
      begin
         Check
           (Payload_Value'Length = 5
            and then
              Payload_Value (Payload_Value'First)
              = SSH_Lib.Protocol.Channels.SSH_MSG_CHANNEL_EOF,
            "phase12 eof payload encoded");
      end;
      Status_Value := SSH_Lib.Channels.Write (Channel_Item, Binary_Data);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Write_Failed,
         "phase12 write after eof rejected");

      Packet_Value :=
        SSH_Lib.Protocol.Channels.Encode_Exit_Status_Request (7, False, 1);
      Status_Value :=
        SSH_Lib.Channels.Test_Support.Dispatch_Inbound_Payload_For_Test
          (Channel_Item, SSH_Lib.Protocol.Buffers.To_Array (Packet_Value));
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Ok,
         "phase12 exit-status request with RFC false want-reply dispatched");
      Status_Value :=
        SSH_Lib.Channels.Exit_Status (Channel_Item, Remote_Status_Code);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Remote_Exit_Nonzero,
         "phase12 nonzero exit status returned separately");
      Check (Remote_Status_Code = 1, "phase12 exit status code preserved");
      Packet_Value := SSH_Lib.Protocol.Channels.Encode_Channel_EOF (7);
      Status_Value :=
        SSH_Lib.Channels.Test_Support.Dispatch_Inbound_Payload_For_Test
          (Channel_Item, SSH_Lib.Protocol.Buffers.To_Array (Packet_Value));
      Check_Status
        (Status_Value, CryptoLib.Errors.Ok, "phase12 inbound eof dispatched");
      Status_Value :=
        SSH_Lib.Channels.Read_Some (Channel_Item, Read_Buffer, Last_Index);
      Check_Status
        (Status_Value,
