         "phase16 test identity material carries a public fixture disclaimer");
      Check
        (SSH_Lib.Tests.Fixtures.Identity_Files.Contains_Private_Key_Material
           (SSH_Lib
              .Tests
              .Fixtures
              .Identity_Files
              .Malformed_OpenSSH_Private_Key),
