      RSA_Modulus                    :
        constant Stream_Element_Array (1 .. 5) :=
          [1 => 16#00#, 2 => 16#80#, 3 => 16#01#, 4 => 16#02#, 5 => 16#03#];
      RSA_Modulus_With_Padded_Base64 :
        constant Stream_Element_Array (1 .. 6) :=
          [1 => 16#00#,
           2 => 16#80#,
           3 => 16#01#,
           4 => 16#02#,
           5 => 16#03#,
           6 => 16#04#];
      RSA_Zero                       :
        constant Stream_Element_Array (1 .. 1) := [1 => 0];
      RSA_Negative                   :
        constant Stream_Element_Array (1 .. 1) := [1 => 16#80#];
      RSA_Nonminimal_Positive        :
        constant Stream_Element_Array (1 .. 2) := [1 => 16#00#, 2 => 16#01#];
      P384_Public_Blob               : constant Stream_Element_Array :=
        Hex_To_Array
          ("0000001365636473612D736861322D6E69737470333834"
           & "000000086E69737470333834"
           & "00000061"
           & "04"
           & "AA87CA22BE8B05378EB1C71EF320AD746E1D3B628BA79B9859F741E082542A385502F25DBF55296C3A545E3872760AB7"
           & "3617DE4A96262C6F5D9E98BF9292DC29F8F41DBD289A147CE9DA3113B5F0B8C00A60B1CE1D7E819D7A431D7C90EA0E5F");
      P521_Public_Blob               : constant Stream_Element_Array :=
        Hex_To_Array
          ("0000001365636473612D736861322D6E69737470353231"
           & "000000086E69737470353231"
           & "00000085"
           & "04"
           & "00C6858E06B70404E9CD9E3ECB662395B4429C648139053FB521F"
           & "828AF606B4D3DBAA14B5E77EFE75928FE1DC127A2FFA8DE3348B3C"
           & "1856A429BF97E7E31C2E5BD66"
           & "011839296A789A3BC0045C8A5FB42C7D1BD998F54449579B446817"
           & "AFBD17273E662C97EE72995EF42640C550B9013FAD0761353C7086A"
           & "272C24088BE94769FD16650");
      Valid_Blob                     : Packet_Buffer;
      Other_Blob                     : Packet_Buffer;
      Bad_Blob                       : Packet_Buffer;
      Valid_Signature_Blob           : Packet_Buffer;
      Security_Key_Request           : Packet_Buffer;
   begin
      for Index_Value in Good_Key'Range loop
         Good_Key (Index_Value) :=
           Stream_Element ((Integer (Index_Value) * 7) mod 256);
         Other_Key (Index_Value) :=
           Stream_Element ((Integer (Index_Value) * 11) mod 256);
      end loop;
      Good_Key (1) := 16#00#;
      Good_Key (2) := 16#0A#;
      Good_Key (3) := 16#0D#;
      Good_Key (4) := 16#7F#;
      Good_Key (5) := 16#80#;
      Good_Key (6) := 16#FF#;
      for Index_Value in Good_Signature'Range loop
         Good_Signature (Index_Value) :=
           Stream_Element ((Integer (Index_Value) * 13) mod 256);
      end loop;

      Valid_Blob := Host_Key_Blob ("ssh-ed25519", Good_Key);
      Result_Status :=
        SSH_Lib.Protocol.Host_Keys.Parse
          (To_Array (Valid_Blob), "ssh-ed25519", Key_Item);
      Check_Status
        (Result_Status,
         CryptoLib.Errors.Ok,
         "valid ed25519 host key blob parses");
      Check
        (SSH_Lib.Keys.Algorithm (Key_Item) = "ssh-ed25519",
         "public key algorithm recorded");
      Check
        (Same_Bytes
           (SSH_Lib.Keys.Internal.Raw_Blob (Key_Item), To_Array (Valid_Blob)),
         "raw host key blob preserved");
      Result_Status :=
        SSH_Lib.Known_Hosts.From_Public_Key (Key_Item, Known_Host_Item);
      Check_Status
        (Result_Status,
         CryptoLib.Errors.Ok,
         "known-host material exported from parsed key");
      Check
        (SSH_Lib.Known_Hosts.Algorithm (Known_Host_Item) = "ssh-ed25519",
         "known-host material keeps key algorithm");
      Check
        (SSH_Lib.Known_Hosts.Encoded (Known_Host_Item)
         = "AAAAC3NzaC1lZDI1NTE5AAAAIAAKDX+A/zE4P0ZNVFtiaXB3foWMk5qhqK+2vcTL0tng",
         "known-host material encodes exact raw key blob");
      Check
        (SSH_Lib.Known_Hosts.Is_Valid (Known_Host_Item),
         "exported known-host material is valid");
      Known_Host_Second :=
        SSH_Lib.Known_Hosts.Create_Host_Key
          ("ssh-ed25519",
           "AAAAC3NzaC1lZDI1NTE5AAAAIAAKDX+A/zE4P0ZNVFtiaXB3foWMk5qhqK+2vcTL0tng");
      Check
        (SSH_Lib.Known_Hosts.Equal (Known_Host_Item, Known_Host_Second),
         "same known-host material compares equal");
      Check
        (not SSH_Lib.Known_Hosts.Equal (Known_Host_Item, Known_Host_Empty),
         "empty known-host material does not compare trusted");

      Known_Host_Second :=
        SSH_Lib.Known_Hosts.Create_Host_Key ("ssh-ed25519", "AAAA");
      Check
        (not SSH_Lib.Known_Hosts.Is_Valid (Known_Host_Second),
         "known-host constructor rejects base64 that is not an SSH key blob");
      Check
        (SSH_Lib.Known_Hosts.Algorithm (Known_Host_Second) = ""
         and then SSH_Lib.Known_Hosts.Encoded (Known_Host_Second) = "",
         "known-host constructor clears syntactically valid malformed blobs");

      Known_Host_Second :=
        SSH_Lib.Known_Hosts.Create_Host_Key
          ("ssh-rsa", SSH_Lib.Known_Hosts.Encoded (Known_Host_Item));
      Check
        (not SSH_Lib.Known_Hosts.Is_Valid (Known_Host_Second),
         "known-host constructor rejects decoded key algorithm mismatch");
      SSH_Lib.Protocol.Encrypted_State.Reset (State_Item);
      Result_Status :=
        SSH_Lib.Protocol.Encrypted_State.Store_Verified_Host_Key
          (State_Item, Key_Item);
      Check_Status
        (Result_Status, CryptoLib.Errors.Ok, "verified host key stored");
      Check
        (SSH_Lib.Protocol.Encrypted_State.Has_Verified_Host_Key (State_Item),
         "verified host key flag set");
      Check
        (SSH_Lib.Keys.Algorithm
           (SSH_Lib.Protocol.Encrypted_State.Verified_Host_Key (State_Item))
         = "ssh-ed25519",
         "verified host key available for known hosts");

      Result_Status :=
        SSH_Lib.Keys.SHA256_Fingerprint (Key_Item, Fingerprint_A);
      Check_Status (Result_Status, CryptoLib.Errors.Ok, "fingerprint status");
      Check
        (SSH_Lib.Keys.Image (Fingerprint_A)'Length > 7
         and then SSH_Lib.Keys.Image (Fingerprint_A) (1 .. 7) = "SHA256:",
         "fingerprint prefix");
      Check
        (SSH_Lib.Keys.Image (Fingerprint_A)
           (SSH_Lib.Keys.Image (Fingerprint_A)'Last)
         /= '=',
         "fingerprint omits padding");
      Check
        (SSH_Lib.Keys.Image (Fingerprint_A)
         = "SHA256:nNhTJzRSh2u00NJYpP6u43hJLhpfeWewTGqfPV3NRPs",
         "fingerprint exact raw blob vector");
      Result_Status :=
        SSH_Lib.Keys.MD5_Fingerprint (Key_Item, Fingerprint_B);
      Check_Status
        (Result_Status, CryptoLib.Errors.Ok, "md5 fingerprint status");
      Check
        (SSH_Lib.Keys.Image (Fingerprint_B)'Length = 51
         and then SSH_Lib.Keys.Image (Fingerprint_B) (1 .. 4) = "MD5:",
         "md5 fingerprint uses OpenSSH prefix and length");
      Check
        (SSH_Lib.Keys.Image (Fingerprint_B) (7) = ':'
         and then SSH_Lib.Keys.Image (Fingerprint_B) (10) = ':'
         and then SSH_Lib.Keys.Image (Fingerprint_B) (49) = ':',
         "md5 fingerprint is colon separated");
      Result_Status :=
        SSH_Lib.Keys.Fingerprint_With_Hash
          (Key_Item, "md5", Fingerprint_B);
      Check_Status
        (Result_Status,
         CryptoLib.Errors.Ok,
         "hash-selected md5 fingerprint status");
      Result_Status :=
        SSH_Lib.Keys.Fingerprint_With_Hash
          (Key_Item, "bad-hash", Fingerprint_B);
      Check_Status
        (Result_Status,
         CryptoLib.Errors.Invalid_Command,
         "invalid fingerprint hash is rejected");
      Result_Status :=
        SSH_Lib.Known_Hosts.SHA256_Fingerprint
          (Known_Host_Item, Fingerprint_B);
      Check_Status
        (Result_Status, CryptoLib.Errors.Ok, "known-host fingerprint status");
      Check
        (SSH_Lib.Keys.Image (Fingerprint_B)
         = SSH_Lib.Keys.Image (Fingerprint_A),
         "known-host fingerprint matches parsed public key fingerprint");
      Check
        (SSH_Lib.Keys.Equal (Fingerprint_A, Fingerprint_B),
         "known-host fingerprint equals parsed-key fingerprint");
      Result_Status :=
        SSH_Lib.Known_Hosts.SHA256_Fingerprint
          (Known_Host_Second, Fingerprint_B);
      Check_Status
        (Result_Status,
         CryptoLib.Errors.Handshake_Failed,
         "invalid known-host material has no fingerprint");
      Check
        (SSH_Lib.Keys.Image (Fingerprint_B) = "",
         "invalid known-host fingerprint clears previous image");
      Result_Status :=
        SSH_Lib.Keys.SHA256_Fingerprint (Key_Item, Fingerprint_B);
      Check_Status
        (Result_Status, CryptoLib.Errors.Ok, "same fingerprint status");
      Check
        (SSH_Lib.Keys.Image (Fingerprint_A)
         = SSH_Lib.Keys.Image (Fingerprint_B),
         "same key same fingerprint");
      Check
        (SSH_Lib.Keys.Equal (Fingerprint_A, Fingerprint_B),
         "same fingerprint equal through constant-time helper");
      Check
        (not SSH_Lib.Keys.Equal (Fingerprint_A, Fingerprint_Empty),
         "empty fingerprint does not compare equal");

      Other_Blob := Host_Key_Blob ("ssh-ed25519", Other_Key);
      Result_Status :=
        SSH_Lib.Protocol.Host_Keys.Parse
          (To_Array (Other_Blob), "ssh-ed25519", Key_Item);
      Check_Status
        (Result_Status, CryptoLib.Errors.Ok, "other ed25519 host key parses");
      Result_Status :=
        SSH_Lib.Keys.SHA256_Fingerprint (Key_Item, Fingerprint_B);
      Check_Status
        (Result_Status, CryptoLib.Errors.Ok, "other fingerprint status");
      Check
        (SSH_Lib.Keys.Image (Fingerprint_A)
         /= SSH_Lib.Keys.Image (Fingerprint_B),
         "different key different fingerprint");
      Check
        (not SSH_Lib.Keys.Equal (Fingerprint_A, Fingerprint_B),
         "different fingerprints not equal through constant-time helper");

      Bad_Blob := Host_Key_Blob ("rsa-sha2-256", Good_Key);
      Result_Status :=
        SSH_Lib.Protocol.Host_Keys.Parse
          (To_Array (Bad_Blob), "ssh-ed25519", Key_Item);
      Check_Status
        (Result_Status,
         CryptoLib.Errors.Unsupported_Feature,
         "unsupported public key algorithm rejected");
      Check
        (not SSH_Lib.Keys.Is_Valid (Key_Item),
         "failed host key parse clears previous key");

      Bad_Blob := Host_Key_Blob ("ssh-ed25519", Short_Key);
      Result_Status :=
        SSH_Lib.Protocol.Host_Keys.Parse
          (To_Array (Bad_Blob), "ssh-ed25519", Key_Item);
      Check_Status
        (Result_Status,
         CryptoLib.Errors.Handshake_Failed,
         "short ed25519 key rejected");
      Check
        (not SSH_Lib.Keys.Is_Valid (Key_Item),
         "short ed25519 key leaves no parsed key");

      Bad_Blob := Host_Key_Blob ("ssh-ed25519", Long_Key);
      Result_Status :=
        SSH_Lib.Protocol.Host_Keys.Parse
          (To_Array (Bad_Blob), "ssh-ed25519", Key_Item);
      Touch (Key_Item);
      Check_Status
        (Result_Status,
         CryptoLib.Errors.Handshake_Failed,
         "long ed25519 key rejected");

      Result_Status :=
        SSH_Lib.Protocol.Host_Keys.Parse
          (To_Array (Valid_Blob)
             (1
              .. Ada.Streams.Stream_Element_Offset (Length (Valid_Blob) - 1)),
           "ssh-ed25519",
           Key_Item);
      Touch (Key_Item);
      Check_Status
        (Result_Status,
         CryptoLib.Errors.Handshake_Failed,
         "truncated host key rejected");

      declare
         Truncated_Algorithm : Stream_Element_Array (1 .. 3);
      begin
         Truncated_Algorithm := [1 => 0, 2 => 0, 3 => 0];
         Result_Status :=
           SSH_Lib.Protocol.Host_Keys.Parse
             (Truncated_Algorithm, "ssh-ed25519", Key_Item);
         Check_Status
           (Result_Status,
            CryptoLib.Errors.Handshake_Failed,
            "truncated host key algorithm string rejected");
      end;

      declare
         Empty_Algorithm_Blob : Packet_Buffer;
      begin
         Clear (Empty_Algorithm_Blob);
         Result_Status :=
           Append (Empty_Algorithm_Blob, To_Array (SSH_String (Empty_Data)));
         Check_Status
           (Result_Status,
            CryptoLib.Errors.Ok,
            "empty host key algorithm fixture append");
         Result_Status :=
           SSH_Lib.Protocol.Host_Keys.Parse
             (To_Array (Empty_Algorithm_Blob), "ssh-ed25519", Key_Item);
         Touch (Key_Item);
         Check_Status
           (Result_Status,
            CryptoLib.Errors.Handshake_Failed,
            "empty host key algorithm rejected");
      end;

      declare
         Extra_Blob :
           Stream_Element_Array
             (1
              .. Ada.Streams.Stream_Element_Offset (Length (Valid_Blob) + 1));
      begin
         Extra_Blob
           (1 .. Ada.Streams.Stream_Element_Offset (Length (Valid_Blob))) :=
           To_Array (Valid_Blob);
         Extra_Blob (Extra_Blob'Last) := 0;
         Result_Status :=
           SSH_Lib.Protocol.Host_Keys.Parse
             (Extra_Blob, "ssh-ed25519", Key_Item);
         Touch (Key_Item);
         Check_Status
           (Result_Status,
            CryptoLib.Errors.Handshake_Failed,
            "trailing host key bytes rejected");
      end;

      SSH_Lib.Keys.Internal.Clear (Key_Item);
      Result_Status :=
        SSH_Lib.Keys.SHA256_Fingerprint (Key_Item, Fingerprint_B);
      Check_Status
        (Result_Status,
         CryptoLib.Errors.Handshake_Failed,
         "malformed absent key has no successful fingerprint");
      Check
        (SSH_Lib.Keys.Image (Fingerprint_B) = "",
         "failed fingerprint computation clears previous image");
      Result_Status :=
        SSH_Lib.Known_Hosts.From_Public_Key (Key_Item, Known_Host_Item);
      Check_Status
        (Result_Status,
         CryptoLib.Errors.Handshake_Failed,
         "absent key cannot export known-host material");
      Check
        (SSH_Lib.Known_Hosts.Algorithm (Known_Host_Item) = ""
         and then SSH_Lib.Known_Hosts.Encoded (Known_Host_Item) = "",
         "failed known-host export clears previous material");
      Check
        (not SSH_Lib.Known_Hosts.Is_Valid (Known_Host_Item),
         "failed known-host export is invalid material");

      Bad_Blob := RSA_Host_Key_Blob (RSA_Exponent, RSA_Modulus);
      Result_Status :=
        SSH_Lib.Protocol.Host_Keys.Parse
          (To_Array (Bad_Blob), "rsa-sha2-256", Key_Item);
      Check_Status
        (Result_Status,
         CryptoLib.Errors.Ok,
         "valid rsa host key blob parses for rsa-sha2-256");
      Check
        (SSH_Lib.Keys.Algorithm (Key_Item) = "ssh-rsa",
         "rsa public key format recorded separately from rsa-sha2 signature algorithm");

      Bad_Blob :=
        RSA_Host_Key_Blob (RSA_Exponent, RSA_Modulus_With_Padded_Base64);
      Result_Status :=
        SSH_Lib.Protocol.Host_Keys.Parse
          (To_Array (Bad_Blob), "rsa-sha2-512", Key_Item);
      Check_Status
        (Result_Status,
         CryptoLib.Errors.Ok,
         "valid rsa host key blob parses for padded known-host encoding");
      Result_Status :=
        SSH_Lib.Known_Hosts.From_Public_Key (Key_Item, Known_Host_Item);
      Check_Status
        (Result_Status,
         CryptoLib.Errors.Ok,
         "rsa known-host material exported from parsed key");
      Check
        (SSH_Lib.Known_Hosts.Algorithm (Known_Host_Item) = "ssh-rsa",
         "rsa known-host material uses key format algorithm");
      Check
        (SSH_Lib.Known_Hosts.Encoded (Known_Host_Item)
         = "AAAAB3NzaC1yc2EAAAADAQABAAAABgCAAQIDBA==",
         "rsa known-host material keeps base64 padding");
      Result_Status :=
        SSH_Lib.Known_Hosts.SHA256_Fingerprint
          (Known_Host_Item, Fingerprint_B);
      Check_Status
        (Result_Status,
         CryptoLib.Errors.Ok,
         "rsa known-host fingerprint status");
      Check
        (SSH_Lib.Keys.Image (Fingerprint_B)'Length > 7
         and then SSH_Lib.Keys.Image (Fingerprint_B) (1 .. 7) = "SHA256:",
         "rsa known-host fingerprint prefix");
      Check
        (SSH_Lib.Keys.Image (Fingerprint_B)
           (SSH_Lib.Keys.Image (Fingerprint_B)'Last)
         /= '=',
         "rsa known-host fingerprint omits padding");

      Result_Status :=
        SSH_Lib.Protocol.Host_Keys.Parse
          (P384_Public_Blob, "ecdsa-sha2-nistp384", Key_Item);
      Check_Status
        (Result_Status,
         CryptoLib.Errors.Ok,
         "valid ecdsa p384 host key blob parses");
      Result_Status :=
        SSH_Lib.Known_Hosts.From_Public_Key (Key_Item, Known_Host_Second);
      Check_Status
        (Result_Status,
         CryptoLib.Errors.Ok,
         "ecdsa p384 known-host material exported from parsed key");
      Check
        (SSH_Lib.Known_Hosts.Algorithm (Known_Host_Second)
         = "ecdsa-sha2-nistp384",
         "ecdsa p384 known-host material keeps key algorithm");
      Check
        (SSH_Lib.Known_Hosts.Is_Valid (Known_Host_Second),
         "ecdsa p384 known-host material is valid");

      Result_Status :=
        SSH_Lib.Protocol.Host_Keys.Parse
          (P521_Public_Blob, "ecdsa-sha2-nistp521", Key_Item);
      Check_Status
        (Result_Status,
         CryptoLib.Errors.Ok,
         "valid ecdsa p521 host key blob parses");
      Result_Status :=
        SSH_Lib.Known_Hosts.From_Public_Key (Key_Item, Known_Host_Second);
      Check_Status
        (Result_Status,
         CryptoLib.Errors.Ok,
         "ecdsa p521 known-host material exported from parsed key");
      Check
        (SSH_Lib.Known_Hosts.Algorithm (Known_Host_Second)
         = "ecdsa-sha2-nistp521",
         "ecdsa p521 known-host material keeps key algorithm");
      Check
        (SSH_Lib.Known_Hosts.Is_Valid (Known_Host_Second),
         "ecdsa p521 known-host material is valid");

      Known_Host_Second :=
        SSH_Lib.Known_Hosts.Create_Host_Key
          ("ssh-ed25519", SSH_Lib.Known_Hosts.Encoded (Known_Host_Item));
      Check
        (not SSH_Lib.Known_Hosts.Is_Valid (Known_Host_Second),
         "known-host constructor rejects rsa blob under ed25519 label");
      Known_Host_Second :=
        SSH_Lib.Known_Hosts.Create_Host_Key
          ("rsa-sha2-512", SSH_Lib.Known_Hosts.Encoded (Known_Host_Item));
      Check
        (not SSH_Lib.Known_Hosts.Equal (Known_Host_Item, Known_Host_Second),
         "known-host equality includes key algorithm");
      Known_Host_Second :=
        SSH_Lib.Known_Hosts.Create_Host_Key
          ("ssh-rsa", "AAAAB3NzaC1yc2EAAAADAQABAAAABgCAAQIDBQ==");
      Check
        (not SSH_Lib.Known_Hosts.Equal (Known_Host_Item, Known_Host_Second),
         "known-host equality includes raw key bytes");

      Known_Host_Second :=
        SSH_Lib.Known_Hosts.Create_Host_Key
          ("rsa-sha2-512", SSH_Lib.Known_Hosts.Encoded (Known_Host_Item));
      Check
        (not SSH_Lib.Known_Hosts.Is_Valid (Known_Host_Second),
         "known-host constructor rejects signature algorithm as key format");
      Check
        (SSH_Lib.Known_Hosts.Algorithm (Known_Host_Second) = ""
         and then SSH_Lib.Known_Hosts.Encoded (Known_Host_Second) = "",
         "invalid known-host constructor output is cleared");

      Known_Host_Second :=
        SSH_Lib.Known_Hosts.Create_Host_Key
          ("ssh-rsa", "AAAAB3NzaC1yc2EAAAADAQABAAAABgCAAQIDB@");
      Check
        (not SSH_Lib.Known_Hosts.Is_Valid (Known_Host_Second),
         "known-host constructor rejects non-base64 characters");

      Known_Host_Second :=
        SSH_Lib.Known_Hosts.Create_Host_Key
          ("ssh-rsa", "AAA=AB3NzaC1yc2EAAAADAQABAAAABgCAAQIDBA==");
      Check
        (not SSH_Lib.Known_Hosts.Is_Valid (Known_Host_Second),
         "known-host constructor rejects misplaced base64 padding");

      Known_Host_Second :=
        SSH_Lib.Known_Hosts.Create_Host_Key ("ssh-rsa", "AAA");
      Check
        (not SSH_Lib.Known_Hosts.Is_Valid (Known_Host_Second),
         "known-host constructor rejects non-canonical base64 length");

      Known_Host_Second :=
        SSH_Lib.Known_Hosts.Create_Host_Key
          ("ssh-rsa", "AAAAB3NzaC1yc2EAAAADAQABAAAABgCAAQIDBB==");
      Check
        (not SSH_Lib.Known_Hosts.Is_Valid (Known_Host_Second),
         "known-host constructor rejects non-canonical base64 pad bits");
      Check
        (SSH_Lib.Known_Hosts.Algorithm (Known_Host_Second) = ""
         and then SSH_Lib.Known_Hosts.Encoded (Known_Host_Second) = "",
         "non-canonical base64 known-host output is cleared");

      Result_Status :=
        SSH_Lib.Protocol.Host_Keys.Parse
          (To_Array (Bad_Blob), "ssh-rsa", Key_Item);
      Check_Status
        (Result_Status,
         CryptoLib.Errors.Ok,
         "ssh-rsa key blob accepted for last-resort sha1 host key algorithm");

      Bad_Blob := RSA_Host_Key_Blob (RSA_Zero, RSA_Modulus);
      Result_Status :=
        SSH_Lib.Protocol.Host_Keys.Parse
          (To_Array (Bad_Blob), "rsa-sha2-256", Key_Item);
      Check_Status
        (Result_Status,
         CryptoLib.Errors.Handshake_Failed,
         "zero rsa exponent rejected");

      Bad_Blob := RSA_Host_Key_Blob (RSA_Exponent, RSA_Zero);
      Result_Status :=
        SSH_Lib.Protocol.Host_Keys.Parse
          (To_Array (Bad_Blob), "rsa-sha2-256", Key_Item);
      Check_Status
        (Result_Status,
         CryptoLib.Errors.Handshake_Failed,
         "zero rsa modulus rejected");

      Bad_Blob := RSA_Host_Key_Blob (RSA_Negative, RSA_Modulus);
      Result_Status :=
        SSH_Lib.Protocol.Host_Keys.Parse
          (To_Array (Bad_Blob), "rsa-sha2-256", Key_Item);
      Check_Status
        (Result_Status,
         CryptoLib.Errors.Handshake_Failed,
         "negative rsa exponent rejected");

      Bad_Blob := RSA_Host_Key_Blob (RSA_Exponent, RSA_Negative);
      Result_Status :=
        SSH_Lib.Protocol.Host_Keys.Parse
          (To_Array (Bad_Blob), "rsa-sha2-256", Key_Item);
      Check_Status
        (Result_Status,
         CryptoLib.Errors.Handshake_Failed,
         "negative rsa modulus rejected");

      Bad_Blob := RSA_Host_Key_Blob (RSA_Nonminimal_Positive, RSA_Modulus);
      Result_Status :=
        SSH_Lib.Protocol.Host_Keys.Parse
          (To_Array (Bad_Blob), "rsa-sha2-256", Key_Item);
      Check_Status
        (Result_Status,
         CryptoLib.Errors.Handshake_Failed,
         "nonminimal rsa exponent rejected");

      declare
         Oversized_Modulus : Stream_Element_Array (1 .. 1026) :=
           [others => 16#55#];
      begin
         Oversized_Modulus (1) := 0;
         Bad_Blob := RSA_Host_Key_Blob (RSA_Exponent, Oversized_Modulus);
         Result_Status :=
           SSH_Lib.Protocol.Host_Keys.Parse
             (To_Array (Bad_Blob), "rsa-sha2-256", Key_Item);
         Check_Status
           (Result_Status,
            CryptoLib.Errors.Handshake_Failed,
            "oversized rsa modulus rejected");
      end;

      Valid_Signature_Blob := Signature_Blob ("ssh-ed25519", Good_Signature);
      Result_Status :=
        SSH_Lib.Security_Keys.Build_Signed_Request
          (null,
           "ssh:",
           Binary_Message,
           "git",
           "sk-ssh-ed25519@openssh.com",
           To_Array (Valid_Blob),
           Security_Key_Request);
      Check_Status
        (Result_Status,
         CryptoLib.Errors.Invalid_Command,
         "direct security-key request rejects missing signer");
      Result_Status :=
        SSH_Lib.Security_Keys.Build_Signed_Request
          (Fake_Security_Key_Signer'Unrestricted_Access,
           "ssh:",
           Binary_Message,
           "git",
           "sk-ssh-ed25519@openssh.com",
           To_Array (Valid_Blob),
           Security_Key_Request);
      Check_Status
        (Result_Status,
         CryptoLib.Errors.Ok,
         "direct security-key request uses caller signer");
      Check
        (Length (Security_Key_Request) > 0,
         "direct security-key request is encoded");
      Result_Status :=
        SSH_Lib.Protocol.Signatures.Parse
          (To_Array (Valid_Signature_Blob), "ssh-ed25519", Signature_Item);
      Check_Status
        (Result_Status,
         CryptoLib.Errors.Ok,
         "valid ed25519 signature blob parses");
      Check
        (SSH_Lib.Protocol.Signatures.Algorithm (Signature_Item)
         = "ssh-ed25519",
         "signature algorithm recorded");
      Check
        (Same_Bytes
           (SSH_Lib.Protocol.Signatures.Bytes (Signature_Item),
            Good_Signature),
         "signature bytes preserved");

      Result_Status :=
        SSH_Lib.Protocol.Signatures.Parse
          (To_Array (Signature_Blob ("rsa-sha2-256", Good_Signature)),
           "ssh-ed25519",
           Signature_Item);
      Check_Status
        (Result_Status,
         CryptoLib.Errors.Handshake_Failed,
         "wrong signature algorithm rejected");
      Check
        (SSH_Lib.Protocol.Signatures.Algorithm (Signature_Item) = "",
         "failed signature parse clears previous algorithm");
      Check
        (SSH_Lib.Protocol.Signatures.Bytes (Signature_Item)'Length = 0,
         "failed signature parse clears previous bytes");

      Result_Status :=
        SSH_Lib.Protocol.Signatures.Parse
          (To_Array (Signature_Blob ("ssh-ed25519", Short_Signature)),
           "ssh-ed25519",
           Signature_Item);
      Check_Status
        (Result_Status,
         CryptoLib.Errors.Handshake_Failed,
         "short signature rejected");

      Result_Status :=
        SSH_Lib.Protocol.Signatures.Parse
          (To_Array (Signature_Blob ("ssh-ed25519", Long_Signature)),
           "ssh-ed25519",
           Signature_Item);
      Touch (Signature_Item);
      Check_Status
        (Result_Status,
         CryptoLib.Errors.Handshake_Failed,
         "long signature rejected");

      declare
         Truncated_Signature_Algorithm : Stream_Element_Array (1 .. 3);
      begin
         Truncated_Signature_Algorithm := [1 => 0, 2 => 0, 3 => 0];
         Result_Status :=
           SSH_Lib.Protocol.Signatures.Parse
             (Truncated_Signature_Algorithm, "ssh-ed25519", Signature_Item);
         Touch (Signature_Item);
         Check_Status
           (Result_Status,
            CryptoLib.Errors.Handshake_Failed,
            "truncated signature algorithm string rejected");
      end;

      declare
         Extra_Signature_Blob :
           Stream_Element_Array
             (1
              ..
                Ada.Streams.Stream_Element_Offset
                  (Length (Valid_Signature_Blob) + 1));
      begin
         Extra_Signature_Blob
           (1
            ..
              Ada.Streams.Stream_Element_Offset
                (Length (Valid_Signature_Blob))) :=
           To_Array (Valid_Signature_Blob);
         Extra_Signature_Blob (Extra_Signature_Blob'Last) := 0;
         Result_Status :=
           SSH_Lib.Protocol.Signatures.Parse
             (Extra_Signature_Blob, "ssh-ed25519", Signature_Item);
         Touch (Signature_Item);
         Check_Status
           (Result_Status,
            CryptoLib.Errors.Handshake_Failed,
            "trailing signature bytes rejected");
      end;

      Result_Status :=
        SSH_Lib.Protocol.Host_Keys.Parse
          (To_Array (Valid_Blob), "ssh-ed25519", Key_Item);
      Check_Status
        (Result_Status,
         CryptoLib.Errors.Ok,
         "valid ed25519 host key reparses for verifier gate");
      Result_Status :=
        SSH_Lib.Protocol.Signatures.Parse
          (To_Array (Valid_Signature_Blob), "ssh-ed25519", Signature_Item);
      Check_Status
        (Result_Status,
         CryptoLib.Errors.Ok,
         "valid ed25519 signature reparses for verifier gate");

      Result_Status :=
        SSH_Lib.Protocol.Signatures.Verify
          ("ssh-ed25519", Key_Item, Signature_Item, Binary_Message);
      Check_Status
        (Result_Status,
         CryptoLib.Errors.Handshake_Failed,
         "real ed25519 verification rejects mismatched signature data");

      Valid_Blob := Host_Key_Blob ("ssh-ed25519", RFC8032_Public_Key);
      Valid_Signature_Blob :=
        Signature_Blob ("ssh-ed25519", RFC8032_Signature);
      Result_Status :=
        SSH_Lib.Protocol.Host_Keys.Parse
          (To_Array (Valid_Blob), "ssh-ed25519", Key_Item);
      Check_Status
        (Result_Status,
         CryptoLib.Errors.Ok,
         "RFC8032 ed25519 public key parses for verifier vector");
      Result_Status :=
        SSH_Lib.Protocol.Signatures.Parse
          (To_Array (Valid_Signature_Blob), "ssh-ed25519", Signature_Item);
      Check_Status
        (Result_Status,
         CryptoLib.Errors.Ok,
         "RFC8032 ed25519 signature parses for verifier vector");
      Result_Status :=
        SSH_Lib.Protocol.Signatures.Verify
          ("ssh-ed25519", Key_Item, Signature_Item, Empty_Data);
      Check_Status
        (Result_Status,
         CryptoLib.Errors.Ok,
         "RFC8032 ed25519 full verification succeeds");

      declare
         Tampered_Signature : Stream_Element_Array := RFC8032_Signature;
      begin
         Tampered_Signature (Tampered_Signature'Last) :=
           Tampered_Signature (Tampered_Signature'Last) xor 16#01#;
         Result_Status :=
           SSH_Lib.Signatures.Verify
             ("ssh-ed25519",
              To_Array (Valid_Blob),
              Tampered_Signature,
              Empty_Data);
         Check_Status
           (Result_Status,
            CryptoLib.Errors.Handshake_Failed,
            "ed25519 verifier rejects tampered signature");
      end;

      Result_Status :=
        SSH_Lib.Signatures.Verify
          ("ssh-ed25519",
           To_Array (Host_Key_Blob ("ssh-ed25519", Short_Key)),
           Good_Signature,
           Binary_Message);
      Check_Status
        (Result_Status,
         CryptoLib.Errors.Handshake_Failed,
         "crypto verifier rejects malformed ed25519 key blob");

      Result_Status :=
        SSH_Lib.Signatures.Verify
          ("ssh-ed25519",
           To_Array (Valid_Blob),
           Short_Signature,
           Binary_Message);
      Check_Status
        (Result_Status,
         CryptoLib.Errors.Handshake_Failed,
         "crypto verifier rejects malformed ed25519 signature length");

      Result_Status :=
        SSH_Lib.Signatures.Verify
          ("ssh-rsa", To_Array (Bad_Blob), Good_Signature, Binary_Message);
      Check_Status
        (Result_Status,
         CryptoLib.Errors.Handshake_Failed,
         "crypto verifier checks ssh-rsa sha1 signatures and rejects mismatches");

      Result_Status :=
        SSH_Lib.Signatures.Verify
          ("rsa-sha2-256",
           To_Array (RSA_Host_Key_Blob (RSA_Exponent, RSA_Modulus)),
           Good_Signature,
           Binary_Message);
      Check_Status
        (Result_Status,
         CryptoLib.Errors.Handshake_Failed,
         "rsa verifier rejects mismatched SHA-256 signature");

      Result_Status :=
        SSH_Lib.Signatures.Verify
          ("rsa-sha2-512",
           To_Array (RSA_Host_Key_Blob (RSA_Exponent, RSA_Modulus)),
           Empty_Signature,
           Binary_Message);
      Check_Status
        (Result_Status,
         CryptoLib.Errors.Handshake_Failed,
         "rsa verifier rejects empty signature before unsupported gate");

      Result_Status :=
        SSH_Lib.Signatures.Verify
          ("rsa-sha2-256",
           To_Array (RSA_Host_Key_Blob (RSA_Zero, RSA_Modulus)),
           Good_Signature,
           Binary_Message);
      Check_Status
        (Result_Status,
         CryptoLib.Errors.Handshake_Failed,
         "rsa verifier rejects malformed rsa key before unsupported gate");

      Result_Status :=
        SSH_Lib.Signatures.Verify
          ("rsa-sha2-256",
           To_Array (Valid_Blob),
           Good_Signature,
           Binary_Message);
      Check_Status
        (Result_Status,
         CryptoLib.Errors.Handshake_Failed,
         "rsa verifier rejects non-rsa host key blob before unsupported gate");

      Result_Status :=
        SSH_Lib.Protocol.Signatures.Parse
          (To_Array (Signature_Blob ("rsa-sha2-256", Good_Signature)),
           "rsa-sha2-256",
           Signature_Item);
      Check_Status
        (Result_Status,
         CryptoLib.Errors.Ok,
         "rsa-sha2-256 signature blob parses");

      Result_Status :=
        SSH_Lib.Protocol.Signatures.Parse
          (To_Array (Signature_Blob ("rsa-sha2-512", Good_Signature)),
           "rsa-sha2-512",
           Signature_Item);
      Check_Status
        (Result_Status,
         CryptoLib.Errors.Ok,
         "rsa-sha2-512 signature blob parses");

      Result_Status :=
        SSH_Lib.Protocol.Signatures.Parse
          (To_Array (Signature_Blob ("rsa-sha2-256", Empty_Signature)),
           "rsa-sha2-256",
           Signature_Item);
      Check_Status
        (Result_Status,
         CryptoLib.Errors.Handshake_Failed,
         "empty rsa signature rejected");

      Result_Status :=
        SSH_Lib.Protocol.Signatures.Parse
          (To_Array (Signature_Blob ("rsa-sha2-512", Good_Signature)),
           "rsa-sha2-256",
           Signature_Item);
      Check_Status
        (Result_Status,
         CryptoLib.Errors.Handshake_Failed,
         "wrong rsa signature algorithm rejected");

      Result_Status :=
        SSH_Lib.Protocol.Signatures.Parse
          (To_Array (Signature_Blob ("ssh-rsa", Good_Signature)),
           "ssh-rsa",
           Signature_Item);
      Touch (Signature_Item);
      Check_Status
        (Result_Status,
         CryptoLib.Errors.Ok,
         "ssh-rsa sha1 signature blob parses as last-resort fallback");

      SSH_Lib.Protocol.Encrypted_State.Reset (State_Item);
      Result_Status :=
        SSH_Lib.Protocol.Host_Keys.Verify_And_Store
          (To_Array (Valid_Blob),
           To_Array (Valid_Signature_Blob),
           "ssh-ed25519",
           Binary_Message,
           State_Item);
      Check_Status
        (Result_Status,
         CryptoLib.Errors.Handshake_Failed,
         "kex host key verify-and-store rejects mismatched ed25519 signature");
      Check
        (not SSH_Lib.Protocol.Encrypted_State.Has_Verified_Host_Key
               (State_Item),
         "failed ed25519 verification leaves verified host key state empty");

      Result_Status :=
        SSH_Lib.Protocol.Host_Keys.Parse
          (To_Array (Valid_Blob), "ssh-ed25519", Key_Item);
      Check_Status
        (Result_Status,
         CryptoLib.Errors.Ok,
         "valid host key available for failure atomicity test");
      Result_Status :=
        SSH_Lib.Protocol.Encrypted_State.Store_Verified_Host_Key
          (State_Item, Key_Item);
      Check_Status
        (Result_Status,
         CryptoLib.Errors.Ok,
         "preexisting verified key stored for failure atomicity test");
      Result_Status :=
        SSH_Lib.Protocol.Host_Keys.Verify_And_Store
          (To_Array (Bad_Blob),
           To_Array (Valid_Signature_Blob),
           "ssh-ed25519",
           Binary_Message,
           State_Item);
      Check_Status
        (Result_Status,
         CryptoLib.Errors.Handshake_Failed,
         "verify-and-store malformed key fails deterministically");
      Check
        (SSH_Lib.Protocol.Encrypted_State.Has_Verified_Host_Key (State_Item),
         "failed verify-and-store does not clear preexisting key");
      Check
        (SSH_Lib.Keys.Algorithm
           (SSH_Lib.Protocol.Encrypted_State.Verified_Host_Key (State_Item))
         = "ssh-ed25519",
         "failed verify-and-store does not replace preexisting key");
   end Run_Phase_6_Host_Key_Tests;

   procedure Run_Phase_5_Kex_Tests is
      use Ada.Streams;
      Source_Item     : CryptoLib.Random.Random_Source;
      Pattern_Data    : Stream_Element_Array (1 .. 16);
      Client_Item     : SSH_Lib.Protocol.Kexinit.Kexinit_Message;
      Parsed_Item     : SSH_Lib.Protocol.Kexinit.Kexinit_Message;
      Server_Item     : SSH_Lib.Protocol.Kexinit.Kexinit_Message;
      Payload_Item    : SSH_Lib.Protocol.Buffers.Packet_Buffer;
      Server_Payload  : SSH_Lib.Protocol.Buffers.Packet_Buffer;
      Status_Value    : CryptoLib.Errors.Status;
      Wire_Data       : Stream_Element_Array (1 .. 1);
      Negotiated_Item : SSH_Lib.Protocol.Kex.Negotiated_Algorithms;
      Digest_A        : SSH_Lib.Protocol.Exchange_Hash.Exchange_Digest;
      Digest_B        : SSH_Lib.Protocol.Exchange_Hash.Exchange_Digest;
      Binary_Field    : constant Stream_Element_Array (1 .. 6) :=
        [1 => 16#00#,
         2 => 16#0A#,
         3 => 16#0D#,
         4 => 16#7F#,
         5 => 16#80#,
         6 => 16#FF#];
      Key_A           : SSH_Lib.Protocol.Buffers.Packet_Buffer;
      Key_B           : SSH_Lib.Protocol.Buffers.Packet_Buffer;
      Keys_Item       : SSH_Lib.Protocol.Session_Keys.Derived_Keys;
      State_Item      : SSH_Lib.Protocol.Encrypted_State.Kex_State;
      Curve_Private   : CryptoLib.Curve25519.Private_Key;
      Curve_Public    : CryptoLib.Curve25519.Public_Key;
      Curve_Secret    : CryptoLib.Curve25519.Public_Key;
      Dh_Private      : SSH_Lib.Protocol.Buffers.Packet_Buffer;
      Dh_Value        : SSH_Lib.Protocol.Buffers.Packet_Buffer;
      Dh_Secret       : SSH_Lib.Protocol.Buffers.Packet_Buffer;
   begin
      for Index_Value in Pattern_Data'Range loop
         Pattern_Data (Index_Value) := Stream_Element (Index_Value);
      end loop;

      CryptoLib.Random.Initialize_Deterministic
        (Source_Item, Pattern_Data);
      Status_Value :=
        SSH_Lib.Protocol.Kexinit.Construct_Client
          (Source_Item, Client_Item, Payload_Item);
      Check_Status
        (Status_Value, CryptoLib.Errors.Ok, "phase5 client kexinit constructed");
      Check
        (SSH_Lib.Protocol.Buffers.To_Array (Payload_Item) (1) = 20,
         "phase5 kexinit message number");
      Check
        (Client_Item.Cookie (1) = 1 and then Client_Item.Cookie (16) = 16,
         "phase5 deterministic kexinit cookie");
      Check
        (not Client_Item.First_Kex_Packet_Follows,
         "phase5 first kex packet follows false");
      Check (Client_Item.Reserved = 0, "phase5 kexinit reserved zero");
      Check
        (To_String (Client_Item.Mac_Algorithms_Client_To_Server)
         = "umac-128-etm@openssh.com,umac-64-etm@openssh.com,umac-128@openssh.com"
             & ",umac-64@openssh.com,hmac-sha2-512-etm@openssh.com"
             & ",hmac-sha2-256-etm@openssh.com,hmac-sha2-512,hmac-sha2-256"
             & ",hmac-sha1-etm@openssh.com,hmac-sha1,hmac-sha1-96-etm@openssh.com,hmac-sha1-96",
         "phase5 implemented SHA-2, SHA-1, and MD5 fallback MACs advertised in kexinit");
      Check
        (To_String (Client_Item.Compression_Algorithms_Client_To_Server)
         = "none,zlib@openssh.com,zlib",
         "phase5 delayed zlib, immediate zlib, and none compression advertised in kexinit");
      Check
        (To_String (Client_Item.Kex_Algorithms)
         = "mlkem768x25519-sha256,mlkem768x25519-sha512,sntrup761x25519-sha512@openssh.com"
             & ",sntrup761x25519-sha512,curve25519-sha256,curve25519-sha256@libssh.org"
             & ",ecdh-sha2-nistp256,ecdh-sha2-nistp384"
             & ",ecdh-sha2-nistp521"
             & ",diffie-hellman-group18-sha512,diffie-hellman-group16-sha512"
             & ",diffie-hellman-group14-sha256,diffie-hellman-group-exchange-sha256"
             & ",diffie-hellman-group-exchange-sha1,diffie-hellman-group14-sha1"
             & ",ext-info-c,kex-strict-c-v00@openssh.com",
         "phase5 implemented hybrid, Curve25519, ECDH, MODP, and GEX kex advertised in kexinit");
      Check
        (To_String (Client_Item.Server_Host_Key_Algorithms)
         = "ssh-ed25519-cert-v01@openssh.com,ecdsa-sha2-nistp256-cert-v01@openssh.com"
             & ",ecdsa-sha2-nistp384-cert-v01@openssh.com"
             & ",ecdsa-sha2-nistp521-cert-v01@openssh.com"
             & ",rsa-sha2-512-cert-v01@openssh.com,rsa-sha2-256-cert-v01@openssh.com"
             & ",ssh-rsa-cert-v01@openssh.com,sk-ssh-ed25519-cert-v01@openssh.com"
             & ",sk-ecdsa-sha2-nistp256-cert-v01@openssh.com,ssh-ed25519"
             & ",ecdsa-sha2-nistp256,ecdsa-sha2-nistp384"
             & ",ecdsa-sha2-nistp521,rsa-sha2-512"
             & ",rsa-sha2-256,sk-ssh-ed25519@openssh.com,sk-ecdsa-sha2-nistp256@openssh.com,ssh-rsa",
         "phase5 implemented Ed25519, ECDSA, RSA, and SK host-key algorithms advertised in kexinit");
      Check
         (To_String (Client_Item.Encryption_Algorithms_Client_To_Server)
         = "chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-gcm@openssh.com"
             & ",aes256-ctr,aes192-ctr,aes128-ctr,aes256-cbc,aes192-cbc,aes128-cbc",
         "phase5 implemented ciphers advertised in kexinit");

      Status_Value :=
        SSH_Lib.Protocol.Kexinit.Parse
          (SSH_Lib.Protocol.Buffers.To_Array (Payload_Item), Parsed_Item);
      Check_Status
        (Status_Value, CryptoLib.Errors.Ok, "phase5 kexinit round trip parse");
      Check
        (To_String (Parsed_Item.Mac_Algorithms_Server_To_Client)
         = "umac-128-etm@openssh.com,umac-64-etm@openssh.com,umac-128@openssh.com"
             & ",umac-64@openssh.com,hmac-sha2-512-etm@openssh.com"
             & ",hmac-sha2-256-etm@openssh.com,hmac-sha2-512,hmac-sha2-256"
             & ",hmac-sha1-etm@openssh.com,hmac-sha1,hmac-sha1-96-etm@openssh.com,hmac-sha1-96",
         "phase5 parsed mac list");
      Check
        (Same_Bytes
           (SSH_Lib.Protocol.Buffers.To_Array (Client_Item.Raw_Payload),
            SSH_Lib.Protocol.Buffers.To_Array (Payload_Item)),
         "phase5 constructed client raw kexinit preserved");
      Check
        (Same_Bytes
           (SSH_Lib.Protocol.Buffers.To_Array (Parsed_Item.Raw_Payload),
            SSH_Lib.Protocol.Buffers.To_Array (Payload_Item)),
         "phase5 parsed server raw kexinit preserved exactly");

      declare
         Full_Payload     : constant Stream_Element_Array :=
           SSH_Lib.Protocol.Buffers.To_Array (Payload_Item);
         Bad_Boolean      : Stream_Element_Array (Full_Payload'Range) :=
           Full_Payload;
         Trailing_Payload :
           Stream_Element_Array (1 .. Full_Payload'Length + 1);
      begin
         Bad_Boolean (Bad_Boolean'Last - 4) := 2;
         Status_Value :=
           SSH_Lib.Protocol.Kexinit.Parse (Bad_Boolean, Parsed_Item);
         Check_Status
           (Status_Value,
            CryptoLib.Errors.Handshake_Failed,
            "phase5 invalid kexinit boolean rejected");
         Check
           (To_String (Parsed_Item.Mac_Algorithms_Client_To_Server) = ""
            and then
              SSH_Lib.Protocol.Buffers.Length (Parsed_Item.Raw_Payload) = 0,
            "phase5 malformed kexinit clears partial parse state");

         declare
            Bad_Reserved : Stream_Element_Array (Full_Payload'Range) :=
              Full_Payload;
         begin
            Bad_Reserved (Bad_Reserved'Last) := 1;
            Status_Value :=
              SSH_Lib.Protocol.Kexinit.Parse (Bad_Reserved, Parsed_Item);
            Check_Status
              (Status_Value,
               CryptoLib.Errors.Handshake_Failed,
               "phase5 nonzero kexinit reserved rejected");
            Check
              (To_String (Parsed_Item.Mac_Algorithms_Server_To_Client) = "",
               "phase5 nonzero reserved clears partial parse state");
         end;

         Status_Value :=
           SSH_Lib.Protocol.Kexinit.Parse
             (Full_Payload (Full_Payload'First .. Full_Payload'Last - 1),
              Parsed_Item);
         Touch (Parsed_Item);
         Check_Status
           (Status_Value,
            CryptoLib.Errors.Handshake_Failed,
            "phase5 truncated kexinit reserved rejected");

         Trailing_Payload
           (Trailing_Payload'First
            ..
              Trailing_Payload'First
              + Stream_Element_Offset (Full_Payload'Length)
              - 1) :=
           Full_Payload;
         Trailing_Payload (Trailing_Payload'Last) := 0;
         Status_Value :=
           SSH_Lib.Protocol.Kexinit.Parse (Trailing_Payload, Parsed_Item);
         Touch (Parsed_Item);
         Check_Status
           (Status_Value,
            CryptoLib.Errors.Handshake_Failed,
            "phase5 trailing kexinit byte rejected");
      end;

      Wire_Data (1) := 99;
      Status_Value := SSH_Lib.Protocol.Kexinit.Parse (Wire_Data, Parsed_Item);
      Touch (Parsed_Item);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Handshake_Failed,
         "phase5 wrong kexinit message rejected");

      declare
         Truncated_Cookie : constant Stream_Element_Array (1 .. 16) :=
           [1 => 20, others => 0];
      begin
         Status_Value :=
           SSH_Lib.Protocol.Kexinit.Parse (Truncated_Cookie, Parsed_Item);
         Check_Status
           (Status_Value,
            CryptoLib.Errors.Handshake_Failed,
            "phase5 truncated kexinit cookie rejected");
      end;

      declare
         Bad_List_Payload : SSH_Lib.Protocol.Buffers.Packet_Buffer;
      begin
         SSH_Lib.Protocol.Buffers.Clear (Bad_List_Payload);
         Check_Status
           (SSH_Lib.Protocol.Buffers.Append_Byte (Bad_List_Payload, 20),
            CryptoLib.Errors.Ok,
            "phase5 bad-list message append");
         for Index_Value in 1 .. 16 loop
            Check_Status
              (SSH_Lib.Protocol.Buffers.Append_Byte
                 (Bad_List_Payload, Stream_Element (Index_Value)),
               CryptoLib.Errors.Ok,
               "phase5 bad-list cookie append");
         end loop;
         Check_Status
           (SSH_Lib.Protocol.Buffers.Append
              (Bad_List_Payload,
               SSH_Lib.Protocol.Buffers.To_Array
                 (SSH_Lib.Protocol.Numbers.Encode_Name_List ("bad name"))),
            CryptoLib.Errors.Ok,
            "phase5 malformed name-list append");
         Status_Value :=
           SSH_Lib.Protocol.Kexinit.Parse
             (SSH_Lib.Protocol.Buffers.To_Array (Bad_List_Payload),
              Parsed_Item);
         Check_Status
           (Status_Value,
            CryptoLib.Errors.Handshake_Failed,
            "phase5 malformed kexinit name rejected");
      end;

      Server_Item := Client_Item;
      Server_Item.Compression_Algorithms_Client_To_Server :=
        To_Unbounded_String ("none,,zlib");
      Status_Value :=
        SSH_Lib.Protocol.Kex.Negotiate
          (Client_Item, Server_Item, Negotiated_Item);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Handshake_Failed,
         "phase5 negotiation validates all name-lists before selection");
      Check
        (To_String (Negotiated_Item.Key_Exchange) = ""
         and then To_String (Negotiated_Item.Mac_Client_To_Server) = "",
         "phase5 failed negotiation leaves no partial algorithm state");

      Server_Item := Client_Item;
      Status_Value :=
        SSH_Lib.Protocol.Kex.Negotiate
          (Client_Item, Server_Item, Negotiated_Item);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Ok,
         "phase5 implemented full negotiation succeeds");
      Check
        (To_String (Negotiated_Item.Key_Exchange) = "mlkem768x25519-sha256"
         and then
           To_String (Negotiated_Item.Server_Host_Key)
           = "ssh-ed25519-cert-v01@openssh.com"
         and then
           To_String (Negotiated_Item.Cipher_Client_To_Server)
           = "chacha20-poly1305@openssh.com"
         and then
           To_String (Negotiated_Item.Mac_Client_To_Server)
           = "umac-128-etm@openssh.com",
         "phase5 full negotiation records implemented algorithms");

      Server_Item := Client_Item;
      Server_Item.Kex_Algorithms := To_Unbounded_String ("curve25519-sha256");
      Status_Value :=
        SSH_Lib.Protocol.Kexinit.Encode (Server_Item, Server_Payload);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Ok,
         "phase5 fixture curve server kexinit encodes");
      Status_Value :=
        SSH_Lib.Protocol.Kexinit.Parse
          (SSH_Lib.Protocol.Buffers.To_Array (Server_Payload), Server_Item);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Ok,
         "phase5 fixture curve server kexinit parses");
      Status_Value :=
        SSH_Lib.Protocol.Kex.Negotiate
          (Client_Item, Server_Item, Negotiated_Item);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Ok,
         "phase5 curve25519 negotiation succeeds");
      Check
        (To_String (Negotiated_Item.Key_Exchange) = "curve25519-sha256"
         and then To_String (Negotiated_Item.Server_Host_Key) /= "",
         "phase5 curve25519 negotiation records result");

      Server_Item := Client_Item;
      Server_Item.Kex_Algorithms :=
        To_Unbounded_String ("curve25519-sha256@libssh.org");
      Status_Value :=
        SSH_Lib.Protocol.Kexinit.Encode (Server_Item, Server_Payload);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Ok,
         "phase5 fixture libssh curve server kexinit encodes");
      Status_Value :=
        SSH_Lib.Protocol.Kexinit.Parse
          (SSH_Lib.Protocol.Buffers.To_Array (Server_Payload), Server_Item);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Ok,
         "phase5 fixture libssh curve server kexinit parses");
      Status_Value :=
        SSH_Lib.Protocol.Kex.Negotiate
          (Client_Item, Server_Item, Negotiated_Item);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Ok,
         "phase5 libssh curve25519 negotiation succeeds");
      Check
        (To_String (Negotiated_Item.Key_Exchange)
         = "curve25519-sha256@libssh.org"
         and then To_String (Negotiated_Item.Server_Host_Key) /= "",
         "phase5 libssh curve25519 negotiation records result");

      Status_Value :=
        CryptoLib.Curve25519.Generate_Keypair
          (Source_Item, Curve_Private, Curve_Public);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Ok,
         "phase5 curve25519 keypair generated");
      Check
        (Curve_Public (1) /= 0 or else Curve_Public (32) /= 0,
         "phase5 curve25519 public key populated");
      Status_Value :=
        CryptoLib.Curve25519.Shared_Secret
          (Curve_Private, Curve_Public, Curve_Secret);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Ok,
         "phase5 curve25519 shared secret computes");
      Check
        (Curve_Secret (1) /= 0 or else Curve_Secret (32) /= 0,
         "phase5 curve25519 shared secret populated");
      CryptoLib.Curve25519.Clear (Curve_Private);
      Status_Value :=
        CryptoLib.Curve25519.Shared_Secret
          (Curve_Private, Curve_Public, Curve_Secret);
      Touch (Curve_Secret);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Handshake_Failed,
         "phase5 curve25519 cleared private key cannot compute secret");
      CryptoLib.Curve25519.Clear (Curve_Public);
      CryptoLib.Curve25519.Clear (Curve_Secret);
      Check
        (Curve_Public = [Curve_Public'Range => 0]
         and then Curve_Secret = [Curve_Secret'Range => 0],
         "phase5 curve25519 clear erases public-sized buffers");

      declare
         Alice_Private       : constant CryptoLib.Curve25519.Public_Key :=
           [1  => 16#77#,
            2  => 16#07#,
            3  => 16#6D#,
            4  => 16#0A#,
            5  => 16#73#,
            6  => 16#18#,
            7  => 16#A5#,
            8  => 16#7D#,
            9  => 16#3C#,
            10 => 16#16#,
            11 => 16#C1#,
            12 => 16#72#,
            13 => 16#51#,
            14 => 16#B2#,
            15 => 16#66#,
            16 => 16#45#,
            17 => 16#DF#,
            18 => 16#4C#,
            19 => 16#2F#,
            20 => 16#87#,
            21 => 16#EB#,
            22 => 16#C0#,
            23 => 16#99#,
            24 => 16#2A#,
            25 => 16#B1#,
            26 => 16#77#,
            27 => 16#FB#,
            28 => 16#A5#,
            29 => 16#1D#,
            30 => 16#B9#,
            31 => 16#2C#,
            32 => 16#2A#];
         Alice_Public        : constant CryptoLib.Curve25519.Public_Key :=
           [1  => 16#85#,
            2  => 16#20#,
            3  => 16#F0#,
            4  => 16#09#,
            5  => 16#89#,
            6  => 16#30#,
            7  => 16#A7#,
            8  => 16#54#,
            9  => 16#74#,
            10 => 16#8B#,
            11 => 16#7D#,
            12 => 16#DC#,
            13 => 16#B4#,
            14 => 16#3E#,
            15 => 16#F7#,
            16 => 16#5A#,
            17 => 16#0D#,
            18 => 16#BF#,
            19 => 16#3A#,
            20 => 16#0D#,
            21 => 16#26#,
            22 => 16#38#,
            23 => 16#1A#,
            24 => 16#F4#,
            25 => 16#EB#,
            26 => 16#A4#,
            27 => 16#A9#,
            28 => 16#8E#,
            29 => 16#AA#,
            30 => 16#9B#,
            31 => 16#4E#,
            32 => 16#6A#];
         Bob_Private         : constant CryptoLib.Curve25519.Public_Key :=
           [1  => 16#5D#,
            2  => 16#AB#,
            3  => 16#08#,
            4  => 16#7E#,
            5  => 16#62#,
            6  => 16#4A#,
            7  => 16#8A#,
            8  => 16#4B#,
            9  => 16#79#,
            10 => 16#E1#,
            11 => 16#7F#,
            12 => 16#8B#,
            13 => 16#83#,
            14 => 16#80#,
            15 => 16#0E#,
            16 => 16#E6#,
            17 => 16#6F#,
            18 => 16#3B#,
            19 => 16#B1#,
            20 => 16#29#,
            21 => 16#26#,
            22 => 16#18#,
            23 => 16#B6#,
            24 => 16#FD#,
            25 => 16#1C#,
            26 => 16#2F#,
            27 => 16#8B#,
            28 => 16#27#,
            29 => 16#FF#,
            30 => 16#88#,
            31 => 16#E0#,
            32 => 16#EB#];
         Bob_Public          : constant CryptoLib.Curve25519.Public_Key :=
           [1  => 16#DE#,
            2  => 16#9E#,
            3  => 16#DB#,
            4  => 16#7D#,
            5  => 16#7B#,
            6  => 16#7D#,
            7  => 16#C1#,
            8  => 16#B4#,
            9  => 16#D3#,
            10 => 16#5B#,
            11 => 16#61#,
            12 => 16#C2#,
            13 => 16#EC#,
            14 => 16#E4#,
            15 => 16#35#,
            16 => 16#37#,
            17 => 16#3F#,
            18 => 16#83#,
            19 => 16#43#,
            20 => 16#C8#,
            21 => 16#5B#,
            22 => 16#78#,
            23 => 16#67#,
            24 => 16#4D#,
            25 => 16#AD#,
            26 => 16#FC#,
            27 => 16#7E#,
            28 => 16#14#,
            29 => 16#6F#,
            30 => 16#88#,
            31 => 16#2B#,
            32 => 16#4F#];
         Shared_Vector       : constant CryptoLib.Curve25519.Public_Key :=
           [1  => 16#4A#,
            2  => 16#5D#,
            3  => 16#9D#,
            4  => 16#5B#,
            5  => 16#A4#,
            6  => 16#CE#,
            7  => 16#2D#,
            8  => 16#E1#,
            9  => 16#72#,
            10 => 16#8E#,
            11 => 16#3B#,
            12 => 16#F4#,
            13 => 16#80#,
            14 => 16#35#,
            15 => 16#0F#,
            16 => 16#25#,
            17 => 16#E0#,
            18 => 16#7E#,
            19 => 16#21#,
            20 => 16#C9#,
            21 => 16#47#,
            22 => 16#D1#,
            23 => 16#9E#,
            24 => 16#33#,
            25 => 16#76#,
            26 => 16#F0#,
            27 => 16#9B#,
            28 => 16#3C#,
            29 => 16#1E#,
            30 => 16#16#,
            31 => 16#17#,
            32 => 16#42#];
         Base_Point          : constant CryptoLib.Curve25519.Public_Key :=
           [1 => 9, others => 0];
         Bob_Public_High_Bit : CryptoLib.Curve25519.Public_Key :=
           Bob_Public;
         Raw_Result          : CryptoLib.Curve25519.Public_Key;
      begin
         Bob_Public_High_Bit (32) :=
           Bob_Public_High_Bit (32) or Ada.Streams.Stream_Element'(16#80#);
         Status_Value :=
           CryptoLib.Curve25519.Compute_Raw
             (Alice_Private, Base_Point, Raw_Result);
         Check_Status
           (Status_Value,
            CryptoLib.Errors.Ok,
            "phase5 RFC7748 alice public key computes");
         Check
           (Raw_Result = Alice_Public,
            "phase5 RFC7748 alice public key matches vector");

         Status_Value :=
           CryptoLib.Curve25519.Compute_Raw
             (Bob_Private, Base_Point, Raw_Result);
         Check_Status
           (Status_Value,
            CryptoLib.Errors.Ok,
            "phase5 RFC7748 bob public key computes");
         Check
           (Raw_Result = Bob_Public,
            "phase5 RFC7748 bob public key matches vector");

         Status_Value :=
           CryptoLib.Curve25519.Compute_Raw
             (Alice_Private, Bob_Public, Raw_Result);
         Check_Status
           (Status_Value,
            CryptoLib.Errors.Ok,
            "phase5 RFC7748 alice shared secret computes");
         Check
           (Raw_Result = Shared_Vector,
            "phase5 RFC7748 alice shared secret matches vector");

         Status_Value :=
           CryptoLib.Curve25519.Compute_Raw
             (Alice_Private, Bob_Public_High_Bit, Raw_Result);
         Check_Status
           (Status_Value,
            CryptoLib.Errors.Ok,
            "phase5 RFC7748 high-bit peer public key computes");
         Check
           (Raw_Result = Shared_Vector,
            "phase5 RFC7748 high-bit peer public key masks to same shared secret");

         Status_Value :=
           CryptoLib.Curve25519.Compute_Raw
             (Bob_Private, Alice_Public, Raw_Result);
         Check_Status
           (Status_Value,
            CryptoLib.Errors.Ok,
            "phase5 RFC7748 bob shared secret computes");
         Check
           (Raw_Result = Shared_Vector,
            "phase5 RFC7748 bob shared secret matches vector");

         Status_Value :=
           CryptoLib.Curve25519.Compute_Raw
             (Alice_Private, [others => 0], Raw_Result);
         Check_Status
           (Status_Value,
            CryptoLib.Errors.Handshake_Failed,
            "phase5 curve25519 low-order all-zero peer fails closed");
         Check
           (Raw_Result = [Raw_Result'Range => 0],
            "phase5 curve25519 failed raw compute clears output");
      end;

      Status_Value :=
        CryptoLib.Diffie_Hellman.Generate_Group14_Client_Value
          (Source_Item, Dh_Value);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Ok,
         "phase5 group14 client value computes");
      Check
        (SSH_Lib.Protocol.Buffers.Length (Dh_Value) > 0,
         "phase5 group14 client value emits public mpint");

      Status_Value :=
        CryptoLib.Diffie_Hellman.Generate_Group14_Keypair
          (Source_Item, Dh_Private, Dh_Value);
      Check_Status
        (Status_Value, CryptoLib.Errors.Ok, "phase5 group14 keypair computes");
      Check
        (SSH_Lib.Protocol.Buffers.Length (Dh_Private) = 256
         and then SSH_Lib.Protocol.Buffers.Length (Dh_Value) > 0,
         "phase5 group14 keypair emits private scalar and public mpint");
      Status_Value :=
        CryptoLib.Diffie_Hellman.Compute_Group14_Shared_Secret
          (SSH_Lib.Protocol.Buffers.To_Array (Dh_Private),
           SSH_Lib.Protocol.Buffers.To_Array (Dh_Value),
           Dh_Secret);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Ok,
         "phase5 group14 shared secret computes");
      Check
        (SSH_Lib.Protocol.Buffers.Length (Dh_Secret) > 0,
         "phase5 group14 shared secret emits mpint");

      Status_Value :=
        SSH_Lib.Protocol.Exchange_Hash.Compute_Curve25519_SHA256
          ("SSH-2.0-SSH_Lib_Test_Client",
           "SSH-2.0-SSH_Lib_Test_Server",
           Payload_Item,
           Server_Payload,
           Binary_Field,
           Bytes_From_String ("client-public"),
           Bytes_From_String ("server-public"),
           Binary_Field,
           Digest_A);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Ok,
         "phase5 curve exchange hash computes");
      Status_Value :=
        SSH_Lib.Protocol.Exchange_Hash.Compute_Curve25519_SHA256
          ("SSH-2.0-SSH_Lib_Test_Client",
           "SSH-2.0-SSH_Lib_Test_Server",
           Payload_Item,
           Server_Payload,
           Binary_Field,
           Bytes_From_String ("client-public"),
           Bytes_From_String ("server-public"),
           Binary_Field,
           Digest_B);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Ok,
         "phase5 curve exchange hash recomputes");
      Check (Digest_A = Digest_B, "phase5 same transcript same exchange hash");

      declare
         Server_Public_Canonical : constant Stream_Element_Array (1 .. 32) :=
           [1  => 16#DE#,
            2  => 16#9E#,
            3  => 16#DB#,
            4  => 16#7D#,
            5  => 16#7B#,
            6  => 16#7D#,
            7  => 16#C1#,
            8  => 16#B4#,
            9  => 16#D3#,
            10 => 16#5B#,
            11 => 16#61#,
            12 => 16#C2#,
            13 => 16#EC#,
            14 => 16#E4#,
            15 => 16#35#,
            16 => 16#37#,
            17 => 16#3F#,
            18 => 16#83#,
            19 => 16#43#,
            20 => 16#C8#,
            21 => 16#5B#,
            22 => 16#78#,
            23 => 16#67#,
            24 => 16#4D#,
            25 => 16#AD#,
            26 => 16#FC#,
            27 => 16#7E#,
            28 => 16#14#,
            29 => 16#6F#,
            30 => 16#88#,
            31 => 16#2B#,
            32 => 16#4F#];
         Server_Public_High_Bit  : Stream_Element_Array (1 .. 32) :=
           Server_Public_Canonical;
      begin
         Server_Public_High_Bit (32) :=
           Server_Public_High_Bit (32) or Ada.Streams.Stream_Element'(16#80#);

         Status_Value :=
           SSH_Lib.Protocol.Exchange_Hash.Compute_Curve25519_SHA256
             ("SSH-2.0-SSH_Lib_Test_Client",
              "SSH-2.0-SSH_Lib_Test_Server",
              Payload_Item,
              Server_Payload,
              Binary_Field,
              Bytes_From_String ("client-public"),
              Server_Public_Canonical,
              Binary_Field,
              Digest_A);
         Check_Status
           (Status_Value,
            CryptoLib.Errors.Ok,
            "phase5 curve exchange hash canonical public computes");
         Status_Value :=
           SSH_Lib.Protocol.Exchange_Hash.Compute_Curve25519_SHA256
             ("SSH-2.0-SSH_Lib_Test_Client",
              "SSH-2.0-SSH_Lib_Test_Server",
              Payload_Item,
              Server_Payload,
              Binary_Field,
              Bytes_From_String ("client-public"),
              Server_Public_High_Bit,
              Binary_Field,
              Digest_B);
         Check_Status
           (Status_Value,
            CryptoLib.Errors.Ok,
            "phase5 curve exchange hash high-bit public computes");
         Check
           (Digest_A /= Digest_B,
            "phase5 exchange hash preserves exact high-bit server public bytes");
      end;

      Status_Value :=
        SSH_Lib.Protocol.Exchange_Hash.Compute_Curve25519_SHA256
          ("SSH-2.0-SSH_Lib_Test_Client_Changed",
           "SSH-2.0-SSH_Lib_Test_Server",
           Payload_Item,
           Server_Payload,
           Binary_Field,
           Bytes_From_String ("client-public"),
           Bytes_From_String ("server-public"),
           Binary_Field,
           Digest_B);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Ok,
         "phase5 changed transcript exchange hash computes");
      Check
        (Digest_A /= Digest_B,
         "phase5 changed identification changes exchange hash");
      Status_Value :=
        SSH_Lib.Protocol.Exchange_Hash.Compute_Curve25519_SHA256
          ("SSH-2.0-SSH_Lib_Test_Client",
           "SSH-2.0-SSH_Lib_Test_Server",
           Payload_Item,
           Server_Payload,
           [1 .. 0 => 0],
           Bytes_From_String ("client-public"),
           Bytes_From_String ("server-public"),
           Binary_Field,
           Digest_B);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Handshake_Failed,
         "phase5 empty host key rejected by exchange hash");
      Check
        (Digest_B = [Digest_B'Range => 0],
         "phase5 failed exchange hash clears digest");

      Key_A :=
        SSH_Lib.Derive.Derive_SHA256
          (Binary_Field, Digest_A, Digest_A, 'A', 40);
      Key_B :=
        SSH_Lib.Derive.Derive_SHA256
          (Binary_Field, Digest_A, Digest_A, 'B', 40);
      Check
        (SSH_Lib.Protocol.Buffers.Length (Key_A) = 40,
         "phase5 key derivation extends beyond digest size");
      Check
        (not Same_Bytes
               (SSH_Lib.Protocol.Buffers.To_Array (Key_A),
                SSH_Lib.Protocol.Buffers.To_Array (Key_B)),
         "phase5 different derivation labels differ");
      Key_B :=
        SSH_Lib.Derive.Derive_SHA256
          (Binary_Field, Digest_A, Digest_A, 'A', 40);
      Check
        (Same_Bytes
           (SSH_Lib.Protocol.Buffers.To_Array (Key_A),
            SSH_Lib.Protocol.Buffers.To_Array (Key_B)),
         "phase5 same derivation inputs produce same key stream");
      Key_B :=
        SSH_Lib.Derive.Derive_SHA256
          (Binary_Field, Digest_A, Digest_B, 'A', 40);
      Check
        (not Same_Bytes
               (SSH_Lib.Protocol.Buffers.To_Array (Key_A),
                SSH_Lib.Protocol.Buffers.To_Array (Key_B)),
         "phase5 different session id changes key stream");
      Key_B :=
        SSH_Lib.Derive.Derive_SHA256
          (Binary_Field, Digest_A, Digest_A, 'A', 0);
      Check
        (SSH_Lib.Protocol.Buffers.Length (Key_B) = 0,
         "phase5 zero length derivation empty");

      Status_Value :=
        SSH_Lib.Protocol.Session_Keys.Derive_SHA256_Keys
          (Binary_Field, Digest_A, Digest_A, 16, 16, 32, Keys_Item);
      Check_Status
        (Status_Value, CryptoLib.Errors.Ok, "phase5 session keys derive");
      Check
        (SSH_Lib.Protocol.Buffers.Length
           (Keys_Item.Integrity_Key_Server_To_Client)
         = 32,
         "phase5 integrity key length");

      SSH_Lib.Protocol.Encrypted_State.Reset (State_Item);
      Check
        (not SSH_Lib.Protocol.Encrypted_State.Kex_Complete (State_Item),
         "phase5 encrypted state reset incomplete");
      Status_Value :=
        SSH_Lib.Protocol.Encrypted_State.Receive_Newkeys
          (State_Item, SSH_Lib.Protocol.Encrypted_State.Encode_Newkeys);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Handshake_Failed,
         "phase5 newkeys rejected before kex complete");
      Negotiated_Item.Cipher_Client_To_Server :=
        To_Unbounded_String ("aes128-ctr");
      Negotiated_Item.Cipher_Server_To_Client :=
        To_Unbounded_String ("aes128-ctr");

      Status_Value :=
        SSH_Lib.Protocol.Encrypted_State.Install_Derived_Keys
          (State_Item, Negotiated_Item, Digest_A, Digest_A, Keys_Item);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Ok,
         "phase5 encrypted state installs keys");
      Status_Value :=
        SSH_Lib.Protocol.Encrypted_State.Receive_Newkeys
          (State_Item, SSH_Lib.Protocol.Encrypted_State.Encode_Newkeys);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Handshake_Failed,
         "phase5 server newkeys rejected before client newkeys sent");
      Status_Value :=
        SSH_Lib.Protocol.Encrypted_State.Send_Newkeys (State_Item);
      Check_Status
        (Status_Value, CryptoLib.Errors.Ok, "phase5 send newkeys state");
      Check
        (SSH_Lib.Protocol.Encrypted_State.Newkeys_Sent (State_Item),
         "phase5 newkeys sent flag");
      Status_Value :=
        SSH_Lib.Protocol.Encrypted_State.Send_Newkeys (State_Item);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Handshake_Failed,
         "phase5 duplicate client newkeys rejected");
      Wire_Data (1) := 42;
      Status_Value :=
        SSH_Lib.Protocol.Encrypted_State.Receive_Newkeys
          (State_Item, Wire_Data);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Handshake_Failed,
         "phase5 unexpected newkeys payload rejected");
      Status_Value :=
        SSH_Lib.Protocol.Encrypted_State.Receive_Newkeys
          (State_Item, SSH_Lib.Protocol.Encrypted_State.Encode_Newkeys);
      Check_Status
        (Status_Value, CryptoLib.Errors.Ok, "phase5 receive newkeys state");
      Check
        (SSH_Lib.Protocol.Encrypted_State.Newkeys_Received (State_Item),
         "phase5 newkeys received flag");
      Status_Value :=
        SSH_Lib.Protocol.Encrypted_State.Receive_Newkeys
          (State_Item, SSH_Lib.Protocol.Encrypted_State.Encode_Newkeys);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Handshake_Failed,
         "phase5 duplicate server newkeys rejected");
      Check
        (SSH_Lib.Protocol.Encrypted_State.Outbound_Encrypted_Active
           (State_Item)
         and then
           SSH_Lib.Protocol.Encrypted_State.Inbound_Encrypted_Active
             (State_Item),
         "phase5 encrypted mode activated after implemented AES newkeys");
      Check
        (SSH_Lib.Protocol.Encrypted_State.Outbound_Sequence (State_Item) = 0
         and then
           SSH_Lib.Protocol.Encrypted_State.Inbound_Sequence (State_Item) = 0,
         "phase5 encrypted state sequences start at zero");
      Status_Value :=
        SSH_Lib.Protocol.Encrypted_State.Note_Outbound_Packet (State_Item);
      Check_Status
        (Status_Value, CryptoLib.Errors.Ok, "phase5 outbound sequence noted");
      Status_Value :=
        SSH_Lib.Protocol.Encrypted_State.Note_Inbound_Packet (State_Item);
      Check_Status
        (Status_Value, CryptoLib.Errors.Ok, "phase5 inbound sequence noted");
      Check
        (SSH_Lib.Protocol.Encrypted_State.Outbound_Sequence (State_Item) = 1
         and then
           SSH_Lib.Protocol.Encrypted_State.Inbound_Sequence (State_Item) = 1,
         "phase5 encrypted state sequences increment");
      SSH_Lib.Protocol.Encrypted_State.Set_Sequences_For_Test
        (State_Item, Interfaces.Unsigned_32'Last, Interfaces.Unsigned_32'Last);
      Status_Value :=
        SSH_Lib.Protocol.Encrypted_State.Note_Outbound_Packet (State_Item);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Ok,
         "phase5 outbound sequence wrap status");
      Status_Value :=
        SSH_Lib.Protocol.Encrypted_State.Note_Inbound_Packet (State_Item);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Ok,
         "phase5 inbound sequence wrap status");
      Check
        (SSH_Lib.Protocol.Encrypted_State.Outbound_Sequence (State_Item) = 0
         and then
           SSH_Lib.Protocol.Encrypted_State.Inbound_Sequence (State_Item) = 0,
         "phase5 encrypted state sequences wrap modulo 2**32");
   end Run_Phase_5_Kex_Tests;

   procedure Run_Phase_8_Agent_Userauth_Tests is
      use Ada.Streams;
      Status_Value   : CryptoLib.Errors.Status;
      Identities     : SSH_Lib.Agent.Identity_List;
      Signature      : SSH_Lib.Protocol.Buffers.Packet_Buffer;
      Reply_Value    : SSH_Lib.Protocol.Userauth.Reply;
      Options        : SSH_Lib.Sessions.Session_Options;
      Session_Item   : SSH_Lib.Sessions.Session;
      Agent_Link     : SSH_Lib.Agent.Transport.Agent_Connection;
      Decoded_Length : Natural := 0;

      Binary_Key              : constant Stream_Element_Array (1 .. 8) :=
        [1 => 16#00#,
         2 => 16#0A#,
         3 => 16#0D#,
         4 => 16#7F#,
         5 => 16#80#,
         6 => 16#FF#,
         7 => 16#01#,
         8 => 16#02#];
      Binary_Key_2            : constant Stream_Element_Array (1 .. 8) :=
        [1 => 16#02#,
         2 => 16#01#,
         3 => 16#FF#,
         4 => 16#80#,
         5 => 16#7F#,
         6 => 16#0D#,
         7 => 16#0A#,
         8 => 16#00#];
      Session_Id              : constant Stream_Element_Array (1 .. 4) :=
        [1 => 16#AA#, 2 => 16#00#, 3 => 16#BB#, 4 => 16#FF#];
      Signature_Data          : constant Stream_Element_Array (1 .. 3) :=
        [1 => 16#01#, 2 => 16#80#, 3 => 16#FF#];
      Comment_With_High_Bytes : constant Stream_Element_Array (1 .. 3) :=
        [1 => 16#66#, 2 => 16#80#, 3 => 16#FF#];
      Empty_Binary            : constant Stream_Element_Array (1 .. 0) :=
        [others => 0];

      function One_String (Value : String) return Stream_Element_Array is
         Result : Stream_Element_Array (1 .. Value'Length);
         Cursor : Stream_Element_Offset := Result'First;
      begin
         for Character_Value of Value loop
            Result (Cursor) :=
              Stream_Element (Character'Pos (Character_Value));
            Cursor := Cursor + 1;
         end loop;
         return Result;
      end One_String;

      function Encoded_String
        (Data : Stream_Element_Array) return Stream_Element_Array is
      begin
         return
           SSH_Lib.Protocol.Buffers.To_Array
             (SSH_Lib.Protocol.Numbers.Encode_SSH_String (Data));
      end Encoded_String;

      function U32 (Value : Interfaces.Unsigned_32) return Stream_Element_Array
      is
      begin
         return SSH_Lib.Protocol.Numbers.Encode_Uint32 (Value);
      end U32;

      Empty_Request                  : constant Stream_Element_Array :=
        SSH_Lib.Agent.Protocol.Encode_Request_Identities;
      Zero_Identities                : constant Stream_Element_Array :=
        [1 => SSH_Lib.Agent.Protocol.SSH_AGENT_IDENTITIES_ANSWER,
         2 => 0,
         3 => 0,
         4 => 0,
         5 => 0];
      One_Identity                   : constant Stream_Element_Array :=
        [1 => SSH_Lib.Agent.Protocol.SSH_AGENT_IDENTITIES_ANSWER]
        & U32 (1)
        & Encoded_String (Binary_Key)
        & Encoded_String (One_String ("fixture"));
      One_Identity_High_Comment      : constant Stream_Element_Array :=
        [1 => SSH_Lib.Agent.Protocol.SSH_AGENT_IDENTITIES_ANSWER]
        & U32 (1)
        & Encoded_String (Binary_Key)
        & Encoded_String (Comment_With_High_Bytes);
      Two_Identities                 : constant Stream_Element_Array :=
        [1 => SSH_Lib.Agent.Protocol.SSH_AGENT_IDENTITIES_ANSWER]
        & U32 (2)
        & Encoded_String (Binary_Key)
        & Encoded_String (One_String ("first"))
        & Encoded_String (Binary_Key_2)
        & Encoded_String (One_String ("second"));
      Oversized_Identity_Count       : constant Stream_Element_Array :=
        [1 => SSH_Lib.Agent.Protocol.SSH_AGENT_IDENTITIES_ANSWER] & U32 (129);
      Truncated_Identity_Key         : constant Stream_Element_Array :=
        [1 => SSH_Lib.Agent.Protocol.SSH_AGENT_IDENTITIES_ANSWER]
        & U32 (1)
        & (1 => 0, 2 => 0, 3 => 0, 4 => 9, 5 => 1);
      Signature_Blob_Data            : constant Stream_Element_Array :=
        Encoded_String (One_String ("ssh-ed25519"))
        & Encoded_String (Signature_Data);
      Sign_Response                  : constant Stream_Element_Array :=
        [1 => SSH_Lib.Agent.Protocol.SSH_AGENT_SIGN_RESPONSE]
        & Encoded_String (Signature_Blob_Data);
      Malformed_Nested_Sign_Response : constant Stream_Element_Array :=
        [1 => SSH_Lib.Agent.Protocol.SSH_AGENT_SIGN_RESPONSE]
        & Encoded_String (Signature_Data);
      Legacy_Nested_Sign_Response    : constant Stream_Element_Array :=
        [1 => SSH_Lib.Agent.Protocol.SSH_AGENT_SIGN_RESPONSE]
        & Encoded_String
            (Encoded_String (One_String ("ssh-rsa"))
             & Encoded_String (Signature_Data));
      Truncated_Sign_Response        : constant Stream_Element_Array :=
        [1 => SSH_Lib.Agent.Protocol.SSH_AGENT_SIGN_RESPONSE]
        & [1 => 0, 2 => 0, 3 => 0, 4 => 4, 5 => 16#AA#];
      Service_Accept                 : constant Stream_Element_Array :=
        [1 => SSH_Lib.Protocol.Service.SSH_MSG_SERVICE_ACCEPT]
        & Encoded_String (One_String ("ssh-userauth"));
      Wrong_Service_Accept           : constant Stream_Element_Array :=
        [1 => SSH_Lib.Protocol.Service.SSH_MSG_SERVICE_ACCEPT]
        & Encoded_String (One_String ("ssh-bad"));
      Extra_Service_Accept           : constant Stream_Element_Array :=
        Service_Accept & (1 => 0);
      Failure_Reply                  : constant Stream_Element_Array :=
        [1 => SSH_Lib.Protocol.Userauth.SSH_MSG_USERAUTH_FAILURE]
        & SSH_Lib.Protocol.Buffers.To_Array
            (SSH_Lib.Protocol.Numbers.Encode_Name_List ("publickey,password"))
        & (1 => 0);
      Partial_Failure_Reply          : constant Stream_Element_Array :=
        [1 => SSH_Lib.Protocol.Userauth.SSH_MSG_USERAUTH_FAILURE]
        & SSH_Lib.Protocol.Buffers.To_Array
            (SSH_Lib.Protocol.Numbers.Encode_Name_List ("publickey"))
        & (1 => 1);
      Malformed_Failure_Reply        : constant Stream_Element_Array :=
        [1 => SSH_Lib.Protocol.Userauth.SSH_MSG_USERAUTH_FAILURE]
        & SSH_Lib.Protocol.Buffers.To_Array
            (SSH_Lib.Protocol.Numbers.Encode_Name_List ("publickey"));
      Success_Reply                  : constant Stream_Element_Array :=
        [1 => SSH_Lib.Protocol.Userauth.SSH_MSG_USERAUTH_SUCCESS];
      Pk_Ok_Reply                    : constant Stream_Element_Array :=
        [1 => SSH_Lib.Protocol.Userauth.SSH_MSG_USERAUTH_PK_OK]
        & Encoded_String (One_String ("ssh-ed25519"))
        & Encoded_String (Binary_Key);
      Pk_Ok_Trailing_Reply           : constant Stream_Element_Array :=
        Pk_Ok_Reply & (1 => 0);
      Pk_Ok_Bad_Algorithm_Reply      : constant Stream_Element_Array :=
        [1 => SSH_Lib.Protocol.Userauth.SSH_MSG_USERAUTH_PK_OK]
        & Encoded_String ([1 => 16#80#])
        & Encoded_String (Binary_Key);
      Pk_Ok_Empty_Key_Reply          : constant Stream_Element_Array :=
        [1 => SSH_Lib.Protocol.Userauth.SSH_MSG_USERAUTH_PK_OK]
        & Encoded_String (One_String ("ssh-ed25519"))
        & Encoded_String (Empty_Binary);
      Banner_Reply                   : constant Stream_Element_Array :=
        [1 => SSH_Lib.Protocol.Userauth.SSH_MSG_USERAUTH_BANNER]
        & Encoded_String (One_String ("ignored"))
        & Encoded_String (One_String ("en"));
      Keyboard_Info_Request          : constant Stream_Element_Array :=
        [1 => SSH_Lib.Protocol.Userauth.SSH_MSG_USERAUTH_INFO_REQUEST]
        & Encoded_String (One_String ("login"))
        & Encoded_String (One_String ("enter password"))
        & Encoded_String (One_String (""))
        & U32 (1)
        & Encoded_String (One_String ("Password: "))
        & (1 => 0);
      Keyboard_Echo_Info_Request     : constant Stream_Element_Array :=
        [1 => SSH_Lib.Protocol.Userauth.SSH_MSG_USERAUTH_INFO_REQUEST]
        & Encoded_String (One_String ("login"))
        & Encoded_String (One_String ("enter password"))
        & Encoded_String (One_String (""))
        & U32 (1)
        & Encoded_String (One_String ("Code: "))
        & (1 => 1);
      Keyboard_Two_Prompt_Request    : constant Stream_Element_Array :=
        [1 => SSH_Lib.Protocol.Userauth.SSH_MSG_USERAUTH_INFO_REQUEST]
        & Encoded_String (One_String ("login"))
        & Encoded_String (One_String ("two prompts"))
        & Encoded_String (One_String (""))
        & U32 (2)
        & Encoded_String (One_String ("Password: "))
        & (1 => 0)
        & Encoded_String (One_String ("OTP: "))
        & (1 => 0);
      Keyboard_Malformed_Request     : constant Stream_Element_Array :=
        Keyboard_Info_Request & (1 => 0);
   begin
      Check
        (Empty_Request'Length = 1
         and then
           Empty_Request (Empty_Request'First)
           = SSH_Lib.Agent.Protocol.SSH_AGENTC_REQUEST_IDENTITIES,
         "phase8 request identities message type");
      Status_Value :=
        SSH_Lib.Agent.Protocol.Decode_Message_Length
          (SSH_Lib.Agent.Protocol.Encode_Message_Length (Empty_Request'Length),
           Decoded_Length);
      Check_Status
        (Status_Value, CryptoLib.Errors.Ok, "phase8 agent frame length decodes");
      Check
        (Decoded_Length = Empty_Request'Length,
         "phase8 agent frame length value preserved");
      Status_Value :=
        SSH_Lib.Agent.Protocol.Decode_Message_Length
          ([1 => 0, 2 => 16, 3 => 0, 4 => 1], Decoded_Length);
      Touch (Decoded_Length);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Authentication_Failed,
         "phase8 oversized agent frame length rejected");
      Status_Value :=
        SSH_Lib.Agent.Protocol.Decode_Message_Length
          ([1 => 0, 2 => 0, 3 => 0, 4 => 0], Decoded_Length);
      Touch (Decoded_Length);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Authentication_Failed,
         "phase8 zero-length agent frame rejected");
      Status_Value :=
        SSH_Lib.Agent.Protocol.Decode_Message_Length
          ([1 => 0, 2 => 0, 3 => 1], Decoded_Length);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Authentication_Failed,
         "phase8 short agent frame header rejected");

      Status_Value :=
        SSH_Lib.Agent.Protocol.Parse_Identities_Answer
          (Zero_Identities, Identities);
      Check_Status
        (Status_Value, CryptoLib.Errors.Ok, "phase8 zero identities parse");
      Check
        (SSH_Lib.Agent.Count (Identities) = 0, "phase8 zero identities count");

      Status_Value :=
        SSH_Lib.Agent.Protocol.Parse_Identities_Answer
          (One_Identity, Identities);
      Check_Status
        (Status_Value, CryptoLib.Errors.Ok, "phase8 one binary identity parse");
      Check
        (SSH_Lib.Agent.Count (Identities) = 1, "phase8 one identity count");
      Check
        (Same_Bytes
           (SSH_Lib.Agent.Public_Key_Blob (Identities, 1), Binary_Key),
         "phase8 identity key blob binary preserved");
      Check
        (SSH_Lib.Agent.Comment (Identities, 1) = "fixture",
         "phase8 identity comment parsed");

      Status_Value :=
        SSH_Lib.Agent.Protocol.Parse_Identities_Answer
          (One_Identity_High_Comment, Identities);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Ok,
         "phase8 identity high-byte comment parse");
      Check
        (SSH_Lib.Agent.Comment (Identities, 1)'Length = 3
         and then
           Character'Pos (SSH_Lib.Agent.Comment (Identities, 1) (2)) = 16#80#
         and then
           Character'Pos (SSH_Lib.Agent.Comment (Identities, 1) (3)) = 16#FF#,
         "phase8 identity comment octets preserved but ignored for security");

      Status_Value :=
        SSH_Lib.Agent.Protocol.Parse_Identities_Answer
          (Two_Identities, Identities);
      Check_Status
        (Status_Value, CryptoLib.Errors.Ok, "phase8 multiple identities parse");
      Check
        (SSH_Lib.Agent.Count (Identities) = 2,
         "phase8 multiple identity count");
      Check
        (Same_Bytes
           (SSH_Lib.Agent.Public_Key_Blob (Identities, 1), Binary_Key),
         "phase8 first identity order preserved");
      Check
        (Same_Bytes
           (SSH_Lib.Agent.Public_Key_Blob (Identities, 2), Binary_Key_2),
         "phase8 second identity order preserved");

      Status_Value :=
        SSH_Lib.Agent.Protocol.Parse_Identities_Answer
          (Oversized_Identity_Count, Identities);
      Touch (Identities);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Authentication_Failed,
         "phase8 oversized identity count rejected");
      Status_Value :=
        SSH_Lib.Agent.Protocol.Parse_Identities_Answer
          (Truncated_Identity_Key, Identities);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Authentication_Failed,
         "phase8 truncated identity key rejected");

      declare
         Algorithm_Name : Unbounded_String;
      begin
         Status_Value :=
           SSH_Lib.Public_Key_Blobs.Algorithm_Name
             (Encoded_String (One_String ("ssh-ed25519")) & Binary_Key,
              Algorithm_Name);
         Check_Status
           (Status_Value,
            CryptoLib.Errors.Ok,
            "phase8 public key blob algorithm parsed");
         Check
           (To_String (Algorithm_Name) = "ssh-ed25519",
            "phase8 public key blob algorithm exact");
         Check
           (SSH_Lib.Public_Key_Blobs.Is_Default_Userauth_Algorithm
              ("ssh-ed25519"),
            "phase8 ed25519 default auth algorithm enabled");
         Check
           (SSH_Lib.Public_Key_Blobs.Is_Default_Userauth_Algorithm
              ("ecdsa-sha2-nistp256"),
            "phase209 ecdsa default auth algorithm enabled");
         Check
           (SSH_Lib.Public_Key_Blobs.Is_Default_Userauth_Algorithm
              ("ecdsa-sha2-nistp384"),
            "phase19 ecdsa p384 default auth algorithm enabled");
         Check
           (SSH_Lib.Public_Key_Blobs.Is_Default_Userauth_Algorithm
              ("ecdsa-sha2-nistp521"),
            "phase19 ecdsa p521 default auth algorithm enabled");
         Check
           (SSH_Lib.Public_Key_Blobs.Is_Default_Userauth_Algorithm
              ("ecdsa-sha2-nistp384-cert-v01@openssh.com"),
            "phase19 ecdsa p384 cert default auth algorithm enabled");
         Check
           (SSH_Lib.Public_Key_Blobs.Is_Default_Userauth_Algorithm
              ("ecdsa-sha2-nistp521-cert-v01@openssh.com"),
            "phase19 ecdsa p521 cert default auth algorithm enabled");
         Check
           (SSH_Lib.Public_Key_Blobs.Is_Default_Userauth_Algorithm
              ("rsa-sha2-256"),
            "phase8 rsa-sha2-256 default auth algorithm enabled");
         Check
           (SSH_Lib.Public_Key_Blobs.Is_Default_Userauth_Algorithm
              ("ssh-rsa"),
            "phase8 legacy ssh-rsa retained as last-resort auth fallback");
      end;

      Status_Value :=
        SSH_Lib.Agent.Protocol.Parse_Identities_Answer
          ([1 => SSH_Lib.Agent.Protocol.SSH_AGENT_FAILURE], Identities);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Authentication_Failed,
         "phase8 agent failure identities rejected");

      declare
         Sign_Request        :
           constant SSH_Lib.Protocol.Buffers.Packet_Buffer :=
             SSH_Lib.Agent.Protocol.Encode_Sign_Request
               (Binary_Key, Session_Id, "rsa-sha2-256");
         Legacy_Sign_Request :
           constant SSH_Lib.Protocol.Buffers.Packet_Buffer :=
             SSH_Lib.Agent.Protocol.Encode_Sign_Request
               (Binary_Key, Session_Id, "ssh-rsa");
         Request_Data        : constant Stream_Element_Array :=
           SSH_Lib.Protocol.Buffers.To_Array (Sign_Request);
      begin
         Check
           (Request_Data (Request_Data'First)
            = SSH_Lib.Agent.Protocol.SSH_AGENTC_SIGN_REQUEST,
            "phase8 sign request type");
         Check
           (SSH_Lib.Agent.Protocol.Signature_Flags_For ("ssh-ed25519") = 0,
            "phase8 ed25519 default sign flags");
         Check
           (SSH_Lib.Agent.Protocol.Signature_Flags_For ("rsa-sha2-256")
            = SSH_Lib.Agent.Protocol.SSH_AGENT_RSA_SHA2_256,
            "phase8 rsa sha2-256 sign flag");
         Check
           (SSH_Lib.Agent.Protocol.Signature_Flags_For ("rsa-sha2-512")
            = SSH_Lib.Agent.Protocol.SSH_AGENT_RSA_SHA2_512,
            "phase8 rsa sha2-512 sign flag");
         Check
           (SSH_Lib.Protocol.Buffers.Length (Legacy_Sign_Request) > 0,
            "phase8 legacy ssh-rsa sign request encoded as last-resort fallback");
      end;

      Status_Value :=
        SSH_Lib.Agent.Protocol.Parse_Sign_Response (Sign_Response, Signature);
      Check_Status
        (Status_Value, CryptoLib.Errors.Ok, "phase8 sign response parses");
      Check
        (Same_Bytes
           (SSH_Lib.Protocol.Buffers.To_Array (Signature),
            Signature_Blob_Data),
         "phase8 nested signature blob binary preserved");
      Status_Value :=
        SSH_Lib.Agent.Protocol.Parse_Sign_Response
          ([1 => SSH_Lib.Agent.Protocol.SSH_AGENT_FAILURE], Signature);
      Touch (Signature);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Authentication_Failed,
         "phase8 sign failure rejected");
      Status_Value :=
        SSH_Lib.Agent.Protocol.Parse_Sign_Response
          (Truncated_Sign_Response, Signature);
      Touch (Signature);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Authentication_Failed,
         "phase8 truncated sign response rejected");
      Status_Value :=
        SSH_Lib.Agent.Protocol.Parse_Sign_Response
          (Malformed_Nested_Sign_Response, Signature);
      Touch (Signature);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Authentication_Failed,
         "phase8 malformed nested signature blob rejected");
      Status_Value :=
        SSH_Lib.Agent.Protocol.Parse_Sign_Response
          (Legacy_Nested_Sign_Response, Signature);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Ok,
         "phase8 legacy nested ssh-rsa signature blob accepted as last-resort fallback");

      declare
         Service_Request         :
           constant SSH_Lib.Protocol.Buffers.Packet_Buffer :=
             SSH_Lib.Protocol.Service.Encode_Userauth_Service_Request;
         Invalid_Service_Request :
           constant SSH_Lib.Protocol.Buffers.Packet_Buffer :=
             SSH_Lib.Protocol.Service.Encode_Service_Request ("bad service");
         Service_Data            : constant Stream_Element_Array :=
           SSH_Lib.Protocol.Buffers.To_Array (Service_Request);
      begin
         Check
           (Service_Data (Service_Data'First)
            = SSH_Lib.Protocol.Service.SSH_MSG_SERVICE_REQUEST,
            "phase8 service request type");
         Check
           (SSH_Lib.Protocol.Buffers.Length (Invalid_Service_Request) = 0,
            "phase8 invalid service request name rejected before encoding");
      end;
      Check_Status
        (SSH_Lib.Protocol.Service.Parse_Service_Accept
           (Service_Accept, "ssh-userauth"),
         CryptoLib.Errors.Ok,
         "phase8 service accept accepted");
      Check_Status
        (SSH_Lib.Protocol.Service.Parse_Service_Accept
           (Wrong_Service_Accept, "ssh-userauth"),
         CryptoLib.Errors.Handshake_Failed,
         "phase8 wrong service rejected");
      Check_Status
        (SSH_Lib.Protocol.Service.Parse_Service_Accept
           (Extra_Service_Accept, "ssh-userauth"),
         CryptoLib.Errors.Handshake_Failed,
         "phase8 service accept with trailing data rejected");

      declare
         Test_Request              :
           constant SSH_Lib.Protocol.Buffers.Packet_Buffer :=
             SSH_Lib.Protocol.Userauth.Encode_Publickey_Test_Request
               ("git", "ssh-ed25519", Binary_Key);
         Signed_Payload            :
           constant SSH_Lib.Protocol.Buffers.Packet_Buffer :=
             SSH_Lib.Protocol.Userauth.Build_Publickey_Signature_Payload
               (Session_Id, "git", "ssh-ed25519", Binary_Key);
         Signed_Request            :
           constant SSH_Lib.Protocol.Buffers.Packet_Buffer :=
             SSH_Lib.Protocol.Userauth.Encode_Publickey_Signed_Request
               ("git", "ssh-ed25519", Binary_Key, Signature_Data);
         Invalid_Algorithm_Request :
           constant SSH_Lib.Protocol.Buffers.Packet_Buffer :=
             SSH_Lib.Protocol.Userauth.Encode_Publickey_Test_Request
               ("git", "bad algorithm", Binary_Key);
         Empty_Session_Payload     :
           constant SSH_Lib.Protocol.Buffers.Packet_Buffer :=
             SSH_Lib.Protocol.Userauth.Build_Publickey_Signature_Payload
               (Empty_Binary, "git", "ssh-ed25519", Binary_Key);
         Empty_Signature_Request   :
           constant SSH_Lib.Protocol.Buffers.Packet_Buffer :=
             SSH_Lib.Protocol.Userauth.Encode_Publickey_Signed_Request
               ("git", "ssh-ed25519", Binary_Key, Empty_Binary);
         Password_Request          :
           constant SSH_Lib.Protocol.Buffers.Packet_Buffer :=
             SSH_Lib.Protocol.Userauth.Encode_Password_Request
               ("git", "fixture-password");
         Invalid_Password_Request  :
           constant SSH_Lib.Protocol.Buffers.Packet_Buffer :=
             SSH_Lib.Protocol.Userauth.Encode_Password_Request
               ("git", "bad" & Character'Val (10) & "password");
         Keyboard_Request          :
           constant SSH_Lib.Protocol.Buffers.Packet_Buffer :=
             SSH_Lib.Protocol.Userauth.Encode_Keyboard_Interactive_Request
               ("git");
         Keyboard_Response         :
           constant SSH_Lib.Protocol.Buffers.Packet_Buffer :=
             SSH_Lib.Protocol.Userauth.Encode_Keyboard_Interactive_Response
               ("fixture-password");
         Invalid_Keyboard_Response :
           constant SSH_Lib.Protocol.Buffers.Packet_Buffer :=
             SSH_Lib.Protocol.Userauth.Encode_Keyboard_Interactive_Response
               ("bad" & Character'Val (10) & "password");
         Test_Data                 : constant Stream_Element_Array :=
           SSH_Lib.Protocol.Buffers.To_Array (Test_Request);
         Payload_Data              : constant Stream_Element_Array :=
           SSH_Lib.Protocol.Buffers.To_Array (Signed_Payload);
         Signed_Data               : constant Stream_Element_Array :=
           SSH_Lib.Protocol.Buffers.To_Array (Signed_Request);
         Password_Data             : constant Stream_Element_Array :=
           SSH_Lib.Protocol.Buffers.To_Array (Password_Request);
         Keyboard_Data             : constant Stream_Element_Array :=
           SSH_Lib.Protocol.Buffers.To_Array (Keyboard_Request);
         Keyboard_Response_Data    : constant Stream_Element_Array :=
           SSH_Lib.Protocol.Buffers.To_Array (Keyboard_Response);
      begin
         Check
           (Test_Data (Test_Data'First)
            = SSH_Lib.Protocol.Userauth.SSH_MSG_USERAUTH_REQUEST,
            "phase8 publickey test request type");
         Check
           (Test_Data (Test_Data'First + 1 + 4 + 3 + 4 + 14 + 4 + 9) = 0,
            "phase8 publickey preflight boolean false");
         Check
           (Payload_Data (Payload_Data'First + 4 + Session_Id'Length)
            = SSH_Lib.Protocol.Userauth.SSH_MSG_USERAUTH_REQUEST,
            "phase8 signed payload starts with session identifier string then request byte");
         Check
           (Signed_Data (Signed_Data'First + 1 + 4 + 3 + 4 + 14 + 4 + 9) = 1,
            "phase8 signed request boolean true");
         Check
           (SSH_Lib.Protocol.Buffers.Length (Invalid_Algorithm_Request) = 0,
            "phase8 invalid userauth algorithm not encoded");
         Check
           (SSH_Lib.Protocol.Buffers.Length (Empty_Session_Payload) = 0,
            "phase8 empty session identifier not encoded for signature payload");
         Check
           (SSH_Lib.Protocol.Buffers.Length (Empty_Signature_Request) = 0,
            "phase8 signed userauth request requires signature blob");
         Check
           (Password_Data (Password_Data'First)
            = SSH_Lib.Protocol.Userauth.SSH_MSG_USERAUTH_REQUEST,
            "phase8 password request type");
         Check
           (Password_Data (Password_Data'First + 1 + 4 + 3 + 4 + 14 + 4)
            = Stream_Element (Character'Pos ('p')),
            "phase8 password request method is password");
         Check
           (SSH_Lib.Protocol.Buffers.Length (Invalid_Password_Request) = 0,
            "phase8 invalid password text not encoded");
         Check
           (Keyboard_Data (Keyboard_Data'First)
            = SSH_Lib.Protocol.Userauth.SSH_MSG_USERAUTH_REQUEST,
            "phase262 keyboard-interactive request type");
         Check
           (Keyboard_Data (Keyboard_Data'First + 1 + 4 + 3 + 4 + 14 + 4)
            = Stream_Element (Character'Pos ('k')),
            "phase262 keyboard-interactive request method encoded");
         Check
           (Keyboard_Response_Data (Keyboard_Response_Data'First)
            = SSH_Lib.Protocol.Userauth.SSH_MSG_USERAUTH_INFO_RESPONSE,
            "phase262 keyboard-interactive response type");
         Check
           (SSH_Lib.Protocol.Buffers.Length (Invalid_Keyboard_Response) = 0,
            "phase262 invalid keyboard-interactive response text not encoded");
         declare
            Responses      :
              SSH_Lib.Protocol.Userauth.Keyboard_Interactive_Response_Array :=
                [others => Ada.Strings.Unbounded.Null_Unbounded_String];
            Multi_Response : SSH_Lib.Protocol.Buffers.Packet_Buffer;
            Multi_Data     : Stream_Element_Array (1 .. 9);
         begin
            Responses (1) := Ada.Strings.Unbounded.To_Unbounded_String ("one");
            Responses (2) := Ada.Strings.Unbounded.To_Unbounded_String ("two");
            Multi_Response :=
              SSH_Lib.Protocol.Userauth.Encode_Keyboard_Interactive_Responses
                (2, Responses);
            Multi_Data :=
              SSH_Lib.Protocol.Buffers.To_Array (Multi_Response) (1 .. 9);
            Check
              (Multi_Data (Multi_Data'First)
               = SSH_Lib.Protocol.Userauth.SSH_MSG_USERAUTH_INFO_RESPONSE,
               "phase262 multi keyboard-interactive response type");
            Check
              (Multi_Data (Multi_Data'First + 4) = 2,
               "phase262 multi keyboard-interactive response count encoded");
         end;
      end;

      Status_Value :=
        SSH_Lib.Protocol.Userauth.Parse_Userauth_Reply
          (Success_Reply, SSH_Lib.Protocol.Userauth.Signed_Reply, Reply_Value);
      Check_Status
        (Status_Value, CryptoLib.Errors.Ok, "phase8 success reply parses");
      Check
        (Reply_Value.Kind = SSH_Lib.Protocol.Userauth.Auth_Success,
         "phase8 success kind");

      Status_Value :=
        SSH_Lib.Protocol.Userauth.Parse_Userauth_Reply
          (Failure_Reply, SSH_Lib.Protocol.Userauth.Signed_Reply, Reply_Value);
      Check_Status
        (Status_Value, CryptoLib.Errors.Ok, "phase8 failure reply parses");
      Check
        (Reply_Value.Kind = SSH_Lib.Protocol.Userauth.Auth_Failure,
         "phase8 failure kind");
      Check
        (SSH_Lib.Protocol.Auth_Methods.Contains_Publickey
           (Reply_Value.Failure),
         "phase8 failure methods include publickey");
      Check
        (not Reply_Value.Failure.Partial_Success,
         "phase8 partial success false not complete auth");

      Status_Value :=
        SSH_Lib.Protocol.Userauth.Parse_Userauth_Reply
          (Partial_Failure_Reply,
           SSH_Lib.Protocol.Userauth.Signed_Reply,
           Reply_Value);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Ok,
         "phase8 partial success failure parses");
      Check
        (Reply_Value.Kind = SSH_Lib.Protocol.Userauth.Auth_Failure,
         "phase8 partial success remains failure kind");
      Check
        (Reply_Value.Failure.Partial_Success,
         "phase8 partial success recorded but not complete auth");

      Status_Value :=
        SSH_Lib.Protocol.Userauth.Parse_Userauth_Reply
          (Malformed_Failure_Reply,
           SSH_Lib.Protocol.Userauth.Signed_Reply,
           Reply_Value);
      Touch (Reply_Value);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Authentication_Failed,
         "phase8 malformed failure reply rejected");
      Status_Value :=
        SSH_Lib.Protocol.Userauth.Parse_Userauth_Reply
          ([1 => 99], SSH_Lib.Protocol.Userauth.Signed_Reply, Reply_Value);
      Touch (Reply_Value);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Authentication_Failed,
         "phase8 unexpected userauth message rejected");

      Status_Value :=
        SSH_Lib.Protocol.Userauth.Parse_Userauth_Reply
          (Banner_Reply, SSH_Lib.Protocol.Userauth.Signed_Reply, Reply_Value);
      Check_Status
        (Status_Value, CryptoLib.Errors.Ok, "phase8 banner safely ignored");
      Check
        (Reply_Value.Kind = SSH_Lib.Protocol.Userauth.Auth_Banner,
         "phase8 banner kind");

      Status_Value :=
        SSH_Lib.Protocol.Userauth.Parse_Userauth_Reply
          (Pk_Ok_Reply,
           SSH_Lib.Protocol.Userauth.Preflight_Reply,
           Reply_Value);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Ok,
         "phase8 pk ok accepted during preflight");
      Check
        (Ada.Strings.Unbounded.To_String (Reply_Value.Public_Key_Algorithm)
         = "ssh-ed25519",
         "phase8 pk ok algorithm parsed");
      Check
        (Same_Bytes
           (SSH_Lib.Protocol.Buffers.To_Array (Reply_Value.Public_Key_Blob),
            Binary_Key),
         "phase8 pk ok key blob preserved");
      Status_Value :=
        SSH_Lib.Protocol.Userauth.Parse_Userauth_Reply
          (Pk_Ok_Trailing_Reply,
           SSH_Lib.Protocol.Userauth.Preflight_Reply,
           Reply_Value);
      Touch (Reply_Value);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Authentication_Failed,
         "phase8 pk ok trailing data rejected");
      Status_Value :=
        SSH_Lib.Protocol.Userauth.Parse_Userauth_Reply
          (Pk_Ok_Bad_Algorithm_Reply,
           SSH_Lib.Protocol.Userauth.Preflight_Reply,
           Reply_Value);
      Touch (Reply_Value);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Authentication_Failed,
         "phase8 pk ok non-ascii algorithm rejected");
      Status_Value :=
        SSH_Lib.Protocol.Userauth.Parse_Userauth_Reply
          (Pk_Ok_Empty_Key_Reply,
           SSH_Lib.Protocol.Userauth.Preflight_Reply,
           Reply_Value);
      Touch (Reply_Value);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Authentication_Failed,
         "phase8 pk ok empty key blob rejected");
      Status_Value :=
        SSH_Lib.Protocol.Userauth.Parse_Userauth_Reply
          (Pk_Ok_Reply, SSH_Lib.Protocol.Userauth.Signed_Reply, Reply_Value);
      Touch (Reply_Value);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Authentication_Failed,
         "phase8 pk ok rejected after signed request");

      Status_Value :=
        SSH_Lib.Protocol.Userauth.Parse_Userauth_Reply
          (Keyboard_Info_Request,
           SSH_Lib.Protocol.Userauth.Keyboard_Interactive_Reply,
           Reply_Value);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Ok,
         "phase262 keyboard-interactive info request parses");
      Check
        (Reply_Value.Kind
         = SSH_Lib.Protocol.Userauth.Keyboard_Interactive_Info_Request,
         "phase262 keyboard-interactive info request kind recorded");
      Check
        (Reply_Value.Keyboard_Interactive_Prompts = 1
         and then Reply_Value.Keyboard_Interactive_Echoes = 0,
         "phase262 keyboard-interactive hidden prompt count recorded");
      Check
        (Ada.Strings.Unbounded.To_String
           (Reply_Value.Keyboard_Interactive_Name)
         = "login"
         and then
           Ada.Strings.Unbounded.To_String
             (Reply_Value.Keyboard_Interactive_Instruction)
           = "enter password"
         and then
           Ada.Strings.Unbounded.To_String
             (Reply_Value.Keyboard_Interactive_Prompt_Items (1).Text)
           = "Password: "
         and then not Reply_Value.Keyboard_Interactive_Prompt_Items (1).Echo,
         "phase262 keyboard-interactive prompt details retained");

      Status_Value :=
        SSH_Lib.Protocol.Userauth.Parse_Userauth_Reply
          (Keyboard_Echo_Info_Request,
           SSH_Lib.Protocol.Userauth.Keyboard_Interactive_Reply,
           Reply_Value);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Ok,
         "phase262 keyboard-interactive echo prompt parses for caller policy");
      Check
        (Reply_Value.Keyboard_Interactive_Prompts = 1
         and then Reply_Value.Keyboard_Interactive_Echoes = 1,
         "phase262 keyboard-interactive echo prompt count recorded");

      Status_Value :=
        SSH_Lib.Protocol.Userauth.Parse_Userauth_Reply
          (Keyboard_Two_Prompt_Request,
           SSH_Lib.Protocol.Userauth.Keyboard_Interactive_Reply,
           Reply_Value);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Ok,
         "phase262 keyboard-interactive multi-prompt parses for caller policy");
      Check
        (Reply_Value.Keyboard_Interactive_Prompts = 2
         and then Reply_Value.Keyboard_Interactive_Echoes = 0,
         "phase262 keyboard-interactive multi-prompt count recorded");
      Check
        (Ada.Strings.Unbounded.To_String
           (Reply_Value.Keyboard_Interactive_Prompt_Items (1).Text)
         = "Password: "
         and then
           Ada.Strings.Unbounded.To_String
             (Reply_Value.Keyboard_Interactive_Prompt_Items (2).Text)
           = "OTP: ",
         "phase262 keyboard-interactive multi-prompt text retained");

      Status_Value :=
        SSH_Lib.Protocol.Userauth.Parse_Userauth_Reply
          (Keyboard_Info_Request,
           SSH_Lib.Protocol.Userauth.Signed_Reply,
           Reply_Value);
      Touch (Reply_Value);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Authentication_Failed,
         "phase262 keyboard-interactive info request rejected in signed context");

      Status_Value :=
        SSH_Lib.Protocol.Userauth.Parse_Userauth_Reply
          (Keyboard_Malformed_Request,
           SSH_Lib.Protocol.Userauth.Keyboard_Interactive_Reply,
           Reply_Value);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Authentication_Failed,
         "phase262 keyboard-interactive trailing data rejected");

      Options.Host := To_Unbounded_String ("example.com");
      Options.User := To_Unbounded_String ("git");
      Options.Port := 22;
      Options.Use_Agent := False;
      Options.Identity_File := Null_Unbounded_String;
      Status_Value := SSH_Lib.Sessions.Open (Options, Session_Item);
      Touch (Session_Item);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Authentication_Failed,
         "phase8 use_agent false without identity fails auth");

      Options.Use_Agent := True;
      SSH_Lib.Platform.Environment.Set_Value_For_Test ("OTHER_ENV", "ignored");
      Status_Value := SSH_Lib.Sessions.Open (Options, Session_Item);
      Touch (Session_Item);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Connection_Failed,
         "phase10 missing SSH_AUTH_SOCK reaches connection boundary");
      SSH_Lib.Platform.Environment.Set_Value_For_Test ("SSH_AUTH_SOCK", "");
      Status_Value := SSH_Lib.Sessions.Open (Options, Session_Item);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Connection_Failed,
         "phase10 empty SSH_AUTH_SOCK is not probed before encrypted boundary");
      Options.Identity_File := To_Unbounded_String ("/tmp/id_ed25519");
      Status_Value := SSH_Lib.Sessions.Open (Options, Session_Item);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Connection_Failed,
         "phase10 identity file is not parsed before encrypted boundary");
      Options.Identity_File := Null_Unbounded_String;
      SSH_Lib.Platform.Environment.Set_Value_For_Test
        ("SSH_AUTH_SOCK", "/tmp/ssh_lib_agent.sock");
      Status_Value := SSH_Lib.Sessions.Open (Options, Session_Item);
      Touch (Session_Item);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Connection_Failed,
         "phase8 agent socket transport isolated reaches connection boundary");
      SSH_Lib.Platform.Environment.Reset_Provider;

      Status_Value := SSH_Lib.Agent.Transport.Connect ("", Agent_Link);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Connection_Failed,
         "phase8 empty socket path connection failed");
      Status_Value :=
        SSH_Lib.Agent.Transport.Connect
          ("/tmp/ssh_lib_agent.sock", Agent_Link);
      Check
        (Status_Value = CryptoLib.Errors.Connection_Failed
         or else Status_Value = CryptoLib.Errors.Ok,
         "phase8 Unix socket backend either connects or fails deterministically");
      if Status_Value = CryptoLib.Errors.Ok then
         Status_Value := SSH_Lib.Agent.Transport.Close (Agent_Link);
         Check_Status
           (Status_Value,
            CryptoLib.Errors.Ok,
            "phase8 close connected agent transport before closed-state checks");
      end if;
      Status_Value :=
        SSH_Lib.Agent.Transport.Send_Message (Agent_Link, Empty_Request);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Write_Failed,
         "phase8 send on closed agent transport write failed");
      Status_Value :=
        SSH_Lib.Agent.Transport.Receive_Message (Agent_Link, Signature);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Read_Failed,
         "phase8 receive on closed agent transport read failed");
      Status_Value := SSH_Lib.Agent.Transport.Close (Agent_Link);
      Check_Status
        (Status_Value, CryptoLib.Errors.Ok, "phase8 agent close idempotent");
   end Run_Phase_8_Agent_Userauth_Tests;

