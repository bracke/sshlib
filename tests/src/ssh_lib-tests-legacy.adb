            Mac_512_Key,
            Key_Data,
            IV_Data,
            Key_Data,
            IV_Data);
         Check
           (SSH_Lib.Protocol.Protected_Packets.Outbound_Header_Is_Clear
              (Encode_State),
            "phase19 EtM outbound packet length remains clear");
         Check
           (SSH_Lib.Protocol.Protected_Packets.Inbound_Header_Is_Clear
              (Decode_State),
            "phase19 EtM inbound packet length remains clear");
         Result_Status :=
           SSH_Lib.Protocol.Protected_Packets.Encode_Protected_Packet
             (Encode_State, Payload_Data, Packet_Buffer, True, 16#22#);
         Check_Status
           (Result_Status,
            CryptoLib.Errors.Ok,
            "phase19 aes256/hmac512-etm protected packet encode");
         declare
            Wire_Data : constant Ada.Streams.Stream_Element_Array :=
              SSH_Lib.Protocol.Buffers.To_Array (Packet_Buffer);
         begin
            Check
              (Wire_Data (Wire_Data'First) = 0
               and then Wire_Data (Wire_Data'First + 1) = 0
               and then Wire_Data (Wire_Data'First + 2) = 0,
               "phase19 EtM wire header keeps high length bytes clear");
            Check
              (Wire_Data (Wire_Data'First + 3) /= 0,
               "phase19 EtM wire header carries a clear packet length");
         end;
         Result_Status :=
           SSH_Lib.Protocol.Protected_Packets.Decode_Protected_Packet
             (Decode_State,
              SSH_Lib.Protocol.Buffers.To_Array (Packet_Buffer),
              Payload_Buffer);
         Check_Status
           (Result_Status,
            CryptoLib.Errors.Ok,
            "phase19 aes256/hmac512-etm protected packet decode");
         Check
           (SSH_Lib.Protocol.Buffers.To_Array (Payload_Buffer) = Payload_Data,
            "phase19 aes256/hmac512-etm protected packet preserves binary payload");
