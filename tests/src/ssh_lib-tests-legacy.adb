         declare
            Stored_Commit_Data :
              constant Ada.Streams.Stream_Element_Array :=
                Bytes_From_String ("tree ")
                & Stored_Tree_Hex
                & Bytes_From_String
                    (Character'Val (10)
                     & "author A <a@example.test> 0 +0000"
                     & Character'Val (10)
                     & "committer A <a@example.test> 0 +0000"
                     & Character'Val (10)
                     & Character'Val (10)
                     & "message"
                     & Character'Val (10));
         begin
            Status_Value :=
              SSH_Lib.Git.Store_Loose_Object_Validated
                (Repo_Root,
                 SSH_Lib.Git.Pack_Commit,
                 Stored_Commit_Data,
                 Stored_Commit_Hex,
