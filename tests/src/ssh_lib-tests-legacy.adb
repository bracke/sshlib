           "fixture-host",
           22,
           SSH_Lib.Tests.Fixtures.Known_Hosts.Fixture_Host_Key);
      Check
        (Verification = SSH_Lib.Known_Hosts.Trusted,
         "phase16 fixture known_hosts matching host trusted");

      Verification :=
        SSH_Lib.Known_Hosts.Verify
          (Known_Path,
           "fixture-host",
           2222,
           SSH_Lib.Tests.Fixtures.Known_Hosts.Fixture_Host_Key);
      Check
        (Verification = SSH_Lib.Known_Hosts.Unknown,
         "phase16 fixture bare host does not trust nonstandard port");

      SSH_Lib.Tests.Fixtures.Known_Hosts.Write_Changed_File
        (Changed_Path, "fixture-host", 22);
      Verification :=
        SSH_Lib.Known_Hosts.Verify
          (Changed_Path,
           "fixture-host",
           22,
           SSH_Lib.Tests.Fixtures.Known_Hosts.Fixture_Host_Key);
      Check
        (Verification = SSH_Lib.Known_Hosts.Mismatch,
         "phase16 fixture changed host key reports mismatch");
      SSH_Lib.Tests.Assertions.Check_Status
        (SSH_Lib.Known_Hosts.To_Status (Verification),
         CryptoLib.Errors.Host_Key_Mismatch,
         "phase16 changed known_hosts maps to public status",
         "host-key-mismatch");

      SSH_Lib.Tests.Fixtures.Known_Hosts.Write_Matching_File
        (Changed_Path, "fixture-host", 2222);
      Verification :=
        SSH_Lib.Known_Hosts.Verify
          (Changed_Path,
           "fixture-host",
           2222,
           SSH_Lib.Tests.Fixtures.Known_Hosts.Fixture_Host_Key);
      Check
        (Verification = SSH_Lib.Known_Hosts.Trusted,
         "phase16 fixture bracketed host-port entry trusted exactly");
      Verification :=
        SSH_Lib.Known_Hosts.Verify
          (Changed_Path,
           "fixture-host",
           22,
           SSH_Lib.Tests.Fixtures.Known_Hosts.Fixture_Host_Key);
      Check
        (Verification = SSH_Lib.Known_Hosts.Unknown,
         "phase16 fixture bracketed host-port entry does not trust default port");

      Ada.Text_IO.Create (Output_File, Ada.Text_IO.Out_File, Changed_Path);
      Ada.Text_IO.Put_Line
        (Output_File, "malformed unrelated line ignored safely");
      Ada.Text_IO.Close (Output_File);
      Verification :=
        SSH_Lib.Known_Hosts.Verify
          (Changed_Path,
           "fixture-host",
           22,
           SSH_Lib.Tests.Fixtures.Known_Hosts.Fixture_Host_Key);
      Check
        (Verification = SSH_Lib.Known_Hosts.Unknown,
         "phase16 fixture malformed unrelated known_hosts line ignored");

      if Ada.Directories.Exists (Changed_Path) then
         Ada.Directories.Delete_File (Changed_Path);
      end if;
      Verification :=
        SSH_Lib.Known_Hosts.Verify
          (Changed_Path,
           "fixture-host",
           22,
           SSH_Lib.Tests.Fixtures.Known_Hosts.Fixture_Host_Key);
      Check
        (Verification = SSH_Lib.Known_Hosts.Unknown,
         "phase16 fixture missing known_hosts file is unknown");
      Ada.Text_IO.Create (Output_File, Ada.Text_IO.Out_File, Changed_Path);
      Ada.Text_IO.Close (Output_File);
      Verification :=
        SSH_Lib.Known_Hosts.Verify
          (Changed_Path,
           "fixture-host",
           22,
           SSH_Lib.Tests.Fixtures.Known_Hosts.Fixture_Host_Key);
      Check
        (Verification = SSH_Lib.Known_Hosts.Unknown,
         "phase16 fixture empty known_hosts file is unknown");

      Ada.Text_IO.Create (Output_File, Ada.Text_IO.Out_File, Changed_Path);
      Ada.Text_IO.Put_Line
        (Output_File,
         "*.fixture ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIFixtureUnsupportedPattern phase16-public-test-fixture");
      Ada.Text_IO.Close (Output_File);
      Verification :=
        SSH_Lib.Known_Hosts.Verify
          (Changed_Path,
           "repo.fixture",
           22,
           SSH_Lib.Tests.Fixtures.Known_Hosts.Fixture_Host_Key);
      Check
        (Verification = SSH_Lib.Known_Hosts.Unsupported_Entry,
