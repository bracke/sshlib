           (SSH_Lib.Channels.Test_Support.Last_Failure_For_Test (Channel_Item),
            CryptoLib.Errors.Write_Failed,
            "phase19 write after terminal result records write failure");
         Status_Value := SSH_Lib.Channels.Send_EOF (Channel_Item);
         Check_Status
           (Status_Value,
            CryptoLib.Errors.Channel_Request_Failed,
            "phase19 send-eof after remote terminal result rejected");
         Status_Value :=
           SSH_Lib.Channels.Exit_Status (Channel_Item, Exit_Code);
         Check_Status
           (Status_Value,
            CryptoLib.Errors.Ok,
            "phase19 terminal result remains observable after outbound rejection");
         Check
           (Exit_Code = 0,
            "phase19 outbound rejection preserves recorded remote exit status");
      end;

      SSH_Lib.Channels.Test_Support.Mark_Exec_Active_For_Test
        (Channel_Item,
         Local_Channel_Id           => 7,
         Remote_Channel_Id          => 9,
         Remote_Remaining_Window    => 64,
         Remote_Maximum_Packet_Size => 8);
      Status_Value := SSH_Lib.Channels.Send_EOF (Channel_Item);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Ok,
         "phase356 initial send eof before terminal status succeeds");
      SSH_Lib.Channels.Test_Support.Mark_Exit_Status_Known_For_Test
        (Channel_Item, 0);
      Status_Value := SSH_Lib.Channels.Send_EOF (Channel_Item);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Ok,
         "phase356 send eof remains idempotent after terminal status");

      SSH_Lib.Channels.Test_Support.Mark_Exec_Active_For_Test
        (Channel_Item,
         Local_Channel_Id           => 7,
         Remote_Channel_Id          => 9,
         Remote_Remaining_Window    => 64,
         Remote_Maximum_Packet_Size => 8);
      SSH_Lib.Channels.Test_Support.Set_Local_Window_For_Test
        (Channel_Item,
         Initial_Window_Size   =>
           SSH_Lib.Protocol.Channels.Default_Initial_Window_Size,
         Remaining_Window_Size =>
           SSH_Lib.Protocol.Channels.Window_Adjust_Threshold - 1);
      declare
         Close_From_Peer : constant Ada.Streams.Stream_Element_Array :=
           SSH_Lib.Protocol.Buffers.To_Array
             (SSH_Lib.Protocol.Channels.Encode_Channel_Close (7));
      begin
         Status_Value :=
           SSH_Lib.Channels.Test_Support.Dispatch_Inbound_Payload_For_Test
             (Channel_Item, Close_From_Peer);
         Check_Status
           (Status_Value,
            CryptoLib.Errors.Ok,
            "phase19 close does not send stale window-adjust");
         Check
           (SSH_Lib.Channels.Test_Support.Last_Close_Payload_For_Test
              (Channel_Item)'Length
            > 0,
            "phase19 close still prepares close acknowledgement");
         Check
           (SSH_Lib.Channels.Test_Support.Last_Window_Adjust_Payload_For_Test
              (Channel_Item)'Length
            = 0,
            "phase19 close leaves window-adjust buffer empty");
      end;

      SSH_Lib.Channels.Test_Support.Mark_Exec_Active_For_Test
        (Channel_Item,
         Local_Channel_Id           => 7,
         Remote_Channel_Id          => 9,
         Remote_Remaining_Window    => 64,
         Remote_Maximum_Packet_Size => 8);
      SSH_Lib.Channels.Test_Support.Set_Timeouts_For_Test
        (Channel_Item, Read_Timeout_MS => 30_000, Write_Timeout_MS => 0);
      declare
         Close_From_Peer : constant Ada.Streams.Stream_Element_Array :=
           SSH_Lib.Protocol.Buffers.To_Array
             (SSH_Lib.Protocol.Channels.Encode_Channel_Close (7));
      begin
         Status_Value :=
           SSH_Lib.Channels.Test_Support.Dispatch_Inbound_Payload_For_Test
             (Channel_Item, Close_From_Peer);
         Check_Status
           (Status_Value,
            CryptoLib.Errors.Timeout,
            "phase15 inbound close-reply send observes write timeout");
         Check
           (not SSH_Lib.Channels.Test_Support.Is_Dirty_For_Test (Channel_Item),
            "phase15 inbound close-reply pre-emission timeout keeps channel clean");
         Check
           (SSH_Lib.Channels.Test_Support.Last_Close_Payload_For_Test
              (Channel_Item)'Length
            = 0,
            "phase15 inbound close-reply timeout retains no close packet");
         Check_Status
           (SSH_Lib.Channels.Test_Support.Last_Failure_For_Test (Channel_Item),
            CryptoLib.Errors.Timeout,
            "phase15 inbound close-reply timeout records timeout cause");
         Status_Value := SSH_Lib.Channels.Write (Channel_Item, Binary_Data);
         Check_Status
           (Status_Value,
            CryptoLib.Errors.Write_Failed,
            "phase15 write after inbound close-reply timeout remains rejected");
         Status_Value := SSH_Lib.Channels.Close (Channel_Item);
         Check_Status
           (Status_Value,
            CryptoLib.Errors.Ok,
            "phase15 close after inbound close-reply timeout performs local cleanup");
      end;

      SSH_Lib.Channels.Test_Support.Mark_Exec_Active_For_Test
        (Channel_Item,
         Local_Channel_Id           => 7,
         Remote_Channel_Id          => 9,
         Remote_Remaining_Window    => 64,
         Remote_Maximum_Packet_Size => 8);
      SSH_Lib.Channels.Test_Support.Set_Close_Timeout_For_Test
        (Channel_Item, True);
      Status_Value := SSH_Lib.Channels.Close (Channel_Item);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Ok,
         "phase15 graceful close send timeout still returns ok after local cleanup");
      Check
        (SSH_Lib.Channels.Test_Support.Last_Close_Payload_For_Test
           (Channel_Item)'Length
         = 0,
         "phase15 close timeout does not retain an ambiguous close packet");
      Check
        (not SSH_Lib.Channels.Test_Support.Is_Dirty_For_Test (Channel_Item),
         "phase15 close timeout cleanup leaves closed handle non-dirty");
      Check_Status
        (SSH_Lib.Channels.Test_Support.Last_Failure_For_Test (Channel_Item),
         CryptoLib.Errors.Timeout,
         "phase15 close timeout records cleanup send timeout cause");

      SSH_Lib.Channels.Test_Support.Mark_Exec_Active_For_Test
        (Channel_Item,
         Local_Channel_Id           => 7,
         Remote_Channel_Id          => 9,
         Remote_Remaining_Window    => 64,
         Remote_Maximum_Packet_Size => 8);
      SSH_Lib.Channels.Test_Support.Set_Timeouts_For_Test
        (Channel_Item, Read_Timeout_MS => 30_000, Write_Timeout_MS => 0);
      Status_Value := SSH_Lib.Channels.Close (Channel_Item);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Ok,
         "phase15 immediate close deadline still performs local cleanup");
      Check
        (SSH_Lib.Channels.Test_Support.Last_Close_Payload_For_Test
           (Channel_Item)'Length
         = 0,
         "phase15 immediate close deadline does not expose partial close send state");
      Check_Status
        (SSH_Lib.Channels.Test_Support.Last_Failure_For_Test (Channel_Item),
         CryptoLib.Errors.Timeout,
         "phase15 immediate close deadline records timeout cause");
   end Run_Phase_15_Failure_Hygiene_Tests;

   procedure Run_Phase_19_Open_Option_Preflight_Tests is
      function Base_Options return SSH_Lib.Sessions.Session_Options is
         Result : SSH_Lib.Sessions.Session_Options;
      begin
         Result.Host := To_Unbounded_String ("example.com");
         Result.User := To_Unbounded_String ("git");
         Result.Use_Agent := True;
         return Result;
      end Base_Options;

      Options_Item : SSH_Lib.Sessions.Session_Options;
   begin
      Options_Item := Base_Options;
      Options_Item.Host_Key_Alias :=
        To_Unbounded_String ("trusted" & Character'Val (10) & "alias");
      Check_Status
        (SSH_Lib.Sessions.Open_Pipeline.Validate_Options (Options_Item),
         CryptoLib.Errors.Host_Key_Unknown,
         "phase19 host-key alias newline rejected before trust lookup");

      Options_Item := Base_Options;
      Options_Item.Preferred_Authentications :=
        To_Unbounded_String ("publickey,,password");
      Check_Status
        (SSH_Lib.Sessions.Open_Pipeline.Validate_Options (Options_Item),
         CryptoLib.Errors.Unsupported_Feature,
         "phase19 preferred-auth empty name-list element rejected");

      Options_Item := Base_Options;
      Options_Item.Allowed_Certificate_Critical_Options :=
        To_Unbounded_String ("force-command,source-address");
      Check_Status
        (SSH_Lib.Sessions.Open_Pipeline.Validate_Options (Options_Item),
         CryptoLib.Errors.Ok,
         "phase19 critical-option allow-list accepts normal SSH names");

      Options_Item := Base_Options;
      Options_Item.Allowed_Certificate_Critical_Options :=
        To_Unbounded_String ("force-command,");
      Check_Status
        (SSH_Lib.Sessions.Open_Pipeline.Validate_Options (Options_Item),
         CryptoLib.Errors.Unsupported_Feature,
         "phase19 critical-option allow-list trailing comma rejected");

      Options_Item := Base_Options;
      Options_Item.Gex_Minimum_Bits := 4096;
      Options_Item.Gex_Preferred_Bits := 2048;
      Options_Item.Gex_Maximum_Bits := 8192;
      Check_Status
        (SSH_Lib.Sessions.Open_Pipeline.Validate_Options (Options_Item),
         CryptoLib.Errors.Handshake_Failed,
         "phase19 invalid group-exchange bounds rejected at open preflight");

      Options_Item := Base_Options;
      Options_Item.Kex_Algorithms := To_Unbounded_String ("ext-info-c");
      Check_Status
        (SSH_Lib.Sessions.Open_Pipeline.Validate_Options (Options_Item),
         CryptoLib.Errors.Unsupported_Feature,
         "phase19 extension-only kex list rejected before public network handshake");

      Options_Item := Base_Options;
      Options_Item.Cipher_Algorithms :=
        To_Unbounded_String ("aes128-ctr,unknown-cipher@example.com");
      Check_Status
        (SSH_Lib.Sessions.Open_Pipeline.Validate_Options (Options_Item),
         CryptoLib.Errors.Ok,
         "phase19 configured cipher list accepted when at least one usable primitive remains");

      Options_Item := Base_Options;
      Options_Item.Mac_Algorithms :=
        To_Unbounded_String ("umac-64@openssh.com,umac-128@openssh.com");
      Check_Status
        (SSH_Lib.Sessions.Open_Pipeline.Validate_Options (Options_Item),
         CryptoLib.Errors.Ok,
         "phase19 configured UMAC-only mac list accepted after native UMAC implementation");

      Options_Item := Base_Options;
      Options_Item.Compression_Algorithms :=
        To_Unbounded_String ("delayed-zstd@example.com");
      Check_Status
        (SSH_Lib.Sessions.Open_Pipeline.Validate_Options (Options_Item),
         CryptoLib.Errors.Unsupported_Feature,
         "phase19 configured compression list rejected when no implemented method remains");

      Options_Item := Base_Options;
      Options_Item.Preferred_Authentications :=
        To_Unbounded_String ("hostbased,gssapi-with-mic");
      Check_Status
        (SSH_Lib.Sessions.Open_Pipeline.Validate_Options (Options_Item),
         CryptoLib.Errors.Unsupported_Feature,
         "phase19 preferred-auth list with only unimplemented methods is rejected");

      Options_Item := Base_Options;
      Options_Item.Preferred_Authentications :=
        To_Unbounded_String ("password");
      Check_Status
        (SSH_Lib.Sessions.Open_Pipeline.Validate_Options (Options_Item),
         CryptoLib.Errors.Ok,
         "phase19 preferred password syntax remains valid");
      Check_Status
        (SSH_Lib.Sessions.Open_Pipeline.Authentication_Configuration_Preflight
           (Options_Item),
         CryptoLib.Errors.Authentication_Failed,
         "phase19 preferred password excludes configured agent preflight");

      Options_Item := Base_Options;
      Options_Item.Identity_Agent := To_Unbounded_String ("none");
      Check_Status
        (SSH_Lib.Sessions.Open_Pipeline.Validate_Options (Options_Item),
         CryptoLib.Errors.Ok,
         "phase19 IdentityAgent none is accepted as a data-only agent-disable token");
      Check_Status
        (SSH_Lib.Sessions.Open_Pipeline.Authentication_Configuration_Preflight
           (Options_Item),
         CryptoLib.Errors.Authentication_Failed,
         "phase19 IdentityAgent none disables ssh-agent authentication preflight");

      Options_Item := Base_Options;
      Options_Item.Identity_Agent := To_Unbounded_String ("NONE");
      Check_Status
        (SSH_Lib.Sessions.Open_Pipeline.Validate_Options (Options_Item),
         CryptoLib.Errors.Ok,
         "phase19 IdentityAgent NONE is accepted as a case-insensitive disable token");
      Check_Status
        (SSH_Lib.Sessions.Open_Pipeline.Authentication_Configuration_Preflight
           (Options_Item),
         CryptoLib.Errors.Authentication_Failed,
         "phase19 IdentityAgent NONE disables ssh-agent authentication preflight");

      Options_Item := Base_Options;
      Options_Item.Use_Agent := False;
      Options_Item.Use_Password := True;
      Options_Item.Password := To_Unbounded_String ("secret");
      Options_Item.Preferred_Authentications :=
        To_Unbounded_String ("password");
      Check_Status
        (SSH_Lib.Sessions.Open_Pipeline.Validate_Options (Options_Item),
         CryptoLib.Errors.Ok,
         "phase19 explicit password satisfies password validation");
      Check_Status
        (SSH_Lib.Sessions.Open_Pipeline.Authentication_Configuration_Preflight
           (Options_Item),
         CryptoLib.Errors.Ok,
         "phase19 preferred password accepts configured password source");

      Options_Item := Base_Options;
      Options_Item.Use_Agent := False;
      Options_Item.Use_Password := True;
      Options_Item.Password := To_Unbounded_String ("secret");
      Options_Item.Preferred_Authentications :=
        To_Unbounded_String ("publickey");
      Check_Status
        (SSH_Lib.Sessions.Open_Pipeline.Authentication_Configuration_Preflight
           (Options_Item),
         CryptoLib.Errors.Authentication_Failed,
         "phase19 preferred publickey excludes configured password preflight");

      Options_Item := Base_Options;
      Options_Item.Use_Agent := False;
      Options_Item.Preferred_Authentications := To_Unbounded_String ("none");
      Check_Status
        (SSH_Lib.Sessions.Open_Pipeline.Validate_Options (Options_Item),
         CryptoLib.Errors.Ok,
         "phase19 preferred none is a structurally implemented auth method");
      Check_Status
        (SSH_Lib.Sessions.Open_Pipeline.Authentication_Configuration_Preflight
           (Options_Item),
         CryptoLib.Errors.Ok,
         "phase19 explicit preferred none may proceed to userauth service request");
   end Run_Phase_19_Open_Option_Preflight_Tests;

