      declare
         Encode_State   : SSH_Lib.Protocol.Protected_Packets.Protected_State;
         Decode_State   : SSH_Lib.Protocol.Protected_Packets.Protected_State;
         Packet_Buffer  : SSH_Lib.Protocol.Buffers.Packet_Buffer;
         Payload_Buffer : SSH_Lib.Protocol.Buffers.Packet_Buffer;
         Result_Status  : CryptoLib.Errors.Status;
      begin
         SSH_Lib.Protocol.Protected_Packets.Reset (Encode_State, Key_Data);
         SSH_Lib.Protocol.Protected_Packets.Reset (Decode_State, Key_Data);
         Result_Status :=
           SSH_Lib.Protocol.Protected_Packets.Encode_Protected_Packet
             (Encode_State, Payload_Data, Packet_Buffer, True, 16#AA#);
         Check_Status
           (Result_Status,
            CryptoLib.Errors.Ok,
            "phase19 protected bad MAC fixture encode");
         declare
            Tampered : Ada.Streams.Stream_Element_Array :=
              SSH_Lib.Protocol.Buffers.To_Array (Packet_Buffer);
         begin
            Tampered (Tampered'Last) := Tampered (Tampered'Last) xor 16#01#;
            Result_Status :=
              SSH_Lib.Protocol.Protected_Packets.Decode_Protected_Packet
                (Decode_State, Tampered, Payload_Buffer);
         end;
         Check_Status
           (Result_Status,
            CryptoLib.Errors.Handshake_Failed,
            "phase19 bad MAC rejected by fixture path");
         Check
           (SSH_Lib.Protocol.Protected_Packets.Is_Dirty (Decode_State),
            "phase19 bad MAC dirties fixture state");
         Check_Status
           (SSH_Lib.Protocol.Protected_Packets.Last_Failure (Decode_State),
            CryptoLib.Errors.Handshake_Failed,
            "phase19 bad MAC records failure");
         Result_Status :=
           SSH_Lib.Protocol.Protected_Packets.Decode_Protected_Packet
             (Decode_State,
              SSH_Lib.Protocol.Buffers.To_Array (Packet_Buffer),
              Payload_Buffer);
         Check_Status
           (Result_Status,
            CryptoLib.Errors.Read_Failed,
            "phase19 protected packet after dirty state rejected");
      end;

      declare
         Encode_State   : SSH_Lib.Protocol.Protected_Packets.Protected_State;
         Decode_State   : SSH_Lib.Protocol.Protected_Packets.Protected_State;
         Packet_Buffer  : SSH_Lib.Protocol.Buffers.Packet_Buffer;
         Payload_Buffer : SSH_Lib.Protocol.Buffers.Packet_Buffer;
         Result_Status  : CryptoLib.Errors.Status;
      begin
         SSH_Lib.Protocol.Protected_Packets.Reset (Encode_State, Key_Data);
         SSH_Lib.Protocol.Protected_Packets.Reset (Decode_State, Key_Data);
         SSH_Lib.Protocol.Protected_Packets.Set_Sequences_For_Test
           (Decode_State, Inbound_Value => 1, Outbound_Value => 0);
         Result_Status :=
           SSH_Lib.Protocol.Protected_Packets.Encode_Protected_Packet
             (Encode_State, Payload_Data, Packet_Buffer, True, 16#AA#);
         Check_Status
           (Result_Status,
            CryptoLib.Errors.Ok,
            "phase19 wrong sequence fixture encode");
         Result_Status :=
           SSH_Lib.Protocol.Protected_Packets.Decode_Protected_Packet
             (Decode_State,
              SSH_Lib.Protocol.Buffers.To_Array (Packet_Buffer),
              Payload_Buffer);
         Check_Status
           (Result_Status,
            CryptoLib.Errors.Handshake_Failed,
            "phase19 wrong sequence MAC rejected");
         Check
           (SSH_Lib.Protocol.Protected_Packets.Is_Dirty (Decode_State),
            "phase19 wrong sequence MAC dirties state");
      end;

      declare
         Clear_State      : SSH_Lib.Protocol.Packets.Protocol_State;
         Decode_State     : SSH_Lib.Protocol.Protected_Packets.Protected_State;
         Clear_Packet     : SSH_Lib.Protocol.Buffers.Packet_Buffer;
         Protected_Packet : SSH_Lib.Protocol.Buffers.Packet_Buffer;
         Payload_Buffer   : SSH_Lib.Protocol.Buffers.Packet_Buffer;
         Result_Status    : CryptoLib.Errors.Status;
      begin
         SSH_Lib.Protocol.Packets.Reset (Clear_State);
         SSH_Lib.Protocol.Protected_Packets.Reset (Decode_State, Key_Data);
         Result_Status :=
           SSH_Lib.Protocol.Packets.Encode_Cleartext_Packet
             (Clear_State, Payload_Data, Clear_Packet, True, 16#AA#);
         Check_Status
           (Result_Status,
            CryptoLib.Errors.Ok,
            "phase19 invalid padding clear fixture encode");
         declare
            Tampered_Clear : Ada.Streams.Stream_Element_Array :=
              SSH_Lib.Protocol.Buffers.To_Array (Clear_Packet);
         begin
            Tampered_Clear (Tampered_Clear'First + 4) := 1;
            Result_Status :=
              SSH_Lib
                .Protocol
                .Protected_Packets
                .Test_Support
                .Attach_Inbound_Mac
                   (Decode_State, Tampered_Clear, Protected_Packet);
         end;
         Check_Status
           (Result_Status,
            CryptoLib.Errors.Ok,
            "phase19 invalid padding fixture receives valid MAC");
         Result_Status :=
           SSH_Lib.Protocol.Protected_Packets.Decode_Protected_Packet
             (Decode_State,
              SSH_Lib.Protocol.Buffers.To_Array (Protected_Packet),
              Payload_Buffer);
         Check_Status
           (Result_Status,
            CryptoLib.Errors.Handshake_Failed,
            "phase19 invalid padding rejected after MAC check");
         Check
           (SSH_Lib.Protocol.Protected_Packets.Is_Dirty (Decode_State),
            "phase19 invalid padding dirties state");
      end;
   end Run_Phase_19_Packet_Protection_Fixture_Tests;

   procedure Run_Phase_15_Failure_Hygiene_Tests is
      Immediate_Deadline : constant SSH_Lib.Deadlines.Deadline :=
        SSH_Lib.Deadlines.From_Now (0);
      Long_Deadline      : constant SSH_Lib.Deadlines.Deadline :=
        SSH_Lib.Deadlines.From_Now (30_000);
      Cancel_Item        : SSH_Lib.Cancellation.Cancellation_State;
      Operation_Item     : SSH_Lib.Operation_Control.Operation_State;
      Session_Item       : SSH_Lib.Sessions.Session;
      Channel_Item       : SSH_Lib.Channels.Channel;
      Transport_Item     : SSH_Lib.Transport.Transport_Handle;
      Agent_Link         : SSH_Lib.Agent.Transport.Agent_Connection;
      Agent_Buffer       : SSH_Lib.Protocol.Buffers.Packet_Buffer;
      Identity_Item      : SSH_Lib.Identity_Files.Identity_Key;
      Retry_Item         : SSH_Lib.Protocol.Retry_State.Write_Attempt_State;
      Scenario_Item      : SSH_Lib.Testing.Failure_Injection.Failure_Scenario;
      Child_Operation    : SSH_Lib.Operation_Control.Operation_State;
      Status_Value       : CryptoLib.Errors.Status;
      Options            : SSH_Lib.Sessions.Session_Options;
      Read_Buffer        : Ada.Streams.Stream_Element_Array (1 .. 4);
      Last_Index         : Ada.Streams.Stream_Element_Offset;
      Exit_Code          : Integer := -1;
      Binary_Data        :
        constant Ada.Streams.Stream_Element_Array (1 .. 8) :=
          [1 => 16#00#,
           2 => 16#0A#,
           3 => 16#0D#,
           4 => 16#7F#,
           5 => 16#80#,
           6 => 16#FF#,
           7 => 16#11#,
           8 => 16#22#];
      Empty_Request      :
        constant Ada.Streams.Stream_Element_Array (1 .. 0) := [others => 0];
   begin
      Check
        (SSH_Lib.Deadlines.Expired (Immediate_Deadline),
         "phase15 zero timeout creates expired deadline");
      Check
        (SSH_Lib.Deadlines.Remaining_MS (Immediate_Deadline) = 0,
         "phase15 immediate deadline remaining is zero");
      Check
        (not SSH_Lib.Deadlines.Expired (Long_Deadline),
         "phase15 positive timeout is initially usable");
      Check
        (SSH_Lib.Deadlines.Remaining_MS (Long_Deadline) <= 30_000,
         "phase15 remaining time is bounded by source timeout");
      Check
        (SSH_Lib.Deadlines.Expired
           (SSH_Lib.Deadlines.Minimum (Immediate_Deadline, Long_Deadline)),
         "phase15 nested deadline keeps earliest boundary");
      Check
        (SSH_Lib.Deadlines.Expired (SSH_Lib.Timeouts.Connect_Deadline (0)),
         "phase15 connect timeout wrapper preserves immediate deadline");
      Check
        (SSH_Lib.Deadlines.Expired (SSH_Lib.Timeouts.Read_Deadline (0)),
         "phase15 read timeout wrapper preserves immediate deadline");
      Check
        (SSH_Lib.Deadlines.Expired (SSH_Lib.Timeouts.Write_Deadline (0)),
         "phase15 write timeout wrapper preserves immediate deadline");

      Options.Host := To_Unbounded_String ("example.com");
      Options.User := To_Unbounded_String ("git");
      Options.Port := 22;
      Options.Use_Agent := False;
      Options.Identity_File := Null_Unbounded_String;
      Options.Connect_Timeout_MS := 0;
      Options.Read_Timeout_MS := 30_000;
      Options.Write_Timeout_MS := 30_000;
      Status_Value := SSH_Lib.Sessions.Open (Options, Session_Item);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Authentication_Failed,
         "phase15 authentication preflight remains decisive before immediate timeout");
      Check_Status
        (SSH_Lib.Sessions.Test_Support.Last_Failure_For_Test (Session_Item),
         CryptoLib.Errors.Authentication_Failed,
         "phase15 failed open records authentication failure before timeout");

      Options.Use_Agent := True;
      Status_Value := SSH_Lib.Sessions.Open (Options, Session_Item);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Timeout,
         "phase15 immediate connect deadline maps to timeout after validation/preflight");
      Check_Status
        (SSH_Lib.Sessions.Test_Support.Last_Failure_For_Test (Session_Item),
         CryptoLib.Errors.Timeout,
         "phase15 failed open records immediate timeout cause");
      Check
        (not SSH_Lib.Sessions.Test_Support.Is_Dirty_For_Test (Session_Item),
         "phase15 failed public open leaves session closed and clean for cleanup");

      Options.Connect_Timeout_MS := 30_000;
      Options.Write_Timeout_MS := 0;
      Status_Value := SSH_Lib.Sessions.Open (Options, Session_Item);
      Touch (Session_Item);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Timeout,
         "phase15 immediate write deadline maps to timeout at first open write boundary");

      Options.Write_Timeout_MS := 30_000;
      Options.Read_Timeout_MS := 0;
      Status_Value := SSH_Lib.Sessions.Open (Options, Session_Item);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Timeout,
         "phase15 immediate read deadline maps to timeout at first open read boundary");

      Check
        (not SSH_Lib.Cancellation.Is_Cancelled (Cancel_Item),
         "phase15 cancellation initially clear");
      SSH_Lib.Cancellation.Request_Cancel (Cancel_Item);
      Check
        (SSH_Lib.Cancellation.Is_Cancelled (Cancel_Item),
         "phase15 cancellation request observed");
      SSH_Lib.Cancellation.Reset (Cancel_Item);
      Check
        (not SSH_Lib.Cancellation.Is_Cancelled (Cancel_Item),
         "phase15 cancellation reset clears state");

      SSH_Lib.Operation_Control.Begin_Operation (Operation_Item, 0);
      Check_Status
        (SSH_Lib.Operation_Control.Check (Operation_Item),
         CryptoLib.Errors.Timeout,
         "phase15 operation control maps expired deadline to timeout");
      SSH_Lib.Operation_Control.Begin_Operation (Operation_Item, 30_000);
      Check_Status
        (SSH_Lib.Operation_Control.Check (Operation_Item),
         CryptoLib.Errors.Ok,
         "phase15 operation control accepts live deadline");
      SSH_Lib.Operation_Control.Request_Cancel (Operation_Item);
      Check_Status
        (SSH_Lib.Operation_Control.Check (Operation_Item),
         CryptoLib.Errors.Cancelled,
         "phase15 cancellation is distinct from timeout");
      SSH_Lib.Operation_Control.Begin_Nested_Operation
        (Child_Operation, 30_000, SSH_Lib.Deadlines.From_Now (0));
      Check_Status
        (SSH_Lib.Operation_Control.Check (Child_Operation),
         CryptoLib.Errors.Timeout,
         "phase15 nested operation keeps caller expired deadline");
      SSH_Lib.Operation_Control.Begin_Nested_Operation
        (Child_Operation, 30_000, Long_Deadline);
      Check
        (SSH_Lib.Deadlines.Remaining_MS
           (SSH_Lib.Operation_Control.Deadline (Child_Operation))
         <= SSH_Lib.Deadlines.Remaining_MS (Long_Deadline),
         "phase15 nested operation does not extend caller deadline");

      SSH_Lib.Operation_Control.Begin_Operation (Operation_Item, 30_000);
      SSH_Lib.Operation_Control.Request_Cancel (Operation_Item);
      SSH_Lib.Operation_Control.Begin_Nested_Operation
        (Child_Operation, 30_000, Operation_Item);
      Check_Status
        (SSH_Lib.Operation_Control.Check (Child_Operation),
         CryptoLib.Errors.Cancelled,
         "phase15 nested operation inherits parent cancellation state");

      SSH_Lib.Transport.Mark_Open (Transport_Item);
      Status_Value :=
        SSH_Lib.Transport.Wait.Check_Readiness
          (Transport_Item, SSH_Lib.Deadlines.From_Now (0));
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Timeout,
         "phase15 transport wait maps expired deadline to timeout");

      Status_Value := SSH_Lib.Transport.Close (Transport_Item);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Ok,
         "phase15 packet cancellation helper close reset");
      SSH_Lib.Transport.Mark_Open (Transport_Item);
      SSH_Lib.Operation_Control.Begin_Operation (Operation_Item, 30_000);
      SSH_Lib.Operation_Control.Request_Cancel (Operation_Item);
      Status_Value :=
        SSH_Lib.Protocol.Packet_IO.Complete_Bounded_Read
          (Transport_Item,
           Operation_Item,
           Expected_Bytes => 4,
           Bytes_Read     => 0,
           Failure        => CryptoLib.Errors.Ok,
           Stage          => SSH_Lib.Protocol.Packet_IO.Packet_Length_Field);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Cancelled,
         "phase15 packet read observes cancellation before timeout");
      Check
        (not SSH_Lib.Transport.Is_Dirty (Transport_Item),
         "phase15 cancelled packet read before bytes leaves transport clean");

      Status_Value := SSH_Lib.Transport.Close (Transport_Item);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Ok,
         "phase15 packet partial cancellation helper close reset");
      SSH_Lib.Transport.Mark_Open (Transport_Item);
