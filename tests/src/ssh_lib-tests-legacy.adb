        (SSH_Lib.Config.Load (Empty_Config_Path, Empty_Config),
         CryptoLib.Errors.Ok,
         "phase18 version integration empty config load");
      Check_Status
        (SSH_Lib.Config.Load (Unsupported_Config_Path, Unsupported_Config),
         CryptoLib.Errors.Ok,
         "phase18 version integration proxycommand config load");
      Check_Status
        (SSH_Lib.Config.Load (Port_Config_Path, Port_Config),
         CryptoLib.Errors.Ok,
         "phase18 version integration port config load");

      Check
        (not SSH_Lib.Remote_Names.Has_Explicit_Port ("ssh://gh/repo.git"),
         "phase18 implicit ssh port is not explicit");
