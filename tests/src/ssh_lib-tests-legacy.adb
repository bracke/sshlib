         = "127.0.0.1:8022 target.example:22",
         "phase19 config LocalForward is preserved as session data");
      Check
        (To_String (Options_Item.Remote_Forwards)
         = "0.0.0.0:0 target.example:22",
         "phase19 config RemoteForward is preserved as session data");
