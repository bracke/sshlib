            "git tree hex lookup values");
         Status_Value :=
           SSH_Lib.Git.List_Tree_Entries_Hex
             (Tree_Data,
              Listed_Tree_Names,
              Listed_Tree_Name_Lasts,
              Listed_Tree_Modes,
              Listed_Tree_IDs,
