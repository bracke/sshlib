      Ada.Text_IO.Create (Output_File, Ada.Text_IO.Out_File, Changed_Path);
      Ada.Text_IO.Put_Line
        (Output_File,
         "|1|fixture-salt|fixture-hash ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIFixtureHash phase16-public-test-fixture");
      Ada.Text_IO.Close (Output_File);
      Verification :=
        SSH_Lib.Known_Hosts.Verify
          (Changed_Path,
           "fixture-host",
           22,
           SSH_Lib.Tests.Fixtures.Known_Hosts.Fixture_Host_Key);
      Check
        (Verification = SSH_Lib.Known_Hosts.Unknown,
         "phase16 malformed hashed known_hosts fixture remains unknown");

      Ada.Text_IO.Create (Output_File, Ada.Text_IO.Out_File, Changed_Path);
      Ada.Text_IO.Put_Line
        (Output_File,
         "!fixture-host ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIFixtureNegative phase16-public-test-fixture");
      Ada.Text_IO.Close (Output_File);
      Verification :=
        SSH_Lib.Known_Hosts.Verify
          (Changed_Path,
           "fixture-host",
           22,
           SSH_Lib.Tests.Fixtures.Known_Hosts.Fixture_Host_Key);
      Check
        (Verification = SSH_Lib.Known_Hosts.Unknown,
         "phase19 pass265 negated known_hosts entry is line-local and not a mismatch");

      for Scenario_Item in SSH_Lib.Tests.Fixtures.Protocol_Scripts.Scenario
      loop
         Check
           (SSH_Lib.Tests.Fixtures.Protocol_Scripts.Name (Scenario_Item)'Length
            > 0,
            "phase16 every protocol script has a stable scenario name");
         Check
           (SSH_Lib.Tests.Fixtures.Protocol_Scripts.Expected_Status
              (Scenario_Item)
            /= CryptoLib.Errors.Internal_Error,
            "phase16 every protocol script has deterministic non-internal expected status");
      end loop;

      SSH_Lib.Tests.Fixtures.Transport.Start
        (Transport_Item,
         SSH_Lib.Tests.Fixtures.Transport.Identification,
         SSH_Lib.Tests.Fixtures.Transport.Timeout);
      SSH_Lib.Tests.Assertions.Check_Status
        (SSH_Lib.Tests.Fixtures.Transport.Step
           (Transport_Item, SSH_Lib.Tests.Fixtures.Transport.Identification),
         CryptoLib.Errors.Timeout,
         "phase16 transport fixture identification timeout",
         "identification-timeout");
      Check
        (not SSH_Lib.Tests.Fixtures.Transport.Dirty_After_Step
               (Transport_Item,
                SSH_Lib.Tests.Fixtures.Transport.Identification),
         "phase16 clean timeout before payload does not imply dirty state");

      SSH_Lib.Tests.Fixtures.Transport.Start
        (Transport_Item,
         SSH_Lib.Tests.Fixtures.Transport.Kex_Reply,
         SSH_Lib.Tests.Fixtures.Transport.Mac_Failure);
      SSH_Lib.Tests.Assertions.Check_Status
        (SSH_Lib.Tests.Fixtures.Transport.Step
           (Transport_Item, SSH_Lib.Tests.Fixtures.Transport.Kex_Reply),
         CryptoLib.Errors.Handshake_Failed,
         "phase16 transport fixture mac failure",
         "mac-failure");
      Check
        (SSH_Lib.Tests.Fixtures.Transport.Dirty_After_Step
           (Transport_Item, SSH_Lib.Tests.Fixtures.Transport.Kex_Reply),
         "phase16 mac failure marks deterministic dirty state");

      SSH_Lib.Tests.Fixtures.Transport.Start
        (Transport_Item,
         SSH_Lib.Tests.Fixtures.Transport.Host_Key_Verification,
         SSH_Lib.Tests.Fixtures.Transport.Host_Key_Unknown);
      SSH_Lib.Tests.Assertions.Check_Status
        (SSH_Lib.Tests.Fixtures.Transport.Step
           (Transport_Item,
            SSH_Lib.Tests.Fixtures.Transport.Host_Key_Verification),
         CryptoLib.Errors.Host_Key_Unknown,
         "phase16 transport fixture unknown host key",
         "host-key-unknown");
      Check
        (not SSH_Lib.Tests.Fixtures.Transport.Dirty_After_Step
               (Transport_Item,
                SSH_Lib.Tests.Fixtures.Transport.Host_Key_Verification),
         "phase16 unknown host key is a clean verification refusal");

      SSH_Lib.Tests.Fixtures.Transport.Start
        (Transport_Item,
         SSH_Lib.Tests.Fixtures.Transport.Host_Key_Verification,
         SSH_Lib.Tests.Fixtures.Transport.Host_Key_Mismatch);
      SSH_Lib.Tests.Assertions.Check_Status
        (SSH_Lib.Tests.Fixtures.Transport.Step
           (Transport_Item,
            SSH_Lib.Tests.Fixtures.Transport.Host_Key_Verification),
         CryptoLib.Errors.Host_Key_Mismatch,
         "phase16 transport fixture changed host key",
         "host-key-mismatch");
      Check
        (not SSH_Lib.Tests.Fixtures.Transport.Dirty_After_Step
               (Transport_Item,
                SSH_Lib.Tests.Fixtures.Transport.Host_Key_Verification),
         "phase16 changed host key is a clean verification refusal");

      SSH_Lib.Tests.Fixtures.Transport.Start
        (Transport_Item,
         SSH_Lib.Tests.Fixtures.Transport.Host_Key_Verification,
         SSH_Lib.Tests.Fixtures.Transport.Bad_Signature);
      SSH_Lib.Tests.Assertions.Check_Status
        (SSH_Lib.Tests.Fixtures.Transport.Step
           (Transport_Item,
            SSH_Lib.Tests.Fixtures.Transport.Host_Key_Verification),
         CryptoLib.Errors.Handshake_Failed,
         "phase16 transport fixture bad host-key signature",
         "bad-kex-signature");
      Check
        (SSH_Lib.Tests.Fixtures.Transport.Dirty_After_Step
           (Transport_Item,
            SSH_Lib.Tests.Fixtures.Transport.Host_Key_Verification),
         "phase16 bad host-key signature dirties handshake state");

      SSH_Lib.Tests.Fixtures.Transport.Start
        (Transport_Item,
         SSH_Lib.Tests.Fixtures.Transport.Host_Key_Verification,
         SSH_Lib.Tests.Fixtures.Transport.Unsupported_Algorithm);
      SSH_Lib.Tests.Assertions.Check_Status
        (SSH_Lib.Tests.Fixtures.Transport.Step
           (Transport_Item,
            SSH_Lib.Tests.Fixtures.Transport.Host_Key_Verification),
         CryptoLib.Errors.Unsupported_Feature,
         "phase16 transport fixture unsupported host-key algorithm",
         "unsupported-host-key");

      SSH_Lib.Tests.Fixtures.Transport.Start
        (Transport_Item,
         SSH_Lib.Tests.Fixtures.Transport.Host_Key_Verification,
         SSH_Lib.Tests.Fixtures.Transport.Verify_Bypass);
      SSH_Lib.Tests.Assertions.Check_Status
        (SSH_Lib.Tests.Fixtures.Transport.Step
           (Transport_Item,
            SSH_Lib.Tests.Fixtures.Transport.Host_Key_Verification),
         CryptoLib.Errors.Ok,
         "phase16 transport fixture explicit host-key verification bypass",
         "verify-known-host-false");

      SSH_Lib.Tests.Fixtures.Transport.Start
        (Transport_Item,
         SSH_Lib.Tests.Fixtures.Transport.Userauth,
         SSH_Lib.Tests.Fixtures.Transport.Auth_Rejected);
      SSH_Lib.Tests.Assertions.Check_Status
        (SSH_Lib.Tests.Fixtures.Transport.Step
           (Transport_Item, SSH_Lib.Tests.Fixtures.Transport.Userauth),
         CryptoLib.Errors.Authentication_Failed,
         "phase16 transport fixture auth rejection",
         "auth-rejected");

      SSH_Lib.Tests.Fixtures.Transport.Start
        (Transport_Item,
         SSH_Lib.Tests.Fixtures.Transport.Userauth,
         SSH_Lib.Tests.Fixtures.Transport.Auth_Partial_Success);
      SSH_Lib.Tests.Assertions.Check_Status
        (SSH_Lib.Tests.Fixtures.Transport.Step
           (Transport_Item, SSH_Lib.Tests.Fixtures.Transport.Userauth),
         CryptoLib.Errors.Authentication_Failed,
         "phase16 transport fixture partial auth is not ok",
         "auth-partial-success");

      SSH_Lib.Tests.Fixtures.Transport.Start
        (Transport_Item,
         SSH_Lib.Tests.Fixtures.Transport.Userauth,
         SSH_Lib.Tests.Fixtures.Transport.Userauth_Banner);
      SSH_Lib.Tests.Assertions.Check_Status
        (SSH_Lib.Tests.Fixtures.Transport.Step
           (Transport_Item, SSH_Lib.Tests.Fixtures.Transport.Userauth),
         CryptoLib.Errors.Ok,
         "phase16 transport fixture userauth banner ignored safely",
         "userauth-banner");

      SSH_Lib.Tests.Fixtures.Transport.Start
        (Transport_Item,
         SSH_Lib.Tests.Fixtures.Transport.Kexinit,
         SSH_Lib.Tests.Fixtures.Transport.Timeout);
      SSH_Lib.Tests.Assertions.Check_Status
        (SSH_Lib.Tests.Fixtures.Transport.Step
           (Transport_Item, SSH_Lib.Tests.Fixtures.Transport.Kexinit),
         CryptoLib.Errors.Timeout,
         "phase16 transport fixture kexinit timeout",
         "kexinit-timeout");

      SSH_Lib.Tests.Fixtures.Transport.Start
        (Transport_Item,
         SSH_Lib.Tests.Fixtures.Transport.Channel_Open,
         SSH_Lib.Tests.Fixtures.Transport.Timeout);
      SSH_Lib.Tests.Assertions.Check_Status
        (SSH_Lib.Tests.Fixtures.Transport.Step
           (Transport_Item, SSH_Lib.Tests.Fixtures.Transport.Channel_Open),
         CryptoLib.Errors.Timeout,
         "phase16 transport fixture channel-open timeout",
         "channel-open-timeout");

      SSH_Lib.Tests.Fixtures.Transport.Start
        (Transport_Item,
         SSH_Lib.Tests.Fixtures.Transport.Read_Stream,
         SSH_Lib.Tests.Fixtures.Transport.Timeout);
      SSH_Lib.Tests.Assertions.Check_Status
        (SSH_Lib.Tests.Fixtures.Transport.Step
           (Transport_Item, SSH_Lib.Tests.Fixtures.Transport.Read_Stream),
         CryptoLib.Errors.Timeout,
         "phase16 transport fixture read-stream timeout",
         "read-timeout");

      SSH_Lib.Tests.Fixtures.Transport.Start
        (Transport_Item,
         SSH_Lib.Tests.Fixtures.Transport.Write_Stream,
         SSH_Lib.Tests.Fixtures.Transport.Timeout);
      SSH_Lib.Tests.Assertions.Check_Status
        (SSH_Lib.Tests.Fixtures.Transport.Step
           (Transport_Item, SSH_Lib.Tests.Fixtures.Transport.Write_Stream),
         CryptoLib.Errors.Timeout,
         "phase16 transport fixture write-stream timeout",
         "write-timeout");

      for Stage_Item in SSH_Lib.Tests.Fixtures.Transport.Stage loop
         Check
           (SSH_Lib.Tests.Fixtures.Transport.Stage_Name (Stage_Item)'Length
            > 0,
            "phase16 every transport fixture stage has a stable name");
      end loop;

      for Behavior_Item in SSH_Lib.Tests.Fixtures.Transport.Behavior loop
         Check
           (SSH_Lib.Tests.Fixtures.Transport.Behavior_Name
              (Behavior_Item)'Length
            > 0,
            "phase16 every transport fixture behavior has a stable name");
      end loop;

      --  Agent fixture never reads the process SSH_AUTH_SOCK.
      SSH_Lib.Tests.Fixtures.Agent.Start
        (Agent_Item, SSH_Lib.Tests.Fixtures.Agent.Identities_Available);
      SSH_Lib.Tests.Assertions.Check_Status
        (SSH_Lib.Tests.Fixtures.Agent.Request_Identities (Agent_Item),
         CryptoLib.Errors.Ok,
         "phase16 fixture agent identities",
         "agent-success");
      SSH_Lib.Tests.Fixtures.Agent.Start
        (Agent_Item, SSH_Lib.Tests.Fixtures.Agent.Failure_Response);
      SSH_Lib.Tests.Assertions.Check_Status
        (SSH_Lib.Tests.Fixtures.Agent.Sign_Request
           (Agent_Item, SSH_Lib.Tests.Fixtures.Binary_Data.Git_Request),
         CryptoLib.Errors.Authentication_Failed,
         "phase16 fixture agent failure",
         "agent-failure");
      SSH_Lib.Tests.Fixtures.Agent.Start
        (Agent_Item, SSH_Lib.Tests.Fixtures.Agent.Delayed_Response);
      SSH_Lib.Tests.Assertions.Check_Status
        (SSH_Lib.Tests.Fixtures.Agent.Request_Identities (Agent_Item),
         CryptoLib.Errors.Timeout,
         "phase16 fixture agent timeout",
         "agent-timeout");
      SSH_Lib.Tests.Fixtures.Agent.Start
        (Agent_Item, SSH_Lib.Tests.Fixtures.Agent.Malformed_Response);
      SSH_Lib.Tests.Assertions.Check_Status
        (SSH_Lib.Tests.Fixtures.Agent.Request_Identities (Agent_Item),
         CryptoLib.Errors.Authentication_Failed,
         "phase16 fixture malformed agent response",
         "agent-malformed");
      SSH_Lib.Tests.Fixtures.Agent.Start
        (Agent_Item, SSH_Lib.Tests.Fixtures.Agent.Oversized_Response);
      SSH_Lib.Tests.Assertions.Check_Status
        (SSH_Lib.Tests.Fixtures.Agent.Sign_Request
           (Agent_Item, SSH_Lib.Tests.Fixtures.Binary_Data.Git_Request),
         CryptoLib.Errors.Authentication_Failed,
         "phase16 fixture oversized agent response",
         "agent-oversized");

      Status_Value :=
        SSH_Lib.Identity_Files.Parse
          (SSH_Lib.Tests.Fixtures.Identity_Files.Malformed_OpenSSH_Private_Key,
           Identity_Item);
      SSH_Lib.Tests.Assertions.Check_Status
        (Status_Value,
         CryptoLib.Errors.Authentication_Failed,
         "phase16 fixture malformed identity file body",
         "identity-malformed");
      Check
        (SSH_Lib.Identity_Files.Kind (Identity_Item)
         = SSH_Lib.Identity_Files.No_Key,
         "phase16 malformed identity leaves no exposed key material");
      Status_Value :=
        SSH_Lib.Identity_Files.Parse
          (SSH_Lib.Tests.Fixtures.Identity_Files.Encrypted_OpenSSH_Private_Key,
           Identity_Item);
      SSH_Lib.Tests.Assertions.Check_Status
        (Status_Value,
         CryptoLib.Errors.Authentication_Failed,
         "phase16 fixture encrypted identity without passphrase fails closed",
         "identity-encrypted");
      Status_Value :=
        SSH_Lib.Identity_Files.Parse
          (SSH_Lib.Tests.Fixtures.Identity_Files.Unsupported_RSA_Private_Key,
           Identity_Item);
      SSH_Lib.Tests.Assertions.Check_Status
        (Status_Value,
         CryptoLib.Errors.Authentication_Failed,
         "phase16 fixture unsupported legacy rsa identity",
         "identity-unsupported");
      Status_Value :=
        SSH_Lib.Identity_Files.Parse
          (SSH_Lib.Tests.Fixtures.Identity_Files.Legacy_PEM_Private_Key,
           Identity_Item);
      SSH_Lib.Tests.Assertions.Check_Status
        (Status_Value,
         CryptoLib.Errors.Authentication_Failed,
         "phase16 fixture unsupported legacy pem identity",
         "identity-legacy-pem");

      --  Config/remote composition stays isolated from the real SSH config.
      Ada.Text_IO.Create (Output_File, Ada.Text_IO.Out_File, Config_Path);
      Ada.Text_IO.Put_Line (Output_File, "Host fixture-alias");
      Ada.Text_IO.Put_Line (Output_File, "HostName fixture-host");
      Ada.Text_IO.Put_Line (Output_File, "User git");
      Ada.Text_IO.Put_Line (Output_File, "Port 2222");
      Ada.Text_IO.Put_Line
        (Output_File, "IdentityFile /tmp/ssh_lib_phase16_id_ed25519");
      Ada.Text_IO.Put_Line (Output_File, "IdentitiesOnly yes");
      Ada.Text_IO.Close (Output_File);

      SSH_Lib.Tests.Assertions.Check_Status
        (SSH_Lib.Config.Load (Config_Path, Config_Item),
         CryptoLib.Errors.Ok,
         "phase16 fixture config load",
         "config-remote");
      SSH_Lib.Tests.Assertions.Check_Status
        (SSH_Lib.Remote_Names.Parse ("git@fixture-alias:repo.git", Parsed),
         CryptoLib.Errors.Ok,
         "phase16 fixture remote parse",
         "config-remote");
      SSH_Lib.Tests.Assertions.Check_Status
        (SSH_Lib.Config.Resolve_Remote (Config_Item, Parsed, Options),
         CryptoLib.Errors.Ok,
         "phase16 fixture config resolve remote",
         "config-remote");
      Check
        (To_String (Options.Host) = "fixture-host",
         "phase16 fixture config hostname applied");
      Check
        (To_String (Options.User) = "git",
         "phase16 fixture remote explicit user preserved");
      Check
        (Options.Port = 2222,
         "phase16 fixture config port applied to scp-like remote");
      Check
        (not Options.Use_Agent,
         "phase16 fixture identitiesonly yes disables agent without touching real agent");
      Check
        (Options.Verify_Known_Host and then Options.Strict_Host_Key,
         "phase16 fixture config preserves secure host-key defaults");

      SSH_Lib.Tests.Assertions.Check_Status
        (SSH_Lib.Remote_Names.Parse
           ("ssh://other@fixture-alias:2200/repo.git", Parsed),
         CryptoLib.Errors.Ok,
         "phase16 fixture remote parse explicit overrides",
         "config-remote-override");
      SSH_Lib.Tests.Assertions.Check_Status
        (SSH_Lib.Config.Resolve_Remote (Config_Item, Parsed, Options),
         CryptoLib.Errors.Ok,
         "phase16 fixture config resolve explicit remote overrides",
         "config-remote-override");
      Check
        (To_String (Options.User) = "other",
         "phase16 fixture remote explicit user overrides config user");
      Check
        (Options.Port = 2200,
         "phase16 fixture remote explicit port overrides config port");
      Check
        (To_String (Options.Host) = "fixture-host",
         "phase16 fixture explicit overrides still use host alias target");

      --  Happy-path protocol script covers authenticated exec, command capture,
      --  binary write, stdout/stderr separation, EOF, exit status, and cleanup.
      SSH_Lib.Tests.Fixtures.Server.Start
        (Fixture_Item, SSH_Lib.Tests.Fixtures.Protocol_Scripts.Happy_Path);
      SSH_Lib.Tests.Fixtures.Server.Prepare_Authenticated_Session
        (Fixture_Item, Session_Item);
      Status_Value :=
