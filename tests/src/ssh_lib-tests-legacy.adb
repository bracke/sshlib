             (Channel_Item);
      begin
         Check
           (Close_Reply'Length = 5
            and then
              Close_Reply (Close_Reply'First)
              = SSH_Lib.Protocol.Channels.SSH_MSG_CHANNEL_CLOSE,
            "phase12 inbound close triggers reply close");
      end;
      Status_Value := SSH_Lib.Channels.Write (Channel_Item, Binary_Data);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Write_Failed,
         "phase12 write after inbound close rejected");

      SSH_Lib.Channels.Test_Support.Mark_Exec_Active_For_Test
        (Channel_Item,
         Local_Channel_Id           => 7,
         Remote_Channel_Id          => 9,
         Remote_Remaining_Window    => 16,
         Remote_Maximum_Packet_Size => 8);
      Status_Value := SSH_Lib.Channels.Close (Channel_Item);
      Check_Status
        (Status_Value, CryptoLib.Errors.Ok, "phase12 close active channel ok");
      declare
         Close_Payload : constant Ada.Streams.Stream_Element_Array :=
           SSH_Lib.Channels.Test_Support.Last_Close_Payload_For_Test
             (Channel_Item);
      begin
         Check
           (Close_Payload'Length = 0,
            "phase12 close cleanup clears retained close payload after local cleanup");
      end;
      Status_Value := SSH_Lib.Channels.Write (Channel_Item, Binary_Data);
      Check_Status
        (Status_Value,
         CryptoLib.Errors.Write_Failed,
         "phase12 write after close rejected");

   end Run_Phase_12_Channel_Stream_Tests;

   procedure Run_Phase_16_Local_Fixture_Tests is
      Fixture_Item   : SSH_Lib.Tests.Fixtures.Server.Fixture;
      Agent_Item     : SSH_Lib.Tests.Fixtures.Agent.Fixture;
      Session_Item   : SSH_Lib.Sessions.Session;
      Channel_Item   : SSH_Lib.Channels.Channel;
      Status_Value   : CryptoLib.Errors.Status;
      Read_Buffer    : Ada.Streams.Stream_Element_Array (1 .. 4);
      Last_Index     : Ada.Streams.Stream_Element_Offset;
      Exit_Code      : Integer := -1;
      Known_Path     : constant String :=
        SSH_Lib.Tests.Fixtures.Temp_Paths.Path ("known_hosts");
      Changed_Path   : constant String :=
        SSH_Lib.Tests.Fixtures.Temp_Paths.Path ("changed_known_hosts");
      Config_Path    : constant String :=
