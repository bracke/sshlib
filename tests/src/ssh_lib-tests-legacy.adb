               and then Path_List_Tree_Last =
                 Path_List_Tree_Data'First + Tree_Data'Length - 1
               and then Bytes_Equal
                 (Path_List_Tree_Data
                    (Path_List_Tree_Data'First .. Path_List_Tree_Last),
