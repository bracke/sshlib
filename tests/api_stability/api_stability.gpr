with "../../SSH_Lib.gpr";

project API_Stability is
   for Source_Dirs use ("src");
   for Main use ("api_stability_main.adb");
   for Object_Dir use "../../../ssh_lib_build/obj/api_stability";
   for Exec_Dir use "../../../ssh_lib_build/bin/api_stability";

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnatwa", "-gnatwe");
   end Compiler;
end API_Stability;
