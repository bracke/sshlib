with "config/ssh_lib_api_stability_config.gpr";

project API_Stability is
   for Source_Dirs use ("src", "config");
   for Main use ("api_stability_main.adb");
   --  Exec_Dir is hard-coded in tools/check_release_artifacts.adb; do not move it.
   for Object_Dir use "../../../ssh_lib_build/obj/api_stability/" & SSH_Lib_API_Stability_Config.Build_Profile;
   for Exec_Dir use "../../../ssh_lib_build/bin/api_stability";
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        SSH_Lib_API_Stability_Config.Ada_Compiler_Switches & ("-gnat2022", "-gnatyM120", "-gnatwa", "-gnatwe");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;
end API_Stability;
