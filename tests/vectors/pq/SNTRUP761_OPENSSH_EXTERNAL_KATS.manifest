# SSH_Lib external PQ KAT manifest
# Source class: OpenSSH-compatible sntrup761x25519-sha512 hybrid KEX corpus.
# Production conformance requires importing vectors generated by an OpenSSH-compatible
# SNTRUP761 implementation and live ssh/sshd transcript captures.
algorithm=SNTRUP761
source_family=OpenSSH-sntrup761x25519-sha512
source_reference=https://www.openssh.com/releasenotes.html
expected_public_key_length=1158
expected_secret_key_length=1763
expected_ciphertext_length=1039
expected_shared_secret_length=32
required_algorithms=sntrup761x25519-sha512@openssh.com,sntrup761x25519-sha512
required_checks=keygen,encapsulate,decapsulate,invalid-ciphertext-fallback,ssh-hybrid-transcript
status=external-kat-corpus-bundled
required_vector_files=SNTRUP761_OPENSSH_KAT_001.txt,SNTRUP761_OPENSSH_KAT_002.txt,SNTRUP761_OPENSSH_KAT_003.txt,SNTRUP761_OPENSSH_KAT_004.txt
required_vector_checks=multiple-seeded-keygen,multiple-seeded-encapsulate,decapsulate,invalid-ciphertext-fallback,sha3-256-artifact-digests,corpus-role-coverage
