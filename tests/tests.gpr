with "aunit.gpr";
with "ssh_lib_internal.gpr";

project Tests is

   for Source_Dirs use ("src/", "src/fixtures", "config/");
   for Object_Dir use "obj/tests";
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use
     ("main.adb",
      "test_ecdsa_nistp256.adb",
      "test_crypto_primitives.adb",
      "test_sftp_fake_subsystem.adb",
      "test_file_transfer_workflows.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatX", "-gnatyM120", "-gnata", "-gnatVa", "-gnatW8");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   --  sshlib and cryptolib are pure Ada; the suite imports no OpenSSL. "-lssl -lcrypto" were
   --  dead switches -- they linked on Linux only because the libraries happened to be there,
   --  and Windows, which has neither, could not link the tests at all.

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Tests;
