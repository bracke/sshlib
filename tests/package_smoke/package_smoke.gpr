with "../../SSH_Lib.gpr";

project Package_Smoke is
   for Source_Dirs use ("src");
   for Main use ("package_smoke_main.adb");
   for Object_Dir use "../../../ssh_lib_build/obj/package_smoke";
   for Exec_Dir use "../../../ssh_lib_build/bin/package_smoke";

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnatwa", "-gnatwe");
   end Compiler;
end Package_Smoke;
