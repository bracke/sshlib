with "../config/ssh_lib_config.gpr";
with "zlib.gpr";

project SSH_Lib_Internal is
   for Source_Dirs use ("../src");
   for Object_Dir use "obj/internal";
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatX", "-gnatyM120", "-gnata", "-gnatVa", "-gnatW8");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;
end SSH_Lib_Internal;
