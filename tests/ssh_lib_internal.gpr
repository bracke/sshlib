with "../config/ssh_lib_config.gpr";
with "zlib.gpr";

project SSH_Lib_Internal is
   --  Mirror SSH_Lib.gpr's OS split: the platform bodies (fd passing, xattr) live in
   --  a per-OS directory, so the white-box tests must pull the same one in or the
   --  platform specs would have no body.
   case SSH_Lib_Config.Alire_Host_OS is
      when "windows" =>
         for Source_Dirs use ("../src", "../src/platform/windows");
      when others =>
         for Source_Dirs use ("../src", "../src/platform/posix");
   end case;
   for Object_Dir use "obj/internal";
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatX", "-gnatyM120", "-gnata", "-gnatVa", "-gnatW8");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;
end SSH_Lib_Internal;
