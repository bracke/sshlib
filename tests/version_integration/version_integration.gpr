with "../ssh_lib_internal.gpr";

project Version_Integration is
   for Source_Dirs use ("src", "../src", "../src/fixtures");
   for Main use ("version_ssh_shape.adb", "test_version_fixture.adb", "test_version_adapter_consumption.adb");
   for Object_Dir use "../../../ssh_lib_build/obj/version_integration";
   for Exec_Dir use "../../../ssh_lib_build/bin/version_integration";

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnatwa", "-gnatwe");
   end Compiler;
end Version_Integration;
