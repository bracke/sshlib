with "config/ssh_lib_config.gpr";

library project SSH_Lib is
   --  The OS-specific bodies (SCM_RIGHTS fd passing, extended attributes) live under
   --  src/platform: the POSIX set imports listxattr/sendmsg/etc., which do not exist
   --  on Windows, so Windows compiles its own stub bodies in their place.
   case SSH_Lib_Config.Alire_Host_OS is
      when "windows" =>
         for Source_Dirs use ("src", "config", "src/platform/windows");
      when others =>
         for Source_Dirs use ("src", "config", "src/platform/posix");
   end case;
   for Object_Dir use "../ssh_lib_build/obj/lib/" & SSH_Lib_Config.Build_Profile;
   for Library_Dir use "../ssh_lib_build/lib";
   for Create_Missing_Dirs use "True";
   for Library_Name use "ssh_lib";
   for Library_Kind use "static";
   for Library_Interface use
     ("SSH_Lib",
      "SSH_Lib.Clients",
      "SSH_Lib.Sessions",
      "SSH_Lib.Channels",
      "SSH_Lib.Known_Hosts",
      "SSH_Lib.Keys",
      "SSH_Lib.Config",
      "SSH_Lib.Config_Apply",
      "SSH_Lib.Mux",
      "SSH_Lib.Platform",
      "SSH_Lib.Platform.FD_Passing",
      "SSH_Lib.Git",
      "SSH_Lib.SCP",
      "SSH_Lib.File_Transfer",
      "SSH_Lib.SFTP",
      "SSH_Lib.Forwarding",
      "SSH_Lib.Security_Keys",
      "SSH_Lib.Remote_Names",
      "SSH_Lib.Git_Transport",
      "SSH_Lib.Protocol",
      "SSH_Lib.Protocol.Buffers",
      "SSH_Lib.Protocol.Protected_Packets",
      "SSH_Lib.Protocol.Packets",
      "SSH_Lib.Sessions.Live_Attachment",
      "SSH_Lib.Sessions.Live_Transcript");

   package Compiler is
      for Default_Switches ("Ada") use SSH_Lib_Config.Ada_Compiler_Switches & ("-gnat2022", "-gnatyM120", "-gnatX", "-gnata", "-gnatVa", "-gnatW8");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end SSH_Lib;
