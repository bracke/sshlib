with "config/ssh_lib_examples_config.gpr";

project Manual_Examples is
   for Source_Dirs use (".", "config");
   for Main use ("manual_git_upload_pack_probe.adb");
   for Object_Dir use "../../ssh_lib_build/obj/manual_examples/" & SSH_Lib_Examples_Config.Build_Profile;
   for Exec_Dir use "../../ssh_lib_build/bin/manual_examples";
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        SSH_Lib_Examples_Config.Ada_Compiler_Switches & ("-gnat2022", "-gnatyM120", "-gnatwa", "-gnatwe");
   end Compiler;


   --  Bytes out as bytes in. Alire's generated switches carry -gnatW8 and the
   --  binder takes its run-time encoding from the same place, which makes
   --  Ada.Text_IO encode every byte above 127 a second time on the way out:
   --  text that was already UTF-8 -- an accented path, an internationalized
   --  domain name, a translated message -- came out doubled. -Wb is the
   --  compiler default and leaves the bytes alone.
   package Binder is
      for Switches ("Ada") use ("-Es", "-Wb");
   end Binder;
end Manual_Examples;
