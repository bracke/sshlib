with "config/ssh_lib_tools_config.gpr";

project Tools is
   for Source_Dirs use (".", "config");
   for Main use
     ("check_public_api.adb",
      "check_package_tree.adb",
      "check_release.adb",
      "check_phase17_regressions.adb",
      "check_release_manifest.adb",
      "check_release_package.adb",
      "check_release_toolchain.adb",
      "check_release_artifacts.adb",
      "check_release_sequence.adb",
      "check_release_runner.adb",
      "check_security.adb",
      "check_no_subprocess.adb",
      "check_binary_paths.adb",
      "check_sensitive_logging.adb",
      "check_side_channel_assurance.adb",
      "check_formal_side_channel_proof.adb",
      "check_pq_hybrid_state.adb",
      "check_hybrid_pq_readiness.adb",
      "check_compile_preflight.adb",
      "check_phase19_context.adb",
      "check_runtime_boundaries.adb",
      "check_live_git_matrix_report.adb",
      "check_live_proxycommand_report.adb",
      "run_release_validation.adb",
      "run_sftp_fuzzer_seed_corpus.adb",
      "run_sftp_v4_v6_interop.adb",
      "check_sftp_v4_v6_interop_report.adb",
      "local_sshd_fixture.adb");
   --  Exec_Dir is hard-coded in several of these tools' own sources; do not move it.
   for Object_Dir use "../../ssh_lib_build/obj/tools/" & SSH_Lib_Tools_Config.Build_Profile;
   for Exec_Dir use "../../ssh_lib_build/bin/tools";
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        SSH_Lib_Tools_Config.Ada_Compiler_Switches & ("-gnat2022", "-gnatyM120", "-gnatwa", "-gnatwe");
   end Compiler;


   --  Bytes out as bytes in. Alire's generated switches carry -gnatW8 and the
   --  binder takes its run-time encoding from the same place, which makes
   --  Ada.Text_IO encode every byte above 127 a second time on the way out:
   --  text that was already UTF-8 -- an accented path, an internationalized
   --  domain name, a translated message -- came out doubled. -Wb is the
   --  compiler default and leaves the bytes alone.
   package Binder is
      for Switches ("Ada") use ("-Es", "-Wb");
   end Binder;
end Tools;
